#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
export AGENTCTL_XCODE_AGENT="${AGENTCTL_XCODE_AGENT:-codex}"
export PATH="/opt/homebrew/bin:/usr/local/bin:/Applications/Xcode/Xcode-beta.app/Contents/Developer/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

if [ -z "${CONTAINER_CMD:-}" ]; then
  if [ -x /usr/local/bin/container ]; then
    export CONTAINER_CMD=/usr/local/bin/container
  elif [ -x /opt/homebrew/bin/container ]; then
    export CONTAINER_CMD=/opt/homebrew/bin/container
  else
    export CONTAINER_CMD=container
  fi
fi

exec node "$SCRIPT_DIR/xcode-acp-shim.mjs"
