# Offline fixture build. rootfs.tar is generated by the explicit prepare phase.
FROM scratch
ADD rootfs.tar /
ARG BUILD_TIME
ARG AGENT_RUNTIMES
ARG AGENT_DEFAULT_RUNTIME
ARG AGENT_FEATURES
COPY agent.sh /usr/local/bin/agent.sh
COPY agentctl-path.sh /etc/profile.d/agentctl-path.sh
COPY VERSION /etc/agentctl/image-version
COPY VERSION /etc/agentctl/tooling-version
COPY defaults/ /etc/agentctl/
COPY runtimes/ /usr/local/lib/agentctl/runtimes/
COPY runtimes.d/ /etc/agentctl/runtimes.d/
COPY features/ /usr/local/lib/agentctl/features/
COPY features.d/ /etc/agentctl/features.d/
COPY socket-helper.mjs /usr/local/lib/agentctl/compat-socket.mjs
RUN chmod 755 /usr/local/bin/agent.sh \
 && chmod 644 /etc/profile.d/agentctl-path.sh /usr/local/lib/agentctl/compat-socket.mjs \
 && find /etc/agentctl /usr/local/lib/agentctl/runtimes /usr/local/lib/agentctl/features -type d -exec chmod 755 {} + \
 && find /etc/agentctl /usr/local/lib/agentctl/runtimes /usr/local/lib/agentctl/features -type f -exec chmod 644 {} + \
 && chmod 1777 /tmp /var/tmp \
 && printf 'Compatibility fixture\n' > /etc/agentctl/image.md \
 && mkdir -p /home/coder/.codex /home/coder/.config/agentctl \
 && ln -sf /etc/agentctl/image.md /home/coder/.codex/AGENTS.md \
 && chown -R coder:coder /home/coder /workdir /opt/agentctl
USER coder
WORKDIR /workdir
ENV HOME=/home/coder
CMD ["sh", "-c", "sleep infinity"]
