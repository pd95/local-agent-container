{
  "id": "pi",
  "command": "pi",
  "install_method": "npm-prefix",
  "default_config_dir": "/etc/agentctl/pi",
  "capabilities": {
    "install": true,
    "update": true,
    "reset_config": true,
    "auth_login": false,
    "auth_read": false,
    "auth_write": false,
    "local_mode": true,
    "online_mode": false
  },
  "auth_formats": [],
  "launch_configs": {},
  "commands": [
    "help",
    "run",
    "version",
    "refresh",
    "runtime list",
    "preferred get",
    "preferred set pi",
    "runtime info pi",
    "runtime capabilities pi",
    "runtime install pi",
    "runtime update pi",
    "runtime reset-config pi",
    "system manifest"
  ]
}
