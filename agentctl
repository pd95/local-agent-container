     end'
}

apk_repositories_json_from_container() {
  local name="$1"

  "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" sh -c '
if [ -f /etc/apk/repositories ]; then
  sed "/^[[:space:]]*#/d;/^[[:space:]]*$/d" /etc/apk/repositories | sort -u
fi
' 2>/dev/null | jq -R . | jq -s .
}

augment_manifest_with_container_apk_repositories() {
  local name="$1"
  local manifest="$2"
  local repositories_json="[]"

  [ "$(manifest_package_manager "$manifest")" = "apk" ] || {
    printf '%s\n' "$manifest"
    return 0
  }
  [ "$(printf '%s' "$(manifest_apk_repositories_json "$manifest")" | jq -r 'length' 2>/dev/null || printf '0\n')" -eq 0 ] || {
    printf '%s\n' "$manifest"
    return 0
  }
  repositories_json="$(apk_repositories_json_from_container "$name" 2>/dev/null || printf '[]\n')"
  manifest_with_apk_repositories_json "$manifest" "$repositories_json"
}

apk_package_tags_json() {
  local packages_json="${1:-[]}"

  printf '%s' "$packages_json" | jq -c '
    [
      .[]?
      | select(test("@"))
      | split("@")[1]
      | sub("[<>=~].*$"; "")
      | select(length > 0)
    ]
    | unique
    | sort
  ' 2>/dev/null || printf '[]\n'
}

apk_repository_tags_json() {
  local repositories_json="${1:-[]}"

  printf '%s' "$repositories_json" | jq -c '
    [
      .[]?
      | capture("^@(?<tag>[^[:space:]]+)[[:space:]]+.+")?
      | .tag
    ]
    | unique
    | sort
  ' 2>/dev/null || printf '[]\n'
}

apk_repository_lines_for_tags_json() {
  local repositories_json="${1:-[]}"
  local tags_json="${2:-[]}"

  jq -cn \
    --argjson repositories "$repositories_json" \
    --argjson tags "$tags_json" \
    '
      ($tags | map({key: ., value: true}) | from_entries) as $wanted
      | [
          $repositories[]?
          | capture("^@(?<tag>[^[:space:]]+)[[:space:]]+(?<repository>.+)")?
          | select($wanted[.tag] == true)
          | "@" + .tag + " " + .repository
        ]
      | unique
      | sort
    '
}

apk_default_repository_lines_for_tags_json() {
  local tags_json="${1:-[]}"

  printf '%s' "$tags_json" | jq -c '
    [
      .[]?
      | if . == "edgemain" then
          "@edgemain https://dl-cdn.alpinelinux.org/alpine/edge/main"
        elif . == "edgecommunity" then
          "@edgecommunity https://dl-cdn.alpinelinux.org/alpine/edge/community"
        elif . == "edgetesting" then
          "@edgetesting https://dl-cdn.alpinelinux.org/alpine/edge/testing"
        else
          empty
        end
    ]
    | unique
    | sort
  ' 2>/dev/null || printf '[]\n'
}

manifest_installed_runtimes_json() {
