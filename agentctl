  local parsed=""

  raw="$(cat)"
  number_safe_raw="$(printf '%s\n' "$raw" | awk '
    { if (NR > 1) text = text "\n"; text = text $0 }
    END {
      output = ""
      in_string = 0
      escaped = 0
      for (i = 1; i <= length(text); i++) {
        char = substr(text, i, 1)
        if (in_string) {
          output = output char
          if (escaped) escaped = 0
          else if (char == sprintf("%c", 92)) escaped = 1
          else if (char == "\"") in_string = 0
          continue
        }
        if (char == "\"") {
          in_string = 1
          output = output char
          continue
        }
        if (char ~ /[-0-9]/) {
          token = char
          for (j = i + 1; j <= length(text); j++) {
            next_char = substr(text, j, 1)
            if (next_char !~ /[0-9eE+.-]/) break
            token = token next_char
          }
          if (token ~ /^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?$/) {
            output = output "\"__agentctl_json_number__:" token "\""
            i = j - 1
            continue
          }
        }
        output = output char
      }
      print output
    }
  ')"
  if parsed="$(printf '%s' "$number_safe_raw" | jq -er --arg original_raw "$raw" '
    def number_lexeme: sub("^__agentctl_json_number__:"; "");
    def digits: type == "string" and test("^[0-9]+$");
    def pad13:
      tostring as $value
      | if ($value | length) < 13 then ("0000000000000" + $value)[-13:] else $value end;
    def pad13_integer:
      if startswith("-") then
        .[1:] as $magnitude
        | "-" + (if ($magnitude | length) < 12 then ("000000000000" + $magnitude)[-12:] else $magnitude end)
      else pad13 end;
    def python_truthy:
      if . == null or . == false or . == "" or . == 0 then false
      elif (type == "array" or type == "object") and length == 0 then false
      else true end;
    . as $safe
    | ($original_raw | fromjson) as $original
    | (if ($original.refresh_token | python_truthy) then "top"
       elif ($original.tokens.refresh_token | python_truthy) then "tokens"
       elif ($original.claudeAiOauth.refreshToken | python_truthy) then "claude"
       else "none" end) as $token_source
    | (if $token_source == "top" then $original.refresh_token
       elif $token_source == "tokens" then $original.tokens.refresh_token
       elif $token_source == "claude" then $original.claudeAiOauth.refreshToken
       else "" end) as $original_token
    | (if $token_source == "top" then $safe.refresh_token
       elif $token_source == "tokens" then $safe.tokens.refresh_token
       elif $token_source == "claude" then $safe.claudeAiOauth.refreshToken
       else "" end) as $safe_token
    | (if ($original_token | type) == "number" then ($safe_token | number_lexeme) else $original_token end) as $token
    | ($original.last_refresh // null) as $last_refresh
    | ($safe.last_refresh // null) as $safe_last_refresh
    | ($original.claudeAiOauth.expiresAt // "") as $expires_at
    | ($safe.claudeAiOauth.expiresAt // "") as $safe_expires_at
    | (if $last_refresh != null and $last_refresh != "" and $last_refresh != 0 and $last_refresh != false then
         (if ($last_refresh | type) == "number" then ($safe_last_refresh | number_lexeme) else $last_refresh end)
       elif ($expires_at | type) == "number" and (($safe_expires_at | number_lexeme) | test("^-?[0-9]+$")) then
         (($safe_expires_at | number_lexeme) | pad13_integer)
       elif ($expires_at | type) == "number" then ""
       elif ($expires_at | type) == "boolean" then (if $expires_at then ("1" | pad13) else ("0" | pad13) end)
       elif ($expires_at | digits) then ($expires_at | pad13)
       else $expires_at end) as $normalized_refresh
    | "\($token)\t\($normalized_refresh)"
  ' 2>/dev/null)"; then
    printf '%s\n' "$parsed"
    return 0
  fi

  # Preserve the legacy best-effort recovery for truncated credential payloads.
  printf '%s\n' "$raw" | awk '
    function field(name, numeric, pattern, value) {
      if (numeric) pattern = "\"" name "\"[[:space:]]*:[[:space:]]*[0-9]+"
      else pattern = "\"" name "\"[[:space:]]*:[[:space:]]*\"[^\"]+\""
      if (match($0, pattern)) {
        value = substr($0, RSTART, RLENGTH)
        sub(/^[^:]*:[[:space:]]*\"?/, "", value)
        sub(/\"$/, "", value)
        return value
      }
      return ""
    }
    { text = text $0 "\n" }
    END {
      $0 = text
      token = field("refresh_token", 0)
      if (token == "") token = field("refreshToken", 0)
      refresh = field("last_refresh", 0)
      if (refresh == "") refresh = field("expiresAt", 1)
      if (refresh ~ /^[0-9]+$/) while (length(refresh) < 13) refresh = "0" refresh
      printf "%s\t%s\n", token, refresh
    }
  '
}

keychain_auth_info() {
  local runtime="${1:-$DEFAULT_RUNTIME}"
  local auth_format="$2"
  run_keychain_for_runtime "$runtime" "$auth_format" read | auth_info_from_json
}

keychain_auth_blob() {
  local runtime="${1:-$DEFAULT_RUNTIME}"
  local auth_format="$2"
  run_keychain_for_runtime "$runtime" "$auth_format" read
}

write_keychain_auth_blob() {
  local runtime="${1:-$DEFAULT_RUNTIME}"
  local auth_format="$2"
  run_keychain_for_runtime "$runtime" "$auth_format" write
}

container_auth_blob() {
  local name="$1"
  local runtime="${2:-$DEFAULT_RUNTIME}"
  local auth_format="$3"
  if ! run_agent_sh_in_container "$name" auth read "$runtime" "$auth_format"; then
    return 0
  fi
}

write_auth_blob_to_container() {
  local name="$1"
  local payload="$2"
  local runtime="${3:-$DEFAULT_RUNTIME}"
  local auth_format="$4"
  local was_running=0
  local started_for_command=0
  local status=0
  local stderr_file=""

  if ! container_exists "$name"; then
    die "Container not found: $name"
  fi

  if container_running "$name"; then
    was_running=1
  else
    start_existing_container_safely "$name" >/dev/null
    started_for_command=1
  fi

  stderr_file="$(mktemp)"
  if printf '%s' "$payload" | "$CONTAINER_CMD" exec -i "$name" "${SETPRIV_ARGS[@]}" bash /usr/local/bin/agent.sh auth write "$runtime" "$auth_format" 2>"$stderr_file"; then
    status=0
  elif stderr_indicates_legacy_auth_write_fallback "$stderr_file" "$runtime" "$auth_format" && legacy_write_auth_blob_to_container "$name" "$payload" "$runtime" "$auth_format"; then
    warn "Using legacy Codex auth refresh fallback for $name. Run: ${CLI_NAME} refresh --name $name"
    status=0
  else
    cat "$stderr_file" >&2
    status=1
  fi
  rm -f "$stderr_file"

  if [ "$started_for_command" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    stop_existing_container_safely "$name" >/dev/null
  fi

  return "$status"
}

stderr_indicates_legacy_auth_write_fallback() {
  local stderr_file="$1"
  local runtime="${2:-$DEFAULT_RUNTIME}"
  local auth_format="$3"

  [ -f "$stderr_file" ] || return 1

  case "$runtime:$auth_format" in
    codex:json_refresh_token)
      if grep -Fq "can't create directory '/home/coder/.config/agentctl': Permission denied" "$stderr_file"; then
        return 0
      fi
      if grep -Fq 'unknown auth command:' "$stderr_file"; then
        return 0
      fi
      if grep -Fq 'unknown command: auth' "$stderr_file"; then
        return 0
      fi
      if grep -Fq '/usr/local/bin/agent.sh: No such file or directory' "$stderr_file"; then
        return 0
      fi
      ;;
  esac

  return 1
}

legacy_write_auth_blob_to_container() {
  local name="$1"
  local payload="$2"
  local runtime="${3:-$DEFAULT_RUNTIME}"
  local auth_format="$4"

  case "$runtime:$auth_format" in
    codex:json_refresh_token)
      "$CONTAINER_CMD" exec -i -u 0 "$name" sh -lc 'mkdir -p /home/coder/.codex && cat > /home/coder/.codex/auth.json && chown -R coder:coder /home/coder/.codex' <<<"$payload"
      ;;
    *)
      return 1
      ;;
  esac
}

container_auth_info() {
  local name="$1"
  local runtime="${2:-$DEFAULT_RUNTIME}"
  local auth_format="$3"
  local blob
  blob="$(container_auth_blob "$name" "$runtime" "$auth_format")"
  if [ -z "$blob" ]; then
    echo -e "\t"
    return 0
  fi
  printf '%s' "$blob" | auth_info_from_json
}

auth_refresh_values_comparable() {
  local left="$1"
  local right="$2"

  [ -n "$left" ] && [ -n "$right" ] || return 1
  case "$left:$right" in
    *[!0-9]*:*[!0-9]*) return 0 ;;
    *[!0-9]*:*|*:*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

compare_runtime_auth_info() {
  local keychain_token="$1"
  local keychain_refresh="$2"
  local container_token="$3"
  local container_refresh="$4"

  if [ -z "$container_token" ]; then
    printf '%s\n' missing_container
    return 0
  fi
  if [ "$container_token" = "$keychain_token" ] && [ "$container_refresh" = "$keychain_refresh" ]; then
    printf '%s\n' same
    return 0
  fi
  if ! auth_refresh_values_comparable "$keychain_refresh" "$container_refresh"; then
    printf '%s\n' inconclusive_conflict
    return 0
  fi
  if [[ "$container_refresh" > "$keychain_refresh" ]]; then
    printf '%s\n' container_newer
    return 0
  fi
  if [[ "$keychain_refresh" > "$container_refresh" ]]; then
    printf '%s\n' keychain_newer
    return 0
  fi
  printf '%s\n' inconclusive_conflict
}

sync_runtime_auth_to_container() {
  local name="$1"
  local runtime="${2:-$DEFAULT_RUNTIME}"
  local auth_format="$3"
  local missing_message="${4:-Missing runtime auth in Keychain. Run: ${CLI_NAME} auth --runtime $runtime}"
  if ! ensure_keychain "$runtime" "$auth_format"; then
    die "$missing_message"
  fi
  local keychain_info
  local keychain_token
  local keychain_refresh
  keychain_info="$(keychain_auth_info "$runtime" "$auth_format")"
  IFS=$'\t' read -r keychain_token keychain_refresh <<<"$keychain_info"
  if [ -z "$keychain_token" ]; then
    die "$missing_message"
  fi
  local container_info
  local container_token
  local container_refresh
  local auth_status
  container_info="$(container_auth_info "$name" "$runtime" "$auth_format")"
  IFS=$'\t' read -r container_token container_refresh <<<"$container_info"
  auth_status="$(compare_runtime_auth_info "$keychain_token" "$keychain_refresh" "$container_token" "$container_refresh")"
  case "$auth_status" in
    same)
      return 0
      ;;
    missing_container|keychain_newer)
      echo "Refreshing $runtime auth in $name" >&2
      write_auth_blob_to_container "$name" "$(keychain_auth_blob "$runtime" "$auth_format")" "$runtime" "$auth_format"
      ;;
    container_newer)
      echo "Updating Keychain auth from $name" >&2
      container_auth_blob "$name" "$runtime" "$auth_format" | write_keychain_auth_blob "$runtime" "$auth_format"
      ;;
    *)
      die "Refusing to overwrite conflicting $runtime auth for $name because freshness could not be determined. Run ${CLI_NAME} auth --runtime $runtime, or stop the container after a successful online run so refreshed auth can sync back to Keychain."
      ;;
  esac
}

sync_runtime_auth_from_container() {
  local name="$1"
  local runtime="${2:-$DEFAULT_RUNTIME}"
  local auth_format="$3"
  local container_info
  local container_token
  local container_refresh
  container_info="$(container_auth_info "$name" "$runtime" "$auth_format")"
  IFS=$'\t' read -r container_token container_refresh <<<"$container_info"
  if [ -z "$container_token" ] || [ -z "$container_refresh" ]; then
    return 0
  fi
  if ! ensure_keychain "$runtime" "$auth_format"; then
    echo "Keychain auth missing; skipping post-run sync from $name" >&2
    return 0
  fi
  local keychain_info
  local keychain_token
  local keychain_refresh
  local auth_status
  keychain_info="$(keychain_auth_info "$runtime" "$auth_format")"
  IFS=$'\t' read -r keychain_token keychain_refresh <<<"$keychain_info"
  if [ -z "$keychain_token" ]; then
    echo "Keychain auth missing refresh_token; skipping post-run sync from $name" >&2
    return 0
  fi
  auth_status="$(compare_runtime_auth_info "$keychain_token" "$keychain_refresh" "$container_token" "$container_refresh")"
  if [ "$auth_status" = "container_newer" ]; then
    echo "Updating Keychain auth from $name" >&2
    container_auth_blob "$name" "$runtime" "$auth_format" | write_keychain_auth_blob "$runtime" "$auth_format"
  fi
}

runtime_info_in_container() {
  local name="$1"
  local runtime="$2"

  "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" bash /usr/local/bin/agent.sh runtime info "$runtime"
}

sync_runtime_auth_to_container_if_available() {
  local name="$1"
  local runtime="$2"
  local runtime_info=""
  local auth_format=""
  local keychain_info=""
  local keychain_token=""
  local keychain_refresh=""

  runtime_info="$(runtime_info_in_container "$name" "$runtime" 2>/dev/null || true)"
  [ -n "$runtime_info" ] || return 0
  if ! printf '%s' "$runtime_info" | jq -e '.installed == true and (.capabilities.auth_read // false) and (.capabilities.auth_write // false)' >/dev/null 2>&1; then
    return 0
  fi
  auth_format="$(printf '%s' "$runtime_info" | jq -er '.auth_formats[0] // empty' 2>/dev/null || true)"
  [ -n "$auth_format" ] || return 0
  if ! ensure_keychain "$runtime" "$auth_format"; then
    return 0
  fi
  keychain_info="$(keychain_auth_info "$runtime" "$auth_format" 2>/dev/null || true)"
  IFS=$'\t' read -r keychain_token keychain_refresh <<<"$keychain_info"
  [ -n "$keychain_token" ] || return 0
  sync_runtime_auth_to_container "$name" "$runtime" "$auth_format" "Missing runtime auth in Keychain. Run: ${CLI_NAME} auth --runtime $runtime"
}

sync_runtime_auth_from_container_if_available() {
  local name="$1"
  local runtime="$2"
  local runtime_info=""
  local auth_format=""

  runtime_info="$(runtime_info_in_container "$name" "$runtime" 2>/dev/null || true)"
  [ -n "$runtime_info" ] || return 0
  if ! printf '%s' "$runtime_info" | jq -e '.installed == true and (.capabilities.auth_read // false)' >/dev/null 2>&1; then
    return 0
  fi
  auth_format="$(printf '%s' "$runtime_info" | jq -er '.auth_formats[0] // empty' 2>/dev/null || true)"
  [ -n "$auth_format" ] || return 0
  sync_runtime_auth_from_container "$name" "$runtime" "$auth_format"
}

runtime_config_json_from_entries() {
  local config_json='{}'
  local entry=""
  local key=""
  local value=""

  for entry in "$@"; do
    case "$entry" in
      *=*)
        key="${entry%%=*}"
        value="${entry#*=}"
        ;;
      *)
        die "Invalid runtime config: $entry (expected key=value)"
        ;;
    esac
    [ -n "$key" ] || die "Invalid runtime config: $entry (expected non-empty key)"
    config_json="$(printf '%s' "$config_json" | jq -c --arg key "$key" --arg value "$value" '. + {($key): $value}')" || die "Failed to encode runtime config: $entry"
  done

  printf '%s\n' "$config_json"
}

runtime_config_value_from_json() {
  local config_json="${1:-{}}"
  local key="$2"
  local default_value="${3:-}"
  local value=""

  value="$(printf '%s' "$config_json" | jq -er --arg key "$key" '.[$key] // empty' 2>/dev/null || true)"
  if [ -n "$value" ]; then
    printf '%s\n' "$value"
    return 0
  fi
  printf '%s\n' "$default_value"
}

container_image_name() {
  local name="$1"
  local inspect_info=""

  inspect_info="$("$CONTAINER_CMD" inspect "$name" 2>/dev/null | container_upgrade_info)"
  printf '%s\n' "${inspect_info%%$'\t'*}"
}

resolve_auth_image_for_container() {
  local name="$1"
  local fallback_image="$2"
  local image=""

  if container_exists "$name"; then
    image="$(container_image_name "$name")"
  fi
  if [ -z "$image" ]; then
    image="$fallback_image"
  fi
  printf '%s\n' "$image"
}

container_copy_supported() {
  if [ -z "$CONTAINER_COPY_SUPPORT" ]; then
    if "$CONTAINER_CMD" copy --help >/dev/null 2>&1; then
      CONTAINER_COPY_SUPPORT="yes"
    else
      CONTAINER_COPY_SUPPORT="no"
    fi
  fi
  [ "$CONTAINER_COPY_SUPPORT" = "yes" ]
}

container_refresh_stage_path() {
  local name="$1"
  local target="$2"

  "$CONTAINER_CMD" exec -u 0 "$name" sh -c '
    set -e
    target="$1"
    parent=${target%/*}
    [ "$parent" != "$target" ] || parent=.
    mkdir -p "$parent"
    candidate="$target.agentctl-stage.$$"
    suffix=0
    while [ -e "$candidate" ] || [ -L "$candidate" ]; do
      suffix=$((suffix + 1))
      candidate="$target.agentctl-stage.$$.${suffix}"
    done
    printf "%s\n" "$candidate"
  ' sh "$target"
}

cleanup_container_refresh_stage() {
  local name="$1"
  local stage="$2"

  "$CONTAINER_CMD" exec -u 0 "$name" sh -c 'rm -rf -- "$1"' sh "$stage" >/dev/null 2>&1 || true
}

activate_container_refresh_stage() {
  local name="$1"
  local stage="$2"
  local target="$3"

  "$CONTAINER_CMD" exec -u 0 "$name" sh -c '
    stage="$1"
    target="$2"
    backup="$target.agentctl-backup.$$"
    suffix=0
    while [ -e "$backup" ] || [ -L "$backup" ]; do
      suffix=$((suffix + 1))
      backup="$target.agentctl-backup.$$.${suffix}"
    done
    had_target=0
    if [ -e "$target" ] || [ -L "$target" ]; then
      mv -- "$target" "$backup" || exit 1
      had_target=1
    fi
    if ! mv -- "$stage" "$target"; then
      if [ "$had_target" -eq 1 ]; then
        mv -- "$backup" "$target" || {
          echo "Error: failed to restore managed target after activation failure: $target" >&2
          exit 1
        }
      fi
      exit 1
    fi
    if [ "$had_target" -eq 1 ] && ! rm -rf -- "$backup"; then
      echo "Warning: installed managed target but could not remove backup: $backup" >&2
    fi
  ' sh "$stage" "$target"
}

refresh_container_file() {
  local name="$1"
  local source="$2"
  local target="$3"
  local owner="${4:-root:root}"
  local mode="${5:-644}"
  local stage

  [ -f "$source" ] || die "Refresh source not found: $source"
  stage="$(container_refresh_stage_path "$name" "$target")" || die "Failed to prepare refresh staging path for $target"
  if container_copy_supported && [[ "$source" != *:* ]] && [ ! -L "$source" ]; then
    if ! "$CONTAINER_CMD" copy "$source" "$name:$stage" >/dev/null; then
      cleanup_container_refresh_stage "$name" "$stage"
      die "Failed to copy refresh source into $name: $source"
    fi
  elif ! "$CONTAINER_CMD" exec -i -u 0 "$name" sh -c 'cat > "$1"' sh "$stage" <"$source"; then
    cleanup_container_refresh_stage "$name" "$stage"
    die "Failed to stream refresh source into $name: $source"
  fi
  if ! "$CONTAINER_CMD" exec -u 0 "$name" sh -c '
    [ -f "$2" ] && [ ! -L "$2" ] && chmod "$1" "$2" && chown "$3" "$2"
  ' sh "$mode" "$stage" "$owner"; then
    cleanup_container_refresh_stage "$name" "$stage"
    die "Failed to normalize refreshed file: $target"
  fi
  activate_container_refresh_stage "$name" "$stage" "$target" || {
    cleanup_container_refresh_stage "$name" "$stage"
    die "Failed to activate refreshed file: $target"
  }
}

refresh_codex_config_files() {
  local name="$1"
  local target_dir="$2"
  local owner="$3"
  local source_dir=""
  local profile_config=""

  for source_dir in "$DEFAULTS_DIR/codex" "$LOCAL_DEFAULTS_DIR/codex"; do
    [ -d "$source_dir" ] || continue
    if [ -f "$source_dir/config.toml" ]; then
      refresh_container_file "$name" "$source_dir/config.toml" "$target_dir/config.toml" "$owner" "644"
    fi
    for profile_config in "$source_dir"/*.config.toml; do
      [ -e "$profile_config" ] || continue
      refresh_container_file "$name" "$profile_config" "$target_dir/$(basename "$profile_config")" "$owner" "644"
    done
    if [ -f "$source_dir/local_models.json" ]; then
      refresh_container_file "$name" "$source_dir/local_models.json" "$target_dir/local_models.json" "$owner" "644"
    fi
  done
}

runtime_default_file() {
  local runtime="$1"
  local relative_path="$2"
  local local_file="$LOCAL_DEFAULTS_DIR/$runtime/$relative_path"
  local baseline_file="$DEFAULTS_DIR/$runtime/$relative_path"

  if [ -f "$local_file" ]; then
    printf '%s\n' "$local_file"
  else
    printf '%s\n' "$baseline_file"
  fi
}

refresh_optional_runtime_default_file() {
  local name="$1"
  local runtime="$2"
  local relative_path="$3"
  local source_file=""

  source_file="$(runtime_default_file "$runtime" "$relative_path")"
  [ -f "$source_file" ] || return 0
  refresh_container_file "$name" "$source_file" "/etc/agentctl/$runtime/$relative_path" "root:root" "644"
}

refresh_optional_runtime_default_files() {
  local name="$1"

  refresh_optional_runtime_default_file "$name" opencode opencode.json
  refresh_optional_runtime_default_file "$name" qwen settings.json
  refresh_optional_runtime_default_file "$name" pi models.json
}

migrate_legacy_runtime_config_files() {
  local name="$1"

  "$CONTAINER_CMD" exec -u 0 "$name" sh -c '
    set -e
    root="${1:-}"
    legacy_dir="$root/etc/codexctl"
    agent_dir="$root/etc/agentctl"
    agents_file="$root/home/coder/.codex/AGENTS.md"
    image_copy="/tmp/agentctl-image.md.$$"
    migration_stage=""
    migration_dirs=""
    migration_files=""
    cleanup_migration() {
      rm -f "$image_copy"
      [ -z "$migration_dirs" ] || rm -f "$migration_dirs"
      [ -z "$migration_files" ] || rm -f "$migration_files"
      [ -z "$migration_stage" ] || rm -rf "$migration_stage"
    }
    trap cleanup_migration EXIT HUP INT TERM
    migrate_config_dir() {
      source_dir="$1"
      target_dir="$2"
      [ -d "$source_dir" ] || return 0
      migration_stage="$agent_dir/.migration-stage.$$"
      migration_dirs="$agent_dir/.migration-dirs.$$"
      migration_files="$agent_dir/.migration-files.$$"
      rm -rf "$migration_stage"
      mkdir -p "$migration_stage" "$target_dir"
      cp -Rp "$source_dir"/. "$migration_stage"/
      find "$migration_stage" -type d -print >"$migration_dirs"
      while IFS= read -r staged_dir; do
        relative_dir="${staged_dir#"$migration_stage"}"
        [ -n "$relative_dir" ] || continue
        mkdir -p "$target_dir$relative_dir"
      done <"$migration_dirs"
      find "$migration_stage" ! -type d -print >"$migration_files"
      conflicts=0
      while IFS= read -r staged_file; do
        relative_file="${staged_file#"$migration_stage"}"
        target_file="$target_dir$relative_file"
        if [ -e "$target_file" ] || [ -L "$target_file" ]; then
          conflicts=1
          continue
        fi
        mkdir -p "$(dirname "$target_file")"
        cp -Rp "$staged_file" "$target_file"
      done <"$migration_files"
      rm -rf "$migration_stage"
      rm -f "$migration_dirs" "$migration_files"
      migration_stage=""
      migration_dirs=""
      migration_files=""
      if [ "$conflicts" -eq 1 ]; then
        backup_dir="$agent_dir/migration-backups/$(basename "$source_dir")"
        if [ -e "$backup_dir" ]; then
          backup_dir="${backup_dir}.$$"
        fi
        mkdir -p "$(dirname "$backup_dir")"
        mv "$source_dir" "$backup_dir"
        echo "Warning: preserved conflicting legacy defaults at ${backup_dir#"$root"}" >&2
      else
        rm -rf "$source_dir"
      fi
    }
    migrate_codex_dir() {
      source_dir="$1"
      target_dir="$agent_dir/codex"
      [ -d "$source_dir" ] || return 0
      mkdir -p "$target_dir"
      for source_file in "$source_dir/config.toml" "$source_dir"/*.config.toml "$source_dir/local_models.json"; do
        [ -f "$source_file" ] || continue
        target_file="$target_dir/$(basename "$source_file")"
        if [ ! -e "$target_file" ] && [ ! -L "$target_file" ]; then
          cp -p "$source_file" "$target_file"
        fi
      done
      backup_dir="$agent_dir/migration-backups/codexctl"
      if [ -e "$backup_dir" ]; then
        backup_dir="${backup_dir}.$$"
      fi
      mkdir -p "$(dirname "$backup_dir")"
      mv "$source_dir" "$backup_dir"
      echo "Warning: preserved legacy Codex defaults at ${backup_dir#"$root"}" >&2
    }
    if [ -f "$agent_dir/image.md" ]; then
      cp -L "$agent_dir/image.md" "$image_copy"
    fi
    migrate_codex_dir "$legacy_dir"
    rm -f "$agent_dir/config.toml" "$agent_dir"/*.config.toml "$agent_dir/local_models.json"
    if [ -f "$image_copy" ]; then
      rm -f "$agent_dir/image.md"
      cp "$image_copy" "$agent_dir/image.md"
      rm -f "$image_copy"
    fi
    if [ -L "$agents_file" ] && [ "$(readlink "$agents_file")" = "/etc/codexctl/image.md" ]; then
      ln -sf /etc/agentctl/image.md "$agents_file"
    fi
    migrate_config_dir "$root/etc/claudectl" "$agent_dir/claude"
    migrate_config_dir "$root/etc/opencodectl" "$agent_dir/opencode"
    migrate_config_dir "$root/etc/qwenctl" "$agent_dir/qwen"
    migrate_config_dir "$root/etc/pictl" "$agent_dir/pi"
  '
}

write_container_file_content() {
  local name="$1"
  local target="$2"
  local content="$3"
  local owner="${4:-root:root}"
  local mode="${5:-644}"
  local dir

  dir="$(dirname "$target")"
  "$CONTAINER_CMD" exec -u 0 "$name" sh -lc "mkdir -p '$dir'"
  printf '%s\n' "$content" | "$CONTAINER_CMD" exec -i -u 0 "$name" sh -lc "cat > '$target'"
  "$CONTAINER_CMD" exec -u 0 "$name" sh -lc "chmod $mode '$target' && chown $owner '$target'"
}

tar_supports_no_xattrs() {
  tar --no-xattrs -cf /dev/null -T /dev/null >/dev/null 2>&1
}

tar_create_tree_stream() {
  local source="$1"

  if tar_supports_no_xattrs; then
    COPYFILE_DISABLE=1 tar --no-xattrs -C "$source" -cf - .
  else
    COPYFILE_DISABLE=1 tar -C "$source" -cf - .
  fi
}

refresh_container_tree() {
  local name="$1"
  local source="$2"
  local target="$3"
  local owner="${4:-root:root}"
  local file_mode="${5:-644}"
  local dir_mode="${6:-755}"
  local stage

  [ -d "$source" ] || die "Refresh source directory not found: $source"
  stage="$(container_refresh_stage_path "$name" "$target")" || die "Failed to prepare refresh staging path for $target"
  if container_copy_supported && [[ "$source" != *:* ]] && [ ! -L "$source" ]; then
    if ! "$CONTAINER_CMD" copy "$source" "$name:$stage" >/dev/null; then
      cleanup_container_refresh_stage "$name" "$stage"
      die "Failed to copy refresh tree into $name: $source"
    fi
  else
    if ! "$CONTAINER_CMD" exec -u 0 "$name" sh -c 'mkdir "$1"' sh "$stage"; then
      cleanup_container_refresh_stage "$name" "$stage"
      die "Failed to create refresh tree staging directory: $target"
    fi
    if ! tar_create_tree_stream "$source" | "$CONTAINER_CMD" exec -i -u 0 "$name" sh -c 'tar -xf - -C "$1"' sh "$stage"; then
      cleanup_container_refresh_stage "$name" "$stage"
      die "Failed to stream refresh tree into $name: $source"
    fi
  fi
  if ! "$CONTAINER_CMD" exec -u 0 "$name" sh -c '
    [ -d "$2" ] && [ ! -L "$2" ] &&
      chown -h -R "$1" "$2" &&
      find "$2" -type d -exec chmod "$3" {} + &&
      find "$2" -type f -exec chmod "$4" {} +
  ' sh "$owner" "$stage" "$dir_mode" "$file_mode"; then
    cleanup_container_refresh_stage "$name" "$stage"
    die "Failed to normalize refreshed tree: $target"
  fi
  activate_container_refresh_stage "$name" "$stage" "$target" || {
    cleanup_container_refresh_stage "$name" "$stage"
    die "Failed to activate refreshed tree: $target"
  }
}

