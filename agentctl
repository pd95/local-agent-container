images_print_latest() {
  local refs="$1"
  local image_filter="$2"
  local backup_only="$3"
  local family
  local family_refs
  local newest
  local backup_bases
  local backup_base
  local backup_family_refs

  if [ "$backup_only" -eq 1 ]; then
    backup_bases="$(printf '%s\n' "$refs" | while IFS= read -r family_ref; do
      if ! is_codex_backup_image_ref "${family_ref%%:*}"; then
        continue
      fi
      if [ -n "$image_filter" ] && ! image_ref_matches_filter "$family_ref" "$image_filter"; then
        continue
      fi
      image_prune_group "$family_ref"
    done | sort -u)"
    [ -z "$backup_bases" ] && return 0

    while IFS= read -r backup_base; do
      [ -z "$backup_base" ] && continue
      backup_family_refs="$(printf '%s\n' "$refs" | while IFS= read -r family_ref; do
        if ! is_codex_backup_image_ref "${family_ref%%:*}"; then
          continue
        fi
        if [ "$backup_base" != "$(image_prune_group "$family_ref")" ]; then
          continue
        fi
        echo "$family_ref"
      done | sort -r || true)"
      if [ -n "$backup_family_refs" ]; then
        printf '%s\n' "$backup_family_refs"
      fi
    done <<< "$backup_bases"
    return 0
  fi

  while IFS= read -r family; do
    [ -z "$family" ] && continue
    if [ -n "$image_filter" ] && ! image_ref_matches_filter "$family" "$image_filter"; then
      continue
    fi
    family_refs="$(printf '%s\n' "$refs" | awk -F: -v family="$family" '$1 == family { print }' || true)"
    [ -z "$family_refs" ] && continue
    if printf '%s\n' "$family_refs" | grep -qx "$family"; then
      echo "$family"
    fi
    newest="$(printf '%s\n' "$family_refs" | grep -E "^${family}:[0-9]{8}-[0-9]{6}$" | sort -r | head -n 1 || true)"
    if [ -n "$newest" ]; then
      echo "$newest"
    fi
  done <<< "$(list_codex_image_families_from_refs "$refs")"

  backup_bases="$(printf '%s\n' "$refs" | while IFS= read -r family_ref; do
    if ! is_codex_backup_image_ref "${family_ref%%:*}"; then
      continue
    fi
    if [ -n "$image_filter" ] && ! image_ref_matches_filter "$family_ref" "$image_filter"; then
      continue
    fi
    image_prune_group "$family_ref"
  done | sort -u)"
  [ -z "$backup_bases" ] && return 0

  while IFS= read -r backup_base; do
    [ -z "$backup_base" ] && continue
    backup_family_refs="$(printf '%s\n' "$refs" | while IFS= read -r family_ref; do
      if ! is_codex_backup_image_ref "${family_ref%%:*}"; then
        continue
      fi
      if [ "$backup_base" != "$(image_prune_group "$family_ref")" ]; then
        continue
      fi
      echo "$family_ref"
    done || true)"
    if [ -z "$backup_family_refs" ]; then
      continue
    fi
    newest="$(printf '%s\n' "$backup_family_refs" | sort -r | head -n 1 || true)"
    if [ -n "$newest" ]; then
      echo "$newest"
    fi
  done <<< "$backup_bases"
}

images_print_sorted() {
  local refs="$1"
  local include_all="$2"
  local image_filter="$3"
  local backup_only="$4"
  local family
  local family_refs
  local non_family_refs
  local backup_bases
  local backup_refs
  local backup_base
  local backup_ref

  if [ "$backup_only" -eq 1 ]; then
    backup_bases="$(printf '%s\n' "$refs" | while IFS= read -r backup_ref; do
      if ! is_codex_backup_image_ref "${backup_ref%%:*}"; then
        continue
      fi
      if [ -n "$image_filter" ] && ! image_ref_matches_filter "$backup_ref" "$image_filter"; then
        continue
      fi
      image_prune_group "$backup_ref"
    done | sort -u || true)"
    if [ -n "$backup_bases" ]; then
      while IFS= read -r backup_base; do
        [ -z "$backup_base" ] && continue
        backup_refs="$(printf '%s\n' "$refs" | while IFS= read -r backup_ref; do
          if ! is_codex_backup_image_ref "${backup_ref%%:*}"; then
            continue
          fi
          if [ "$backup_base" != "$(image_prune_group "$backup_ref")" ]; then
            continue
          fi
          if [ -n "$image_filter" ] && ! image_ref_matches_filter "$backup_ref" "$image_filter"; then
            continue
          fi
          echo "$backup_ref"
        done | sort -r || true)"
        if [ -n "$backup_refs" ]; then
          printf '%s\n' "$backup_refs"
        fi
      done <<< "$backup_bases"
    fi
    return 0
  fi

  while IFS= read -r family; do
    [ -z "$family" ] && continue
    family_refs="$(printf '%s\n' "$refs" | awk -F: -v family="$family" '$1 == family { print }' || true)"
    if [ -n "$image_filter" ]; then
      family_refs="$(printf '%s\n' "$family_refs" | while IFS= read -r family_ref; do
        if image_ref_matches_filter "$family_ref" "$image_filter"; then
          echo "$family_ref"
        fi
      done || true)"
    fi
    [ -z "$family_refs" ] && continue
    if printf '%s\n' "$family_refs" | grep -qx "$family"; then
      echo "$family"
    fi
    printf '%s\n' "$family_refs" | awk -F: '$2 ~ /^[0-9]{8}-[0-9]{6}$/ { print }' | sort -r
    printf '%s\n' "$family_refs" | awk -F: '$2 != "" && $2 !~ /^[0-9]{8}-[0-9]{6}$/ { print }'
  done <<< "$(list_codex_image_families_from_refs "$refs")"

  if [ "$include_all" -eq 1 ] && [ -z "$image_filter" ]; then
    non_family_refs="$(printf '%s\n' "$refs" | while IFS= read -r ref; do
      [ -z "$ref" ] && continue
      if ! is_codex_image_ref "$ref"; then
        echo "$ref"
      fi
    done || true)"
    if [ -n "$non_family_refs" ]; then
      printf '%s\n' "$non_family_refs"
    fi
  fi

  backup_bases="$(printf '%s\n' "$refs" | while IFS= read -r backup_ref; do
    if ! is_codex_backup_image_ref "${backup_ref%%:*}"; then
      continue
    fi
    if [ -n "$image_filter" ] && ! image_ref_matches_filter "$backup_ref" "$image_filter"; then
      continue
    fi
    image_prune_group "$backup_ref"
  done | sort -u || true)"
  if [ -n "$backup_bases" ]; then
    while IFS= read -r backup_base; do
      [ -z "$backup_base" ] && continue
      backup_refs="$(printf '%s\n' "$refs" | while IFS= read -r backup_ref; do
        if ! is_codex_backup_image_ref "${backup_ref%%:*}"; then
          continue
        fi
        if [ "$backup_base" != "$(image_prune_group "$backup_ref")" ]; then
          continue
        fi
        if [ -n "$image_filter" ] && ! image_ref_matches_filter "$backup_ref" "$image_filter"; then
          continue
        fi
        echo "$backup_ref"
      done | sort -r || true)"
      if [ -n "$backup_refs" ]; then
        printf '%s\n' "$backup_refs"
      fi
    done <<< "$backup_bases"
  fi
}

images_print_metadata() {
  local refs="$1"
  local images_json="$2"
  local rows=""

  rows="$(printf '%s' "$images_json" | jq -r --arg targets "$refs" '
      def norm:
        if type == "string" then sub("^docker\\.io/library/"; "") else "" end;
      def ref:
        (.reference // .configuration.name // .configuration.reference // "") | norm;
      def target_refs($target):
        if ($target | contains("@")) or ($target | split("/")[-1] | contains(":"))
        then [$target]
        else [$target, $target + ":latest"]
        end;
      def round_one_decimal:
        (. * 10 + 0.5 | floor) / 10;
      def human_size:
        if . >= 1073741824 then (. / 1073741824 | round_one_decimal | tostring) + " GiB"
        elif . >= 1048576 then (. / 1048576 | round_one_decimal | tostring) + " MiB"
        elif . >= 1024 then (. / 1024 | round_one_decimal | tostring) + " KiB"
        else tostring + " B"
        end;
      (if type != "array" then error("invalid image list") else . end) as $images
      | ($targets | split("\n") | map(select(length > 0)))[] as $target
      | (target_refs($target)) as $candidate_refs
      | ([$images[] | select(type == "object") | select(ref as $ref | $candidate_refs | index($ref))][0] // {}) as $image
      | ($image.configuration // $image) as $configuration
      | ($configuration.descriptor // $image.descriptor // {}) as $descriptor
      | ($image.variants // []) as $variants
      | (($configuration.creationDate // $configuration.created // $variants[0].config.created // "unknown")
          | if . == "unknown" then . else sub("\\.[0-9]+Z$"; "Z") | sub("T"; " ") end) as $created
      | ([$variants[]? | .size | select(type == "number")] | add) as $variant_size
      | (if $variant_size != null then $variant_size
         elif ($descriptor.size | type) == "number" then $descriptor.size
         else null
         end) as $size
      | ([$variants[]? | .platform? // {}
            | ((.os // "unknown") + "/" + (.architecture // "unknown") + (if .variant then "/" + .variant else "" end))]
          | unique | if length == 0 then ["unknown"] else . end | join(",")) as $platform
      | (($descriptor.digest // $image.id // "unknown")
          | if startswith("sha256:") then .[7:19] else .[0:12] end) as $image_id
      | [$target, $created, (if $size == null then "unknown" else ($size | human_size) end), $platform, $image_id] | @tsv
    ')" || return 1

  printf '%s\n' "$rows" | awk -F '\t' '
    BEGIN {
      image_width = length("IMAGE")
      created_width = length("CREATED")
      size_width = length("SIZE")
      platform_width = length("PLATFORM")
    }
    {
      image[NR] = $1
      created[NR] = $2
      size[NR] = $3
      platform[NR] = $4
      image_id[NR] = $5
      if (length($1) > image_width) image_width = length($1)
      if (length($2) > created_width) created_width = length($2)
      if (length($3) > size_width) size_width = length($3)
      if (length($4) > platform_width) platform_width = length($4)
    }
    END {
      format = "%-" image_width "s  %-" created_width "s  %" size_width "s  %-" platform_width "s  %s\n"
      printf format, "IMAGE", "CREATED", "SIZE", "PLATFORM", "IMAGE ID"
      for (i = 1; i <= NR; i++) {
        if (image[i] == "") {
          print ""
        } else {
          printf format, image[i], created[i], size[i], platform[i], image_id[i]
        }
      }
    }
  '
}

remove_image_ref() {
  local image_ref="$1"
  if "$CONTAINER_CMD" image rm "$image_ref" >/dev/null 2>&1; then
    return 0
  fi
  if "$CONTAINER_CMD" image delete "$image_ref" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

images_list_cmd() {
  local image=""
  local backup=0
  local include_all=0
  local latest=0
  local raw=0
  local refs=""
  local images_json=""
  local filtered_refs=""
  local sorted_refs=""
  local ref

  while [ $# -gt 0 ]; do
    case "$1" in
      --image) image="$2"; shift 2 ;;
      --backup) backup=1; shift ;;
      --all) include_all=1; shift ;;
      --latest) latest=1; shift ;;
      --raw) raw=1; shift ;;
      --help) usage_images; return 0 ;;
      *) die "Unknown option for images: $1" ;;
    esac
  done
  if [ -n "$image" ] && ! is_codex_image_filter_name "$image"; then
    die "Unknown image: $image"
  fi
  if [ "$include_all" -eq 1 ] && [ "$latest" -eq 1 ]; then
    die "Cannot combine --all with --latest"
  fi
  require_container

  refs="$(parse_image_list || true)"
  while IFS= read -r ref; do
    [ -z "$ref" ] && continue
    if [ "$include_all" -eq 0 ] && ! is_codex_image_ref "$ref"; then
      continue
    fi
    if [ -n "$image" ] && ! image_ref_matches_filter "$ref" "$image"; then
      continue
    fi
    if [ "$backup" -eq 1 ] && ! is_codex_backup_image_ref "$ref"; then
      continue
    fi
    filtered_refs="${filtered_refs}${ref}"$'\n'
  done <<< "$refs"
  filtered_refs="${filtered_refs%$'\n'}"
  [ -z "$filtered_refs" ] && return 0

  if [ "$latest" -eq 1 ]; then
    sorted_refs="$(images_print_latest "$filtered_refs" "$image" "$backup")"
  else
    sorted_refs="$(images_print_sorted "$filtered_refs" "$include_all" "$image" "$backup")"
  fi
  if [ "$raw" -eq 1 ]; then
    printf '%s\n' "$sorted_refs"
  else
    images_json="$(image_list_json)"
    if ! printf '%s' "$images_json" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1; then
      warn "Image metadata is unavailable; showing image refs only"
      printf '%s\n' "$sorted_refs"
      return 0
    fi
    if ! images_print_metadata "$sorted_refs" "$images_json" 2>/dev/null; then
      warn "Unable to parse image metadata; showing image refs only"
      printf '%s\n' "$sorted_refs"
    fi
  fi
}

images_prune_cmd() {
  local image=""
  local keep=1
  local backup=0
  local dry_run=0
  local refs=""
  local family_refs=""
  local to_remove=""
  local kept=0
  local failures=0
  local ref=""
  local family=""
  local deletion_ref=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --image) image="$2"; shift 2 ;;
      --keep) keep="$2"; shift 2 ;;
      --backup) backup=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      --help) usage_images_prune; return 0 ;;
      *) die "Unknown option for images prune: $1" ;;
    esac
  done
  if ! [[ "$keep" =~ ^[0-9]+$ ]]; then
    die "--keep must be a non-negative integer: $keep"
  fi
  if [ -n "$image" ] && ! is_codex_image_filter_name "$image"; then
    die "Unknown image: $image"
  fi
  require_container

  refs="$(parse_image_list || true)"
  for family in $(printf '%s\n' "$refs" | while IFS= read -r ref; do
    [ -z "$ref" ] && continue
    if [ -z "$(timestamp_for_image_ref "$ref")" ]; then
      continue
    fi
    if [ "$backup" -eq 1 ] && ! is_codex_backup_image_ref "$ref"; then
      continue
    fi
    if [ -n "$image" ] && ! image_ref_matches_filter "$ref" "$image"; then
      continue
    fi
    image_prune_group "$ref"
  done | sort -u || true); do
    [ -z "$family" ] && continue
    family_refs=""
    while IFS= read -r ref; do
      [ -z "$ref" ] && continue
      if [ "$(image_prune_group "$ref")" != "$family" ]; then
        continue
      fi
      if [ -z "$(timestamp_for_image_ref "$ref")" ]; then
        continue
      fi
      if [ "$backup" -eq 1 ] && ! is_codex_backup_image_ref "$ref"; then
        continue
      fi
      if [ -n "$image" ] && ! image_ref_matches_filter "$ref" "$image"; then
        continue
      fi
      family_refs="${family_refs}${ref}"$'\n'
    done <<< "$refs"
    family_refs="${family_refs%$'\n'}"
    [ -z "$family_refs" ] && continue
    kept=0
    while IFS= read -r ref; do
      if [ "$kept" -lt "$keep" ]; then
        kept=$((kept + 1))
        continue
      fi
      to_remove="${to_remove}${ref}"$'\n'
    done <<< "$(printf '%s\n' "$family_refs" | sort -r || true)"
  done

  to_remove="${to_remove%$'\n'}"
  [ -z "$to_remove" ] && echo "No images to prune" && return 0

  while IFS= read -r deletion_ref; do
    [ -z "$deletion_ref" ] && continue
    if [ "$dry_run" -eq 1 ]; then
      echo "Would remove image: $deletion_ref"
      continue
    fi
    if remove_image_ref "$deletion_ref"; then
      echo "Removed image: $deletion_ref"
    else
      echo "Failed to remove image: $deletion_ref" >&2
      failures=$((failures + 1))
    fi
  done <<< "$to_remove"

  if [ "$failures" -ne 0 ]; then
    return 1
  fi

  return 0
}

images_rm_cmd() {
  local image=""
  local backup=0
  local dry_run=0
  local refs=""
  local to_remove=""
  local failures=0
  local ref=""
  local deletion_ref=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --image) image="$2"; shift 2 ;;
      --backup) backup=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      --help) usage_images_rm; return 0 ;;
      *) die "Unknown option for images rm: $1" ;;
    esac
  done
  [ -n "$image" ] || die "--image is required for images rm"
  if ! is_codex_image_filter_name "$image"; then
    die "Unknown image: $image"
  fi
  require_container

  refs="$(parse_image_list || true)"
  while IFS= read -r ref; do
    [ -z "$ref" ] && continue
    if ! image_ref_matches_filter "$ref" "$image"; then
      continue
    fi
    if [ "$backup" -eq 1 ] && ! is_codex_backup_image_ref "${ref%%:*}"; then
      continue
    fi
    to_remove="${to_remove}${ref}"$'\n'
  done <<< "$refs"

  to_remove="${to_remove%$'\n'}"
  [ -z "$to_remove" ] && echo "No images to remove" && return 0

  while IFS= read -r deletion_ref; do
    [ -z "$deletion_ref" ] && continue
    if [ "$dry_run" -eq 1 ]; then
      echo "Would remove image: $deletion_ref"
      continue
    fi
    if remove_image_ref "$deletion_ref"; then
      echo "Removed image: $deletion_ref"
    else
      echo "Failed to remove image: $deletion_ref" >&2
      failures=$((failures + 1))
    fi
  done <<< "$(printf '%s\n' "$to_remove" | sort -r || true)"

  if [ "$failures" -ne 0 ]; then
    return 1
  fi

  return 0
}

images_cmd() {
  if [ "$#" -gt 0 ] && [ "${1:0:2}" != "--" ]; then
    case "$1" in
      prune) shift; images_prune_cmd "$@" ;;
      rm) shift; images_rm_cmd "$@" ;;
      --help|-h) usage_images; return 0 ;;
      *) die "Unknown images subcommand: $1" ;;
    esac
  else
    images_list_cmd "$@"
  fi
}

