sanitize_keychain_segment() {
  local value="$1"
  printf '%s' "$value" | tr -c 'A-Za-z0-9._-' '-'
}

runtime_keychain_service() {
  local runtime="${1:-$DEFAULT_RUNTIME}"
  local auth_format="$2"

  if [ -n "$auth_format" ]; then
    printf 'agentctl-%s-%s-auth\n' "$(sanitize_keychain_segment "$runtime")" "$(sanitize_keychain_segment "$auth_format")"
