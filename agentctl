  persist_container_system_manifest_baseline_from_live_state "$name" "bootstrapped-container"
  "$CONTAINER_CMD" exec -u 0 "$name" sh -lc '
    set -e
    printf "%s\n" codex >/etc/agentctl/preferred-runtime
    ln -sf /etc/codexctl/image.md /home/coder/.codex/AGENTS.md
    chown -h coder:coder /home/coder/.codex/AGENTS.md
    cat >/etc/agentctl/bootstrap.json <<JSON
{"schema_version":1,"bootstrapped":true,"bootstrap_package_manager":"apt-get","bootstrap_mode":"in-place"}
JSON
  '
  rm -f "$image_md_file"
