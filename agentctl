    printf 'runtime-%s-auth\n' "$(sanitize_keychain_segment "$runtime")"
  fi
}

run_keychain_with_slot() {
  local service="$1"
  local account="$2"
  shift 2

  KEYCHAIN_SERVICE_NAME="$service" \
  KEYCHAIN_ACCOUNT_NAME="$account" \
  "$KEYCHAIN_SCRIPT" "$@"
}

run_keychain_for_runtime() {
  local runtime="${1:-$DEFAULT_RUNTIME}"
  local auth_format="$2"
  local primary_service=""
  local primary_account=""
  shift 2

  primary_service="$(runtime_keychain_service "$runtime" "$auth_format")"
  primary_account="$(runtime_keychain_account "$runtime" "$auth_format")"
  run_keychain_with_slot "$primary_service" "$primary_account" "$@"
}

