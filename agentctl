container_state_permission_script() {
  cat <<'EOF'
set -eu
fix="${1:-0}"
home="/home/coder"
if ! id coder >/dev/null 2>&1; then
  echo "missing-user coder"
  exit 2
fi
[ -d "$home" ] || exit 0
tmp="$(mktemp)"
for path in \
  .codex \
  .config/agentctl \
  .claude \
  .claude.json \
  .profile \
  .bashrc \
  .bash_profile \
  .bash_login \
  .bash_logout \
  .bash_history \
  .zshrc \
  .zprofile \
  .zlogin \
  .zlogout \
  .zshenv \
  .zsh_history \
  .ash_history \
  .sh_history; do
  [ -e "$home/$path" ] || continue
  find "$home/$path" ! -type l \( \
    ! -user coder -o \
    ! -perm -u+r -o \
    \( -type d ! -perm -u+x \) \
  \) -print
done >"$tmp"
if [ -s "$tmp" ]; then
  sed "s#^$home/##" "$tmp"
  if [ "$fix" = "1" ]; then
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      chown coder:coder "$item" 2>/dev/null || true
      if [ -d "$item" ] && [ ! -L "$item" ]; then
        chmod u+rwx "$item" 2>/dev/null || true
      elif [ -f "$item" ]; then
        chmod u+rw "$item" 2>/dev/null || true
      fi
    done <"$tmp"
  fi
fi
rm -f "$tmp"
EOF
}

