  local manifest="${1:-}"

  [ -n "$manifest" ] || manifest='{}'

  printf '%s' "$manifest" | jq -c '.apk_repositories // []' 2>/dev/null || printf '[]\n'
}

manifest_with_apk_repositories_json() {
  local manifest="${1:-}"
  local repositories_json="${2:-[]}"

  [ -n "$manifest" ] || manifest='{}'

  printf '%s' "$manifest" | jq -c \
    --argjson repositories "$repositories_json" \
    'if (.package_manager // "unknown") == "apk" and ((.apk_repositories // []) | length) == 0 then
       . + {apk_repositories: $repositories}
     else
