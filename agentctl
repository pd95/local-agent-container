display_memory_limit() {
  local value="$1"
  local unit=""
  local divisor=1

  if [ -z "$value" ] || [ "$value" = "0" ]; then
    printf 'unlimited\n'
    return 0
  fi
  if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$value"
    return 0
  fi

  if [ $((value % 1073741824)) -eq 0 ]; then
    unit="G"
    divisor=1073741824
  elif [ $((value % 1048576)) -eq 0 ]; then
    unit="M"
    divisor=1048576
  elif [ $((value % 1024)) -eq 0 ]; then
    unit="K"
    divisor=1024
  fi

  if [ -n "$unit" ]; then
    printf '%s%s\n' "$((value / divisor))" "$unit"
    return 0
  fi
  printf '%s\n' "$value"
}

size_to_bytes() {
  local value="$1"
  local number=""
  local suffix=""

  [ -n "$value" ] || return 1
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$value"
    return 0
  fi
  if [[ "$value" =~ ^([0-9]+)([KMGT])B?$ ]]; then
    number="${BASH_REMATCH[1]}"
    suffix="${BASH_REMATCH[2]}"
    case "$suffix" in
      K) printf '%s\n' $((number * 1024)) ;;
      M) printf '%s\n' $((number * 1048576)) ;;
      G) printf '%s\n' $((number * 1073741824)) ;;
      T) printf '%s\n' $((number * 1099511627776)) ;;
      *) return 1 ;;
    esac
    return 0
  fi
  return 1
}

runtime_install_memory_pressure_limit() {
  local name="$1"
  local runtime="$2"
  local inspect_info=""
  local current_mem=""
  local current_bytes=""
  local required_bytes=""
  local current_display=""

  [ "$runtime" = "claude" ] || return 0
  inspect_info="$("$CONTAINER_CMD" inspect "$name" 2>/dev/null | container_upgrade_info)"
  current_mem="${inspect_info##*$'\t'}"
  [ -n "$current_mem" ] || return 1
  [ "$current_mem" != "0" ] || return 1

  current_bytes="$(size_to_bytes "$current_mem" 2>/dev/null || true)"
  required_bytes="$(size_to_bytes "$CLAUDE_MIN_INSTALL_MEM" 2>/dev/null || true)"
  [ -n "$current_bytes" ] || return 1
  [ -n "$required_bytes" ] || return 1
  if [ "$current_bytes" -lt "$required_bytes" ]; then
    current_display="$(display_memory_limit "$current_mem")"
    printf '%s\n' "$current_display"
    return 0
  fi
  return 1
}

install_runtime_in_container() {
  local name="$1"
  local runtime="$2"
  local skip_preferred="${3:-0}"
  local low_mem_limit=""
  local status=0

  low_mem_limit="$(runtime_install_memory_pressure_limit "$name" "$runtime" 2>/dev/null || true)"
  if [ -n "$low_mem_limit" ]; then
    warn "Container $name is limited to $low_mem_limit. Claude install may be killed by memory pressure; if that happens, recreate it with: ${CLI_NAME} upgrade --name $name --mem $CLAUDE_MIN_INSTALL_MEM"
  fi

  if [ "$skip_preferred" -eq 1 ]; then
    if run_agent_sh_in_container_env "$name" AGENTCTL_SKIP_PREFERRED_SET=1 -- runtime install "$runtime"; then
      return 0
    fi
  elif run_agent_sh_in_container "$name" runtime install "$runtime"; then
    return 0
  fi
  status=$?

  if [ -n "$low_mem_limit" ]; then
    die "Claude runtime install failed in $name. The container is limited to $low_mem_limit, and the installer can be killed by memory pressure. Recreate it with: ${CLI_NAME} upgrade --name $name --mem $CLAUDE_MIN_INSTALL_MEM"
  fi
  return "$status"
}

ensure_target_default_runtime_installed() {
  local name="$1"
  local runtime="$2"
  local reason="${3:-runtime}"
  local required="${4:-0}"

  [ -n "$runtime" ] || return 0
  if target_runtime_installed "$name" "$runtime"; then
    return 0
  fi
  if target_runtime_installable "$name" "$runtime"; then
    echo "Reinstalling $reason in $name: $runtime" >&2
    install_runtime_in_container "$name" "$runtime" 1 || die "Failed to install required runtime during upgrade: $runtime"
    return 0
  fi
  if [ "$required" -eq 1 ]; then
    die "Required runtime $runtime is not available after upgrade and cannot be installed automatically"
  fi
  warn "Runtime $runtime is not available after upgrade and cannot be reinstalled automatically"
  return 1
}

target_feature_installed() {
  local name="$1"
  local feature="$2"
  local feature_info=""

  feature_info="$(run_agent_sh_in_container "$name" feature info "$feature" 2>/dev/null)" || return 1
  printf '%s' "$feature_info" | jq -e '.installed == true' >/dev/null 2>&1
}

ensure_target_feature_installed() {
  local name="$1"
  local feature="$2"

  [ -n "$feature" ] || return 0
  if target_feature_installed "$name" "$feature"; then
    return 0
  fi
  if target_feature_installable "$name" "$feature"; then
    echo "Reinstalling added feature in $name after restore: $feature" >&2
    run_agent_sh_in_container_root "$name" feature install "$feature" || die "Failed to reinstall feature after restore during upgrade: $feature"
    return 0
  fi
  warn "Feature $feature is not available after upgrade and cannot be reinstalled automatically"
  return 1
}

ensure_relevant_runtimes_and_features_after_restore() {
  local name="$1"
  local target_default_runtime="${2:-}"
  local current_preferred_runtime="${3:-}"
  local added_runtimes_json="${4:-[]}"
  local added_features_json="${5:-[]}"
  local runtime=""
  local feature=""

  ensure_target_default_runtime_installed "$name" "$target_default_runtime" "target default runtime" 1
  ensure_target_default_runtime_installed "$name" "$current_preferred_runtime" "preferred runtime" 0 || true

  while IFS= read -r runtime; do
    [ -n "$runtime" ] || continue
    ensure_target_default_runtime_installed "$name" "$runtime" "added runtime" 0 || true
  done < <(printf '%s' "$added_runtimes_json" | jq -r '.[]' 2>/dev/null || true)

  while IFS= read -r feature; do
    [ -n "$feature" ] || continue
    ensure_target_feature_installed "$name" "$feature" || true
  done < <(printf '%s' "$added_features_json" | jq -r '.[]' 2>/dev/null || true)
}

runtime_cmd() {
  local name=""
  local subcommand=""
  local runtime=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --help) usage_runtime; return 0 ;;
      *)
        if [ -z "$subcommand" ]; then
          subcommand="$1"
        elif [ -z "$runtime" ]; then
          runtime="$1"
        else
          die "Unexpected argument for runtime: $1"
        fi
        shift
        ;;
    esac
  done

  require_container
  if [ -z "$name" ]; then
    name="$(default_name "$DEFAULT_NAME_PREFIX")"
  fi

  case "$subcommand" in
    list)
      run_agent_sh_in_container "$name" runtime list
      ;;
    info|capabilities|reset-config)
      [ -n "$runtime" ] || die "Missing runtime for $subcommand"
      run_agent_sh_in_container "$name" runtime "$subcommand" "$runtime"
      ;;
    install|update)
      [ -n "$runtime" ] || die "Missing runtime for $subcommand"
      if [ "$subcommand" = "install" ]; then
        install_runtime_in_container "$name" "$runtime"
        return 0
      fi
      run_agent_sh_in_container "$name" runtime "$subcommand" "$runtime"
      ;;
    use)
      [ -n "$runtime" ] || die "Missing runtime for $subcommand"
      set_preferred_runtime_in_container "$name" "$runtime"
      ;;
    "")
      usage_runtime
      ;;
    *)
      die "Unknown runtime command: $subcommand"
      ;;
  esac
}

