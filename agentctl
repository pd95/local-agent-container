bootstrap_cmd() {
  local name=""
  local image=""
  local workdir=""
  local cpu=""
  local mem=""
  local shm_size=""
  local -a networks=()
  local was_running=0
  local started_for_bootstrap=0
  local created_for_bootstrap=0
  local package_manager=""
  local ssh_requested=0
  local socket_mappings=""
  local published_sockets=""
  local mapping=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ "$#" -ge 2 ] || die "Missing value for --name"; name="$2"; shift 2 ;;
      --image) image="$2"; shift 2 ;;
      --workdir) workdir="$2"; shift 2 ;;
      --cpu) cpu="$2"; shift 2 ;;
      --mem) mem="$2"; shift 2 ;;
      --shm-size) shm_size="$2"; shift 2 ;;
      --network) [ "$#" -ge 2 ] || die "Missing value for --network"; networks+=("$2"); shift 2 ;;
      --ssh) ssh_requested=1; shift ;;
      --mount-socket)
        [ "$#" -ge 2 ] || die "Missing value for --mount-socket"
        mapping="$(parse_socket_mapping "$2")"
        socket_mappings="${socket_mappings}${socket_mappings:+$'\n'}${mapping}"
        shift 2
        ;;
      --publish-socket)
        [ "$#" -ge 2 ] || die "Missing value for --publish-socket"
        mapping="$(parse_published_socket_mapping "$2")"
        published_sockets="${published_sockets}${published_sockets:+$'\n'}${mapping}"
        shift 2
        ;;
      --help) usage_bootstrap; return 0 ;;
      *) die "Unknown option for bootstrap: $1" ;;
    esac
  done

  require_container
  validate_requested_socket_mappings "$socket_mappings"
  validate_requested_published_sockets "$published_sockets"
  validate_published_container_collisions "$published_sockets" "$socket_mappings"
  if [ "${#networks[@]}" -gt 0 ]; then
    validate_network_selection "${networks[@]}"
  fi
  if [ -z "$name" ]; then
    if [ -z "$workdir" ]; then
      name="$(default_name "$DEFAULT_NAME_PREFIX")"
    else
      name="$(default_name "$DEFAULT_NAME_PREFIX" "$workdir")"
    fi
  fi

  if [ -n "$workdir" ]; then
    [ -d "$workdir" ] || die "Workdir not found: $workdir"
    workdir="$(CDPATH= cd -- "$workdir" && pwd)"
  else
    workdir="$PWD"
  fi

  if container_exists "$name"; then
    if [ -n "$image" ] || [ -n "$cpu" ] || [ -n "$mem" ] || [ -n "$shm_size" ] || [ "${#networks[@]}" -gt 0 ]; then
      die "--image, --cpu, --mem, --shm-size, and --network only apply when bootstrap creates a new container"
    fi
    validate_existing_container_ssh "$name" "$ssh_requested"
    validate_existing_socket_mappings "$name" "$socket_mappings"
    validate_existing_published_sockets "$name" "$published_sockets"
  else
    [ -n "$image" ] || die "Container not found: $name (pass --image to create and bootstrap a new container)"
    validate_published_host_paths_for_start "$published_sockets"
    echo "Creating bootstrap container..." >&2
    local create_cmd=("$CONTAINER_CMD" create -t)
    if [ "$ssh_requested" -eq 1 ]; then
      require_container_ssh_support
      require_host_ssh_socket
      create_cmd+=(--ssh)
    fi
    if [ -n "$cpu" ]; then
      create_cmd+=(-c "$cpu")
    fi
    if [ -n "$mem" ]; then
      create_cmd+=(-m "$mem")
    fi
    if [ -n "$shm_size" ]; then
      require_container_shm_size_support
      create_cmd+=(--shm-size "$shm_size")
    fi
    local network_name=""
    if [ "${#networks[@]}" -gt 0 ]; then
      for network_name in "${networks[@]}"; do
        create_cmd+=(--network "$network_name")
      done
    fi
    create_cmd+=(
      --name "$name"
      --mount "type=bind,src=$workdir,dst=/workdir"
    )
    while IFS= read -r mapping; do
      [ -n "$mapping" ] || continue
      create_cmd+=(--volume "$mapping")
    done < <(socket_volume_arguments "$socket_mappings")
    while IFS= read -r mapping; do
      [ -n "$mapping" ] || continue
      create_cmd+=(--publish-socket "$mapping")
    done < <(published_socket_arguments "$published_sockets")
    create_cmd+=("$image" sh -c 'sleep infinity')
    "${create_cmd[@]}"
    created_for_bootstrap=1
  fi

  if container_running "$name"; then
    was_running=1
    validate_running_published_listeners "$published_sockets"
  else
    validate_published_host_paths_for_start "$published_sockets"
    "$CONTAINER_CMD" start "$name" >/dev/null
    started_for_bootstrap=1
  fi

  package_manager="$("$CONTAINER_CMD" exec -u 0 "$name" sh -lc 'if command -v apk >/dev/null 2>&1; then echo apk; elif command -v apt-get >/dev/null 2>&1; then echo apt-get; else echo unsupported; fi')"
  case "$package_manager" in
    apk)
      bootstrap_container_alpine "$name"
      ;;
    apt-get)
      bootstrap_container_apt "$name"
      ;;
    *)
      if [ "$started_for_bootstrap" -eq 1 ] && [ "$was_running" -eq 0 ]; then
        stop_existing_container_safely "$name" >/dev/null
      fi
      die "Unsupported bootstrap container base for current bootstrap slice: $name (need Alpine/apk or Debian/Ubuntu apt-get)"
      ;;
  esac

  if [ "$ssh_requested" -eq 1 ]; then
    ensure_requested_feature_installed "$name" ssh
  fi

  if [ "$started_for_bootstrap" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    "$CONTAINER_CMD" stop "$name" >/dev/null
    report_leftover_published_sockets "$published_sockets" || true
  fi
  if [ "$created_for_bootstrap" -eq 1 ]; then
    echo "Bootstrap container ready: $name" >&2
  fi
  echo "Bootstrap complete: $name" >&2
}

refresh_cmd() {
  local name=""
  local was_running=0
  local started_for_refresh=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --help) usage_refresh; return 0 ;;
      *) die "Unknown option for refresh: $1" ;;
    esac
  done

  require_container
  if [ -z "$name" ]; then
    name="$(default_name "$DEFAULT_NAME_PREFIX")"
  fi
  if ! container_exists "$name"; then
    die "Container not found: $name"
  fi

  if container_running "$name"; then
    was_running=1
  else
    echo "Starting container for refresh: $name" >&2
    start_existing_container_safely "$name" >/dev/null
    started_for_refresh=1
  fi

  refresh_container_file "$name" "$SCRIPT_DIR/agent.sh" "/usr/local/bin/agent.sh" "root:root" "755"
  migrate_legacy_runtime_config_files "$name"
  refresh_container_file "$name" "$SCRIPT_DIR/VERSION" "/etc/agentctl/tooling-version" "root:root" "644"
  refresh_codex_config_files "$name" "/etc/agentctl/codex" "root:root"
  refresh_container_file "$name" "$(runtime_default_file claude settings.json)" "/etc/agentctl/claude/settings.json" "root:root" "644"
  refresh_optional_runtime_default_files "$name"
  refresh_container_file "$name" "$SCRIPT_DIR/agentctl-path.sh" "/etc/profile.d/agentctl-path.sh" "root:root" "644"
  refresh_container_tree "$name" "$SCRIPT_DIR/runtimes" "/usr/local/lib/agentctl/runtimes" "root:root" "644" "755"
  refresh_container_tree "$name" "$SCRIPT_DIR/runtimes.d" "/etc/agentctl/runtimes.d" "root:root" "644" "755"
  refresh_container_tree "$name" "$SCRIPT_DIR/features" "/usr/local/lib/agentctl/features" "root:root" "644" "755"
  refresh_container_tree "$name" "$SCRIPT_DIR/features.d" "/etc/agentctl/features.d" "root:root" "644" "755"
  "$CONTAINER_CMD" exec -u 0 "$name" sh -lc 'mkdir -p /opt/agentctl/bin /opt/agentctl/codex /opt/agentctl/claude && chown -R coder:coder /opt/agentctl' >/dev/null 2>&1 || true
  if "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" test -x /usr/local/bin/agent.sh; then
    "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" bash /usr/local/bin/agent.sh refresh >/dev/null 2>&1 || true
  fi

  if [ "$started_for_refresh" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    echo "Stopping container: $name" >&2
    stop_existing_container_safely "$name" >/dev/null
  fi
  echo "Refresh complete: $name" >&2
}

host_capability() {
  local label="$1"
  shift

  if "$@" >/dev/null 2>&1; then
    printf '  %-24s %s\n' "$label" yes
  else
    printf '  %-24s %s\n' "$label" no
  fi
}

container_help_contains() {
  local pattern="$1"
  shift

  "$CONTAINER_CMD" "$@" --help 2>/dev/null | grep -Fq -- "$pattern"
}

container_command_available() {
  local command_name="$1"

  "$CONTAINER_CMD" --help 2>/dev/null \
    | grep -Eq "^[[:space:]]+${command_name}([,[:space:]]|$)"
}

container_system_df_supported() {
  "$CONTAINER_CMD" system df --help 2>/dev/null | grep -Fq -- '--format'
}

container_storage_usage_json() {
  local output=""

  output="$("$CONTAINER_CMD" system df --format json 2>&1)" || {
    printf '%s\n' "$output" >&2
    return 1
  }
  printf '%s' "$output" | jq -ce '
    def valid_usage:
      type == "object"
      and ([.total, .active, .sizeInBytes, .reclaimable]
        | all(type == "number" and . >= 0 and floor == .));
    if type == "object"
      and (.images | valid_usage)
      and (.containers | valid_usage)
      and (.volumes | valid_usage)
    then {
      images: .images,
      containers: .containers,
      volumes: .volumes
    }
    else error("invalid container system df JSON")
    end
  '
}

format_storage_bytes() {
  local bytes="$1"

  awk -v bytes="$bytes" 'BEGIN {
    split("B KiB MiB GiB TiB PiB", units, " ")
    value = bytes + 0
    unit = 1
    while (value >= 1024 && unit < 6) {
      value /= 1024
      unit++
    }
    if (unit == 1) printf "%.0f %s", value, units[unit]
    else if (value >= 10) printf "%.1f %s", value, units[unit]
    else printf "%.2f %s", value, units[unit]
  }'
}

print_container_storage_usage() {
  local storage_json="$1"
  local label=""
  local total=""
  local active=""
  local size=""
  local reclaimable=""

  printf '  %-14s %7s %7s %12s %12s\n' Type Total Active Size Reclaimable
  while IFS=$'\t' read -r label total active size reclaimable; do
    [ -n "$label" ] || continue
    printf '  %-14s %7s %7s %12s %12s\n' \
      "$label" "$total" "$active" \
      "$(format_storage_bytes "$size")" \
      "$(format_storage_bytes "$reclaimable")"
  done < <(printf '%s' "$storage_json" | jq -r '
    [["Images", .images], ["Containers", .containers], ["Volumes", .volumes]][]
    | [.[0], .[1].total, .[1].active, .[1].sizeInBytes, .[1].reclaimable]
    | @tsv
  ')
}

report_backup_storage_diagnostics() {
  local storage_json=""

  if ! container_system_df_supported; then
    warn "Apple container storage diagnostics are unavailable; inspect the runtime and host free space before retrying"
    return 0
  fi
  if ! storage_json="$(container_storage_usage_json 2>/dev/null)"; then
    warn "Unable to read Apple container storage diagnostics; run: ${CLI_NAME} doctor --host"
    return 0
  fi

  echo "Apple container runtime storage at backup failure:" >&2
  print_container_storage_usage "$storage_json" >&2
  echo "  Reclaimable is a runtime classification, not confirmation that data is safe to delete." >&2
  echo "  Inspect with: ${CLI_NAME} doctor --host" >&2
  echo "  Preview agent image cleanup with: ${CLI_NAME} images prune --dry-run" >&2
}

host_doctor() {
  local cli_path=""
  local cli_version=""
  local system_version=""
  local jq_path=""
  local detected_jq_version=""
  local storage_json=""
  local status=0

  printf 'Host JSON processor\n'
  if jq_path="$(command -v jq 2>/dev/null)"; then
    detected_jq_version="$(jq_version)"
    printf '  %-24s %s\n' path "$jq_path"
    printf '  %-24s %s\n' version "${detected_jq_version:-unknown}"
    if jq_version_supported "$detected_jq_version"; then
      printf '  %-24s %s\n' supported yes
    else
      printf '  %-24s %s\n' supported no
      status=1
    fi
  else
    printf '  %-24s %s\n' path missing
    printf '  %-24s %s\n' version unknown
    printf '  %-24s %s\n' supported no
    status=1
  fi

  command -v "$CONTAINER_CMD" >/dev/null 2>&1 || die "Missing '$CONTAINER_CMD' command"
  cli_path="$(command -v "$CONTAINER_CMD")"
  cli_version="$("$CONTAINER_CMD" --version 2>&1)" || status=1

  printf 'Container CLI\n'
  printf '  %-24s %s\n' path "$cli_path"
  printf '  %-24s %s\n' version "${cli_version:-unknown}"

  printf 'Container service\n'
  if system_version="$("$CONTAINER_CMD" system version --format json 2>&1)"; then
    printf '%s\n' "$system_version" | sed 's/^/  /'
  else
    printf '  unavailable: %s\n' "$system_version"
    status=1
  fi

  printf 'Capabilities\n'
  host_capability 'quiet container list' container_help_contains --quiet list
  host_capability 'JSON container list' container_help_contains --format list
  host_capability 'container export file' container_help_contains --output export
  host_capability 'container copy' container_command_available copy
  host_capability 'SSH agent forwarding' container_help_contains --ssh run
  host_capability 'Unix socket publish' container_help_contains --publish-socket run
  host_capability 'shared memory size' container_help_contains --shm-size run
  host_capability 'custom networks' container_command_available network
  host_capability 'host-only networks' container_help_contains --internal network create
  host_capability 'container machine' container_command_available machine
  host_capability 'storage accounting' container_system_df_supported

  printf 'Container storage\n'
  if ! container_system_df_supported; then
    printf '  unavailable: container system df is not supported by this runtime\n'
  elif storage_json="$(container_storage_usage_json 2>&1)"; then
    print_container_storage_usage "$storage_json"
    printf '  Note: values cover the global Apple container runtime. Reclaimable does not mean safe to delete; stopped containers and volumes may contain valuable state.\n'
  else
    printf '  unavailable: %s\n' "${storage_json:-invalid container system df response}"
    status=1
  fi

  return "$status"
}

container_network_list_json() {
  "$CONTAINER_CMD" network list --format json 2>/dev/null \
    || "$CONTAINER_CMD" network ls --format json 2>/dev/null
}

network_normalized_json() {
  jq -Rrs --arg managed_label "$AGENTCTL_NETWORK_LABEL" '
    (try fromjson catch null) as $parsed
    | if ($parsed | type) != "array" then error("invalid network list JSON") else $parsed end
    | map(
        . as $item
        | ($item.configuration // $item) as $config
        | ($item.status // {}) as $status
        | {
            name: ($item.id // $item.name // $config.name // $config.id // ""),
            mode: ($config.mode // $item.mode // "unknown"),
            ipv4Subnet: ($status.ipv4Subnet // $config.ipv4Subnet // $config.subnet // ""),
            ipv6Subnet: ($status.ipv6Subnet // $config.ipv6Subnet // ""),
            labels: ($config.labels // $item.labels // {}),
            managed: (($config.labels // $item.labels // {})[$managed_label] == "true")
          }
      )
    | if any(.name == "") then error("network entry has no name") else sort_by(.name) end
  '
}

network_list_normalized_json() {
  container_network_list_json | network_normalized_json
}

network_inspect_normalized_json() {
  local name="$1"

  "$CONTAINER_CMD" network inspect "$name" 2>/dev/null | jq -Rrs --arg name "$name" --arg managed_label "$AGENTCTL_NETWORK_LABEL" '
    (try fromjson catch null) as $parsed
    | if $parsed == null then error("invalid network inspect JSON")
      elif ($parsed | type) == "array" then ($parsed[0] // {})
      elif ($parsed | type) == "object" then $parsed
      else error("invalid network inspect JSON") end
    | . as $item
    | ($item.configuration // $item) as $config
    | ($item.status // {}) as $status
    | {
        name: ($item.id // $item.name // $config.name // $config.id // $name),
        mode: ($config.mode // $item.mode // "unknown"),
        ipv4Subnet: ($status.ipv4Subnet // $config.ipv4Subnet // $config.subnet // ""),
        ipv4Gateway: ($status.ipv4Gateway // $status.gateway // ""),
        ipv6Subnet: ($status.ipv6Subnet // $config.ipv6Subnet // ""),
        labels: ($config.labels // $item.labels // {}),
        managed: (($config.labels // $item.labels // {})[$managed_label] == "true")
      }
  '
}

network_mode() {
  network_inspect_normalized_json "$1" | jq -er '.mode | strings | select(length > 0)'
}

network_is_managed() {
  network_inspect_normalized_json "$1" | jq -e '.managed == true' >/dev/null
}

network_exists() {
  "$CONTAINER_CMD" network inspect "$1" >/dev/null 2>&1
}

require_custom_network_support() {
  container_command_available network \
    || die "Custom networks require an Apple container runtime with 'container network' support"
  container_help_contains --network create \
    || die "Custom networks require an Apple container runtime with 'container create --network <name>' support"
}

require_host_only_network_support() {
  if ! "$CONTAINER_CMD" network create --help 2>/dev/null | grep -Fq -- '--internal'; then
    die "Host-only networks require an Apple container runtime with 'container network create --internal' support"
  fi
}

validate_network_name_argument() {
  local name="$1"

  [ -n "$name" ] || die "Network name cannot be empty"
  case "$name" in
    *,*) die "Network attachment options are not supported by agentctl: $name (pass a network name only)" ;;
  esac
}

validate_network_selection() {
  local name=""
  local mode=""
  local seen=""
  local count=0
  local host_only_count=0

  [ "$#" -gt 0 ] || return 0
  require_custom_network_support
  for name in "$@"; do
    validate_network_name_argument "$name"
    if printf '%s\n' "$seen" | grep -Fqx -- "$name"; then
      die "Duplicate network attachment: $name"
    fi
    seen="${seen}${name}"$'\n'
    network_exists "$name" || die "Container network not found: $name"
    mode="$(network_mode "$name")" || die "Unable to determine mode for container network: $name"
    case "$mode" in
      hostOnly|hostonly|host-only|internal) host_only_count=$((host_only_count + 1)) ;;
      nat) ;;
      *) die "Unsupported container network mode for $name: $mode" ;;
    esac
    count=$((count + 1))
  done
  if [ "$host_only_count" -gt 0 ] && [ "$count" -gt 1 ]; then
    die "A host-only network cannot be combined with another network because that could restore external access"
  fi
}

network_selection_is_host_only() {
  local name=""
  for name in "$@"; do
    case "$(network_mode "$name" 2>/dev/null || true)" in
      hostOnly|hostonly|host-only|internal) return 0 ;;
    esac
  done
  return 1
}

container_network_specs() {
  local name="$1"

  "$CONTAINER_CMD" inspect "$name" 2>/dev/null | jq -Rrs '
    (try fromjson catch null) as $parsed
    | if $parsed == null then error("invalid container inspect JSON")
      elif ($parsed | type) == "array" then ($parsed[0] // {})
      elif ($parsed | type) == "object" then $parsed
      else error("invalid container inspect JSON") end
    | . as $data
    | ($data.configuration // $data) as $config
    | (($config.networks // []) | if length > 0 then . else ($data.status.networks // $data.networks // []) end)[]
    | if type == "string" then .
      else (.network // .name // .id // "") as $name
      | if $name == "" then error("network attachment has no name") else
          ($name
           + (if (.options.macAddress // null) != null then ",mac=" + (.options.macAddress | tostring) else "" end)
           + (if (.options.mtu // .mtu // null) != null then ",mtu=" + ((.options.mtu // .mtu) | tostring) else "" end))
        end
      end
  '
}

network_spec_name() {
  printf '%s\n' "${1%%,*}"
}

container_network_names() {
  local name="$1"
  local spec=""
  local specs=""

  specs="$(container_network_specs "$name")" || return 1
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    network_spec_name "$spec"
  done <<<"$specs"
}

network_specs_without_mac() {
  awk -F, '
    NF > 0 {
      output = $1
      for (i = 2; i <= NF; i++) {
        if ($i !~ /^mac=/) output = output "," $i
      }
      print output
    }
  '
}

network_args_to_text() {
  local name=""
  for name in "$@"; do printf '%s\n' "$name"; done
}

network_text_names() {
  local text="$1"
  printf '%s\n' "$text" | sed '/^$/d'
}

validate_existing_container_networks() {
  local container_name="$1"
  local requested_text="$2"
  local actual_text=""

  [ -n "$requested_text" ] || return 0
  actual_text="$(container_network_names "$container_name")" \
    || die "Unable to determine network attachments for existing container: $container_name"
  if [ "$actual_text" != "${requested_text%$'\n'}" ]; then
    die "Container already exists with different network attachments: $container_name (remove or upgrade it to change networks)"
  fi
}

network_create_cmd() {
  local internal=0
  local subnet=""
  local subnet_v6=""
  local name=""
  local label=""
  local key=""
  local -a labels=()
  local -a create_cmd=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --internal) internal=1; shift ;;
      --subnet) [ "$#" -ge 2 ] || die "Missing value for --subnet"; subnet="$2"; shift 2 ;;
      --subnet-v6) [ "$#" -ge 2 ] || die "Missing value for --subnet-v6"; subnet_v6="$2"; shift 2 ;;
      --label) [ "$#" -ge 2 ] || die "Missing value for --label"; labels+=("$2"); shift 2 ;;
      --help) usage_network; return 0 ;;
      --*) die "Unknown option for network create: $1" ;;
      *) [ -z "$name" ] || die "Unexpected network create argument: $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "Network name is required"
  validate_network_name_argument "$name"
  require_custom_network_support
  [ "$internal" -eq 0 ] || require_host_only_network_support
  network_exists "$name" && die "Container network already exists: $name"
  if [ "${#labels[@]}" -gt 0 ]; then
    for label in "${labels[@]}"; do
      case "$label" in
        *=*) key="${label%%=*}" ;;
        *) die "Invalid network label (expected KEY=VALUE): $label" ;;
      esac
      [ "$key" != "$AGENTCTL_NETWORK_LABEL" ] || die "The network ownership label is managed by agentctl: $AGENTCTL_NETWORK_LABEL"
    done
  fi
  create_cmd=("$CONTAINER_CMD" network create --label "$AGENTCTL_NETWORK_LABEL=true")
  [ "$internal" -eq 0 ] || create_cmd+=(--internal)
  [ -z "$subnet" ] || create_cmd+=(--subnet "$subnet")
  [ -z "$subnet_v6" ] || create_cmd+=(--subnet-v6 "$subnet_v6")
  if [ "${#labels[@]}" -gt 0 ]; then
    for label in "${labels[@]}"; do create_cmd+=(--label "$label"); done
  fi
  create_cmd+=("$name")
  "${create_cmd[@]}"
}

network_list_cmd() {
  local raw=0
  local json=""
  local rows=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --raw) raw=1; shift ;;
      --help) usage_network; return 0 ;;
      *) die "Unknown option for network list: $1" ;;
    esac
  done
  require_custom_network_support
  json="$(network_list_normalized_json)" || die "Unable to parse container network list"
  if [ "$raw" -eq 1 ]; then
    printf '%s\n' "$json" | jq -r '.[].name'
    return 0
  fi
  rows="$(printf '%s\t%s\t%s\t%s\t%s\n' NAME MODE IPV4 IPV6 MANAGED)"
  rows="${rows}"$'\n'"$(printf '%s\n' "$json" | jq -r '.[] | [.name, .mode, (.ipv4Subnet // ""), (.ipv6Subnet // ""), (if .managed then "yes" else "no" end)] | @tsv')"
  printf '%s\n' "$rows" | format_tsv_table
}

network_inspect_cmd() {
  [ "$#" -eq 1 ] || die "Usage: $CLI_NAME network inspect NAME"
  require_custom_network_support
  "$CONTAINER_CMD" network inspect "$1"
}

network_remove_cmd() {
  local name=""
  [ "$#" -gt 0 ] || die "At least one network name is required"
  require_custom_network_support
  for name in "$@"; do
    network_exists "$name" || die "Container network not found: $name"
    network_is_managed "$name" || die "Refusing to delete network not managed by agentctl: $name"
  done
  "$CONTAINER_CMD" network delete "$@"
}

network_cmd() {
  local subcommand="${1:-list}"
  [ "$#" -eq 0 ] || shift
  case "$subcommand" in
    list|ls) network_list_cmd "$@" ;;
    create) network_create_cmd "$@" ;;
    inspect) network_inspect_cmd "$@" ;;
    rm|delete) network_remove_cmd "$@" ;;
    --help|-h|help) usage_network ;;
    *) die "Unknown network command: $subcommand" ;;
  esac
}

container_network_host_address() {
  local network="$1"
  local inspect_json=""
  local gateway=""
  local subnet=""

  require_container
  inspect_json="$("$CONTAINER_CMD" network inspect "$network" 2>/dev/null)" \
    || die "Unable to inspect container network: $network"
  gateway="$(printf '%s' "$inspect_json" | jq -er '
    (if type == "array" then (.[0] // {}) elif type == "object" then . else {} end)
    | .status.ipv4Gateway // .status.gateway // empty
    | strings | select(length > 0)
  ' 2>/dev/null || true)"
  if [ -n "$gateway" ]; then
    printf '%s\n' "$gateway"
    return 0
  fi

  subnet="$(printf '%s' "$inspect_json" | jq -er '
    (if type == "array" then (.[0] // {}) elif type == "object" then . else {} end)
    | .status.ipv4Subnet // empty | strings | select(length > 0)
  ' 2>/dev/null || true)"
  printf '%s\n' "$subnet" | awk -F '[./]' '
    NF == 5 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ && $5 ~ /^[0-9]+$/ {
      for (i = 1; i <= 4; i++) if ($i < 0 || $i > 255) exit 1
      prefix = $5 + 0
      if (prefix < 0 || prefix > 32) exit 1
      address = ((($1 * 256) + $2) * 256 + $3) * 256 + $4
      host_size = 2 ^ (32 - prefix)
      network = int(address / host_size) * host_size
      candidate = network + 1
      if (candidate > 4294967295) exit 1
      o4 = candidate % 256; candidate = int(candidate / 256)
      o3 = candidate % 256; candidate = int(candidate / 256)
      o2 = candidate % 256; candidate = int(candidate / 256)
      o1 = candidate % 256
      printf "%d.%d.%d.%d\n", o1, o2, o3, o4
      found = 1
    }
    END { if (!found) exit 1 }
  ' || die "Container network has no usable IPv4 gateway: $network"
}

host_address_cmd() {
  local network="default"

  while [ $# -gt 0 ]; do
    case "$1" in
      --network)
        [ $# -ge 2 ] || die "Missing value for --network"
        network="$2"
        shift 2
        ;;
      --help) usage_host_address; return 0 ;;
      *) die "Unknown option for host-address: $1" ;;
    esac
  done

  container_network_host_address "$network"
}

configure_container_host_alias() {
  local name="$1"
  local network="${2:-}"
  local networks=""
  local host_address=""

  if [ -z "$network" ]; then
    networks="$(container_network_names "$name")" \
      || die "Unable to determine network attachment for host alias configuration: $name"
    [ -n "$networks" ] || die "Container has no network attachment for host alias configuration: $name"
    network="${networks%%$'\n'*}"
  fi
  host_address="$(container_network_host_address "$network")"
  "$CONTAINER_CMD" exec --user root "$name" sh -c '
    address="$1"
    hostname="$2"
    hosts_file="${3:-/etc/hosts}"
    temp_file="/tmp/agentctl-hosts.$$"
    awk -v target="$hostname" '\''
      {
        found = 0
        for (i = 2; i <= NF; i++) {
          if ($i == target) found = 1
        }
        if (!found) print
      }
    '\'' "$hosts_file" >"$temp_file" \
      && printf "%s\t%s\n" "$address" "$hostname" >>"$temp_file" \
      && cat "$temp_file" >"$hosts_file"
    status=$?
    rm -f "$temp_file"
    exit "$status"
  ' sh "$host_address" "$CONTAINER_HOST_NAME" \
    || die "Unable to configure $CONTAINER_HOST_NAME in container: $name"
}

doctor_ssh_status() {
  local name="$1"
  local relay=""
  local feature_info=""
  local client_installed=false
  local status=0

  relay="$(container_ssh_enabled "$name")" || {
    printf '%s\n' "unable to inspect SSH forwarding configuration"
    return 0
  }
  feature_info="$(run_agent_sh_in_container "$name" feature info ssh 2>/dev/null || true)"
  if [ -n "$feature_info" ] && printf '%s' "$feature_info" | jq -e '.installed == true' >/dev/null 2>&1; then
    client_installed=true
  fi

  if [ "$relay" = "true" ]; then
    if guest_ssh_socket_available "$name"; then
      printf '%s\n' "SSH agent relay is enabled and available"
    else
      printf '%s\n' "SSH agent relay is enabled but its guest socket is unavailable; restart from a shell with SSH_AUTH_SOCK set"
      status=1
    fi
    if [ "$client_installed" = "true" ]; then
      printf '%s\n' "SSH client feature is installed"
    else
      printf '%s\n' "SSH client feature is missing; run: ${CLI_NAME} feature install ssh --name $name"
      status=1
    fi
  elif [ "$client_installed" = "true" ]; then
    printf '%s\n' "SSH client feature is installed; agent forwarding is disabled (enable with: ${CLI_NAME} upgrade --name $name --ssh)"
  else
    printf '%s\n' "SSH agent forwarding and client feature are not configured"
  fi
  return "$status"
}

doctor_socket_status() {
  local name="$1"
  local mounts=""
  local source=""
  local destination=""
  local status=0
  local published=""
  local parent_error=""
  local host_path=""

  mounts="$("$CONTAINER_CMD" inspect "$name" 2>/dev/null | container_extra_mounts)" || {
    printf '%s\n' "unable to inspect socket mappings"
    return 0
  }
  while IFS=$'\t' read -r source destination; do
    [ -n "$source" ] && [ -n "$destination" ] || continue
    case "$destination" in /workdir|/home/coder|/var/host-services/ssh-auth.sock) continue ;; esac
    printf '%s\n' "configured: $source -> $destination"
    if [ -L "$source" ] || [ ! -S "$source" ]; then
      printf '%s\n' "host source unavailable or not a Unix socket: $source"
      status=1
    elif container_running "$name" && ! "$CONTAINER_CMD" exec "$name" sh -c '[ -S "$1" ]' sh "$destination" >/dev/null 2>&1; then
      printf '%s\n' "guest socket unavailable: $destination"
      status=1
    fi
  done <<<"$mounts"
  [ -n "$mounts" ] || printf '%s\n' "no host Unix-socket mappings configured"
  published="$(container_published_sockets "$name" 2>/dev/null)" || {
    printf '%s\n' "unable to inspect published socket mappings"
    return 1
  }
  while IFS=$'\t' read -r host_path destination; do
    [ -n "$host_path" ] && [ -n "$destination" ] || continue
    printf '%s\n' "published: $host_path -> $destination"
    if ! parent_error="$( ( validate_published_socket_parent "$host_path" ) 2>&1)"; then
      printf '%s\n' "unsafe published socket parent: ${parent_error#Error: }"
      status=1
    fi
    if container_running "$name"; then
      if [ -L "$host_path" ] || [ ! -S "$host_path" ]; then
        printf '%s\n' "published listener missing or not a Unix socket: $host_path"
        status=1
      fi
    elif host_path_exists "$host_path"; then
      printf '%s\n' "stopped container left a published host entry behind; not removing it: $host_path"
      status=1
    else
      printf '%s\n' "published listener absent while container is stopped: $host_path"
    fi
  done <<<"$published"
  [ -n "$published" ] || printf '%s\n' "no container-to-host published sockets configured"
  return "$status"
}

doctor_mcp_status() {
  local name="$1" registry metadata socket nonce response status=0 missing="" variable=""
  registry="$(mcp_registry_path "$name")"
  if [ ! -f "$registry" ]; then printf '%s\n' 'managed MCP bridge is disabled'; return 0; fi
  if [ -L "$registry" ] || [ "$(host_path_uid "$registry")" != "$(id -u)" ] || [ "$((8#$(host_path_mode "$registry") & 077))" -ne 0 ]; then
    printf '%s\n' "unsafe MCP registry ownership or permissions: $registry"; return 1
  fi
  printf '%s\n' "enabled on 127.0.0.1:$(jq -r '.port' "$registry"); definitions: $(jq -r '[.servers[].name]|join(", ")' "$registry")"
  while IFS= read -r variable; do [ -z "$variable" ] || [ "${!variable+x}" = x ] || missing="${missing}${missing:+, }${variable}"; done < <(jq -r '.servers[].env_vars[]' "$registry")
  [ -z "$missing" ] || { printf '%s\n' "missing inherited host variables: $missing"; status=1; }
  metadata="$(mcp_runtime_dir)/mcp-$(mcp_identity_hash "$name").process.json"
  if container_running "$name"; then
    if [ ! -f "$metadata" ]; then printf '%s\n' 'host relay metadata is missing'; status=1
    else
      socket="$(jq -r '.socket' "$metadata")"; nonce="$(jq -r '.nonce' "$metadata")"
      response="$(curl --silent --max-time 2 --unix-socket "$socket" http://localhost/.well-known/agentctl-mcp-health 2>/dev/null || true)"
      printf '%s' "$response" | jq -e --arg n "$nonce" '.ok and .nonce==$n' >/dev/null 2>&1 || { printf '%s\n' 'host relay identity/health check failed'; status=1; }
    fi
  elif [ -f "$metadata" ] || [ -S "$(mcp_socket_path "$name")" ]; then printf '%s\n' 'stale MCP relay metadata or socket while container is stopped'; status=1
  fi
  return "$status"
}

doctor_cmd() {
  local name=""
  local fix=0
  local host=0
  local was_running=0
  local started_for_doctor=0
  local permission_output=""
  local runtime_output=""
  local state_summary_output=""
  local ssh_output=""
  local socket_output=""
  local doctor_status=0
  local status=0
  local stopped_socket_problem=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --fix) fix=1; shift ;;
      --host) host=1; shift ;;
      --help) usage_doctor; return 0 ;;
      *) die "Unknown option for doctor: $1" ;;
    esac
  done

  if [ "$host" -eq 1 ]; then
    [ -z "$name" ] || die "--host cannot be combined with --name"
    [ "$fix" -eq 0 ] || die "--host cannot be combined with --fix"
    host_doctor
    return
  fi

  require_container
  if [ -z "$name" ]; then
    name="$(default_name "$DEFAULT_NAME_PREFIX")"
  fi
  if ! container_exists "$name"; then
    die "Container not found: $name"
  fi

  if socket_output="$(doctor_socket_status "$name")"; then
    echo "Doctor socket mappings in $name:" >&2
  else
    doctor_status=$?
    echo "Doctor found a socket-mapping problem in $name:" >&2
    status="$doctor_status"
    if ! container_running "$name"; then
      stopped_socket_problem=1
    fi
  fi
  [ -z "$socket_output" ] || printf '%s\n' "$socket_output" | sed 's/^/  - /' >&2
  local mcp_output=""
  if mcp_output="$(doctor_mcp_status "$name")"; then
    echo "Doctor managed MCP bridge in $name:" >&2
  else
    doctor_status=$?; status="$doctor_status"; echo "Doctor found a managed MCP bridge problem in $name:" >&2
  fi
  printf '%s\n' "$mcp_output" | sed 's/^/  - /' >&2
  if [ "$stopped_socket_problem" -eq 1 ]; then
    echo "Doctor will not start $name while a stopped-container published-socket problem exists." >&2
    return "$status"
  fi

  if container_running "$name"; then
    was_running=1
  else
    echo "Starting container for doctor: $name" >&2
    start_existing_container_safely "$name" >/dev/null
    started_for_doctor=1
    if ! ensure_started_container_is_running "$name" "doctor"; then
      echo "Doctor found a container startup problem in $name." >&2
      echo "The container must stay running for exec-based checks, repair, and live upgrade backup." >&2
      return 1
    fi
  fi

  if permission_output="$(doctor_state_permissions "$name" "$fix")"; then
    echo "Doctor found no user-state ownership/readability problems in $name" >&2
  else
    doctor_status=$?
    if [ "$doctor_status" -gt 1 ]; then
      echo "Doctor could not inspect user-state ownership/readability in $name:" >&2
      [ -n "$permission_output" ] && printf '%s\n' "$permission_output" | sed 's/^/  - /' >&2
      status="$doctor_status"
    elif [ "$fix" -eq 1 ]; then
      echo "Doctor repaired user-state ownership/readability problems in $name:" >&2
      printf '%s\n' "$permission_output" | sed 's/^/  - /' >&2
    else
      echo "Doctor found user-state ownership/readability problems in $name:" >&2
      printf '%s\n' "$permission_output" | sed 's/^/  - /' >&2
      echo "Re-run with: $CLI_NAME doctor --name $name --fix" >&2
      status=1
    fi
  fi

  if permission_output="$(doctor_state_backup_readable "$name")"; then
    echo "Doctor confirmed user state can be backed up from $name" >&2
  else
    echo "Doctor found a user-state backup readability problem in $name:" >&2
    printf '%s\n' "$permission_output" | sed 's/^/  - /' >&2
    status=1
  fi

  if runtime_output="$(doctor_runtime_health "$name" "$fix")"; then
    echo "Doctor found no runtime health problems in $name" >&2
  else
    doctor_status=$?
    if [ "$doctor_status" -gt 1 ]; then
      echo "Doctor could not inspect runtime health in $name:" >&2
      [ -n "$runtime_output" ] && printf '%s\n' "$runtime_output" | sed 's/^/  - /' >&2
      status="$doctor_status"
    elif [ "$fix" -eq 1 ]; then
      echo "Doctor repaired runtime health problems in $name:" >&2
      printf '%s\n' "$runtime_output" | sed 's/^/  - /' >&2
    else
      echo "Doctor found runtime health problems in $name:" >&2
      printf '%s\n' "$runtime_output" | sed 's/^/  - /' >&2
      echo "Re-run with: $CLI_NAME doctor --name $name --fix" >&2
      status=1
    fi
  fi

  state_summary_output="$(doctor_runtime_state_summary "$name" 2>/dev/null || true)"
  if [ -n "$state_summary_output" ]; then
    echo "Doctor runtime state summary in $name:" >&2
    printf '%s\n' "$state_summary_output" | sed 's/^/  - /' >&2
  fi

  if ssh_output="$(doctor_ssh_status "$name")"; then
    echo "Doctor SSH state in $name:" >&2
  else
    doctor_status=$?
    echo "Doctor found an SSH configuration problem in $name:" >&2
    status="$doctor_status"
  fi
  [ -z "$ssh_output" ] || printf '%s\n' "$ssh_output" | sed 's/^/  - /' >&2

  if [ "$started_for_doctor" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    echo "Stopping container: $name" >&2
    stop_existing_container_safely "$name" >/dev/null
  fi
  return "$status"
}

run_agent_sh_in_container() {
  local name="$1"
  shift
  local was_running=0
  local started_for_command=0
  local status=0

  if ! container_exists "$name"; then
    die "Container not found: $name"
  fi

  if container_running "$name"; then
    was_running=1
  else
    start_existing_container_safely "$name" >/dev/null
    started_for_command=1
  fi

  if "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" bash /usr/local/bin/agent.sh "$@"; then
    status=0
  else
    status=$?
  fi

  if [ "$started_for_command" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    stop_existing_container_safely "$name" >/dev/null
  fi

  return "$status"
}

run_agent_sh_in_container_env() {
  local name="$1"
  shift
  local was_running=0
  local started_for_command=0
  local status=0
  local -a env_args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --)
        shift
        break
        ;;
      *=*)
        env_args+=("$1")
        shift
        ;;
      *)
        break
        ;;
    esac
  done

  if ! container_exists "$name"; then
    die "Container not found: $name"
  fi

  if container_running "$name"; then
    was_running=1
  else
    start_existing_container_safely "$name" >/dev/null
    started_for_command=1
  fi

  if "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" env "${env_args[@]}" bash /usr/local/bin/agent.sh "$@"; then
    status=0
  else
    status=$?
  fi

  if [ "$started_for_command" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    stop_existing_container_safely "$name" >/dev/null
  fi

  return "$status"
}

run_agent_sh_in_container_root() {
  local name="$1"
