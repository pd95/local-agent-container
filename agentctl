manifest_installed_features_json() {
  local manifest="${1:-}"

  [ -n "$manifest" ] || manifest='{}'

  printf '%s' "$manifest" | jq -c '.installed_features // []' 2>/dev/null || printf '[]\n'
}

manifest_default_runtime() {
  local manifest="${1:-}"

  [ -n "$manifest" ] || manifest='{}'

  printf '%s' "$manifest" | jq -r '.default_runtime // ""' 2>/dev/null || printf '\n'
}

manifest_preferred_runtime() {
  local manifest="${1:-}"

  [ -n "$manifest" ] || manifest='{}'

  printf '%s' "$manifest" | jq -r '.preferred_runtime // ""' 2>/dev/null || printf '\n'
}

json_string_array_difference() {
  local left_json="${1:-[]}"
  local right_json="${2:-[]}"

  jq -cn \
    --arg left_json "$left_json" \
    --arg right_json "$right_json" \
    '
      (($left_json | fromjson? // [])) as $left
      | (($right_json | fromjson? // [])) as $right
      | ($right | map({key: ., value: true}) | from_entries) as $right_index
      | [($left // [])[] | select($right_index[.] != true)]
      | unique
      | sort
    '
}

json_string_array_intersection() {
  local left_json="${1:-[]}"
  local right_json="${2:-[]}"

  jq -cn \
    --arg left_json "$left_json" \
    --arg right_json "$right_json" \
    '
      (($left_json | fromjson? // [])) as $left
      | (($right_json | fromjson? // [])) as $right
      | ($right | map({key: ., value: true}) | from_entries) as $right_index
      | [($left // [])[] | select($right_index[.] == true)]
      | unique
      | sort
    '
}

baseline_manifest_json() {
  local manifest="${1:-}"
  local baseline_source="${2:-image}"
  local image_ref="${3:-}"

  [ -n "$manifest" ] || manifest='{}'

  printf '%s' "$manifest" | jq -c \
    --arg baseline_source "$baseline_source" \
    --arg image_ref "$image_ref" \
    '
      . + {
        schema_version: 2,
        baseline_source: $baseline_source,
        image_ref: $image_ref
      }
    '
}

container_system_manifest_json() {
  local name="$1"
  local was_running=0
  local started_for_manifest=0
  local manifest=""

  if container_running "$name"; then
    was_running=1
  else
    "$CONTAINER_CMD" start "$name" >/dev/null
    started_for_manifest=1
  fi

  if ! manifest="$("$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" bash /usr/local/bin/agent.sh system manifest)"; then
    if [ "$started_for_manifest" -eq 1 ] && [ "$was_running" -eq 0 ]; then
      "$CONTAINER_CMD" stop "$name" >/dev/null 2>&1 || true
    fi
    return 1
  fi
  manifest="$(augment_manifest_with_container_apk_repositories "$name" "$manifest")"

  if [ "$started_for_manifest" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    "$CONTAINER_CMD" stop "$name" >/dev/null
  fi

  printf '%s\n' "$manifest"
}

container_baseline_manifest_json() {
  local name="$1"
  local was_running=0
  local started_for_manifest=0
  local manifest=""

  if container_running "$name"; then
    was_running=1
  else
    "$CONTAINER_CMD" start "$name" >/dev/null
    started_for_manifest=1
  fi

  if ! "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" test -f "$SYSTEM_BASELINE_MANIFEST_FILE"; then
    if [ "$started_for_manifest" -eq 1 ] && [ "$was_running" -eq 0 ]; then
      "$CONTAINER_CMD" stop "$name" >/dev/null 2>&1 || true
    fi
    return 1
  fi
  if ! manifest="$("$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" cat "$SYSTEM_BASELINE_MANIFEST_FILE")"; then
    if [ "$started_for_manifest" -eq 1 ] && [ "$was_running" -eq 0 ]; then
      "$CONTAINER_CMD" stop "$name" >/dev/null 2>&1 || true
    fi
    return 1
  fi
  if [ "$started_for_manifest" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    "$CONTAINER_CMD" stop "$name" >/dev/null
  fi
  [ -n "$manifest" ] || return 1
  printf '%s\n' "$manifest"
}

temporary_system_manifest_container_name() {
  local role="${1:-image}"

  sanitize_container_name "${CLI_NAME}-system-manifest-${role}-$$-${RANDOM:-0}"
}

image_system_manifest_json() {
  local image="$1"
  local role="${2:-image}"
  local temp_name=""
  local created=0
  local started=0
  local manifest=""

  temp_name="$(temporary_system_manifest_container_name "$role")"
  cleanup_system_manifest_container() {
    if [ "$started" -eq 1 ]; then
      "$CONTAINER_CMD" stop "$temp_name" >/dev/null 2>&1 || true
    fi
    if [ "$created" -eq 1 ]; then
      "$CONTAINER_CMD" rm "$temp_name" >/dev/null 2>&1 || true
    fi
  }
  cleanup_system_manifest_container_on_signal() {
    cleanup_system_manifest_container
    trap - EXIT INT TERM HUP
    exit 130
  }

  trap cleanup_system_manifest_container EXIT
  trap cleanup_system_manifest_container_on_signal INT TERM HUP

  if ! "$CONTAINER_CMD" create -t --name "$temp_name" "$image" sh -c 'sleep infinity' >/dev/null; then
    trap - EXIT INT TERM HUP
    return 1
  fi
  created=1

  if ! "$CONTAINER_CMD" start "$temp_name" >/dev/null; then
    cleanup_system_manifest_container
    trap - EXIT INT TERM HUP
    return 1
  fi
  started=1

  if ! manifest="$("$CONTAINER_CMD" exec "$temp_name" "${SETPRIV_ARGS[@]}" bash /usr/local/bin/agent.sh system manifest)"; then
    cleanup_system_manifest_container
    trap - EXIT INT TERM HUP
    return 1
  fi
  manifest="$(augment_manifest_with_container_apk_repositories "$temp_name" "$manifest")"

  cleanup_system_manifest_container
  trap - EXIT INT TERM HUP

  printf '%s\n' "$manifest"
}

upgrade_source_manifest_json() {
  local name="$1"
  local current_image="$2"
  local target_image="$3"
  local target_manifest="${4:-}"
  local stored_manifest=""
  local source_manifest=""

  if stored_manifest="$(container_baseline_manifest_json "$name")"; then
    source_manifest="$stored_manifest"
  elif [ "$current_image" = "$target_image" ] && [ -n "$target_manifest" ]; then
    source_manifest="$target_manifest"
  elif image_exists "$current_image"; then
    if ! source_manifest="$(image_system_manifest_json "$current_image" source)"; then
      return 1
    fi
  else
    return 1
  fi

  [ -n "$source_manifest" ] || return 1
  printf '%s\n' "$source_manifest"
}

upgrade_added_runtimes_json() {
  local name="$1"
  local current_image="$2"
  local target_image="$3"
  local current_manifest="${4:-}"
  local source_manifest="${5:-}"
  local target_manifest="${6:-}"

  if [ -z "$current_manifest" ]; then
    current_manifest="$(container_system_manifest_json "$name")" || return 1
  fi
  if [ -z "$target_manifest" ]; then
    target_manifest="$(image_system_manifest_json "$target_image" target)" || return 1
  fi
  if [ -z "$source_manifest" ]; then
    source_manifest="$(upgrade_source_manifest_json "$name" "$current_image" "$target_image" "$target_manifest")" || return 1
  fi

  json_string_array_difference \
    "$(json_string_array_difference "$(manifest_installed_runtimes_json "$current_manifest")" "$(manifest_installed_runtimes_json "$source_manifest")")" \
    "$(manifest_installed_runtimes_json "$target_manifest")"
}

upgrade_added_features_json() {
  local name="$1"
  local current_image="$2"
  local target_image="$3"
  local current_manifest="${4:-}"
  local source_manifest="${5:-}"
  local target_manifest="${6:-}"

  if [ -z "$current_manifest" ]; then
    current_manifest="$(container_system_manifest_json "$name")" || return 1
  fi
  if [ -z "$target_manifest" ]; then
    target_manifest="$(image_system_manifest_json "$target_image" target)" || return 1
  fi
  if [ -z "$source_manifest" ]; then
    source_manifest="$(upgrade_source_manifest_json "$name" "$current_image" "$target_image" "$target_manifest")" || return 1
  fi

  json_string_array_difference \
    "$(json_string_array_difference "$(manifest_installed_features_json "$current_manifest")" "$(manifest_installed_features_json "$source_manifest")")" \
    "$(manifest_installed_features_json "$target_manifest")"
}

target_runtime_installable() {
  local name="$1"
  local runtime="$2"
  local runtime_info=""

  runtime_info="$(run_agent_sh_in_container "$name" runtime info "$runtime" 2>/dev/null)" || return 1
  printf '%s' "$runtime_info" | jq -e '(.capabilities.install // false) == true' >/dev/null 2>&1
}

target_feature_installable() {
  local name="$1"
  local feature="$2"
  local feature_info=""

  feature_info="$(run_agent_sh_in_container "$name" feature info "$feature" 2>/dev/null)" || return 1
  printf '%s' "$feature_info" | jq -e '(.capabilities.install // false) == true' >/dev/null 2>&1
}

container_preferred_runtime() {
  local name="$1"
  local manifest="${2:-}"

  if [ -z "$manifest" ]; then
    manifest="$(container_system_manifest_json "$name")" || return 1
  fi
  manifest_preferred_runtime "$manifest"
}

target_default_runtime_for_upgrade() {
  local target_image="$1"
  local target_manifest="${2:-}"

  if [ -z "$target_manifest" ]; then
    target_manifest="$(image_system_manifest_json "$target_image" target-preferred)" || return 1
  fi
  manifest_default_runtime "$target_manifest"
}

target_runtime_installed() {
  local name="$1"
  local runtime="$2"
  local runtime_info=""

  runtime_info="$(run_agent_sh_in_container "$name" runtime info "$runtime" 2>/dev/null)" || return 1
  printf '%s' "$runtime_info" | jq -e '.installed == true' >/dev/null 2>&1
}

clear_preferred_runtime_override_in_container() {
  local name="$1"

  "$CONTAINER_CMD" exec -u 0 "$name" sh -lc '
rm -f /home/coder/.config/agentctl/preferred-runtime
chown -R coder:coder /home/coder/.config/agentctl >/dev/null 2>&1 || true
'
}

warn_if_preferred_runtime_lost() {
  local name="$1"
  local preferred_runtime="$2"
  local target_default_runtime="${3:-}"

  [ -n "$preferred_runtime" ] || return 0
  if target_runtime_installed "$name" "$preferred_runtime"; then
    return 0
  fi

  clear_preferred_runtime_override_in_container "$name"
  if [ -n "$target_default_runtime" ] && [ "$target_default_runtime" != "$preferred_runtime" ]; then
    warn "Preferred runtime $preferred_runtime is not available after upgrade; cleared the user override so $name will use $target_default_runtime"
  else
    warn "Preferred runtime $preferred_runtime is not available after upgrade; cleared the user override so $name can fall back to its image default"
  fi
}

reinstall_added_runtimes_and_features() {
  local name="$1"
  local added_runtimes_json="${2:-[]}"
  local added_features_json="${3:-[]}"
  local runtime=""
  local feature=""

  while IFS= read -r runtime; do
    [ -n "$runtime" ] || continue
    if target_runtime_installable "$name" "$runtime"; then
      echo "Reinstalling added runtime in $name: $runtime" >&2
      install_runtime_in_container "$name" "$runtime" || die "Failed to reinstall runtime during upgrade: $runtime"
    else
      warn "Target image cannot automatically reinstall added runtime: $runtime"
    fi
  done < <(printf '%s' "$added_runtimes_json" | jq -r '.[]' 2>/dev/null || true)

  while IFS= read -r feature; do
    [ -n "$feature" ] || continue
    if target_feature_installable "$name" "$feature"; then
      echo "Reinstalling added feature in $name: $feature" >&2
      run_agent_sh_in_container_root "$name" feature install "$feature" || die "Failed to reinstall feature during upgrade: $feature"
    else
      warn "Target image cannot automatically reinstall added feature: $feature"
    fi
  done < <(printf '%s' "$added_features_json" | jq -r '.[]' 2>/dev/null || true)
}

persist_container_system_manifest_baseline() {
  local name="$1"
  local manifest="$2"
  local baseline_source="${3:-image}"
  local image_ref="${4:-}"
  local baseline_json=""

  baseline_json="$(baseline_manifest_json "$manifest" "$baseline_source" "$image_ref")" || die "Failed to build baseline manifest for $name"
  write_container_file_content "$name" "$SYSTEM_BASELINE_MANIFEST_FILE" "$baseline_json" "root:root" "644"
}

persist_container_system_manifest_baseline_from_image() {
  local name="$1"
  local image="$2"
  local manifest=""

  manifest="$(image_system_manifest_json "$image" baseline)" || die "Failed to inspect system manifest for image $image"
  persist_container_system_manifest_baseline "$name" "$manifest" "image" "$image"
}

persist_container_system_manifest_baseline_from_live_state() {
  local name="$1"
  local image_ref="${2:-}"
  local manifest=""

  manifest="$(container_system_manifest_json "$name")" || die "Failed to inspect live system manifest for $name"
  persist_container_system_manifest_baseline "$name" "$manifest" "live-state" "$image_ref"
}

warn_upgrade_package_loss() {
  local name="$1"
  local current_image="$2"
  local target_image="$3"
  local current_manifest="${4:-}"
  local source_manifest="${5:-}"
  local target_manifest="${6:-}"
  local target_name="${7:-$name}"
  local stored_manifest=""
  local current_package_manager=""
  local source_package_manager=""
  local target_package_manager=""
  local current_packages_json='[]'
  local source_packages_json='[]'
  local target_packages_json='[]'
  local current_requested_packages_json='[]'
  local source_requested_packages_json='[]'
  local target_requested_packages_json='[]'
  local current_apk_repositories_json='[]'
  local target_apk_repositories_json='[]'
  local added_packages_json='[]'
  local lost_packages_json='[]'
  local baseline_packages_in_current_json='[]'
  local baseline_requested_packages_in_current_json='[]'
  local removed_baseline_packages_json='[]'
  local removed_baseline_requested_packages_json='[]'
  local removed_baseline_package_count=0
  local removed_baseline_requested_package_count=0
  local added_requested_packages_json='[]'
  local reinstall_packages_json='[]'
  local reinstall_package_count=0
  local reinstall_package_manager=""
  local reinstall_command=""
  local reinstall_label="To reinstall after upgrade:"
  local requested_package_count=0
  local requested_package_data_available=0
  local missing_apk_repository_tags_json='[]'
  local missing_apk_repository_lines_json='[]'
  local missing_apk_repository_tag_count=0
  local missing_apk_repository_line_count=0
  local repository_line=""
  local quoted_repository_line=""
  local shell_repository_line=""
  local lost_count=""

  if [ -z "$current_manifest" ] && ! current_manifest="$(container_system_manifest_json "$name")"; then
    warn "Unable to inspect installed OS packages in $name before upgrade"
    return 0
  fi
  current_package_manager="$(manifest_package_manager "$current_manifest")"
  current_packages_json="$(manifest_packages_json "$current_manifest")"
  current_requested_packages_json="$(manifest_requested_packages_json "$current_manifest")"
  current_apk_repositories_json="$(manifest_apk_repositories_json "$current_manifest")"
  requested_package_count="$(printf '%s' "$current_requested_packages_json" | jq -r 'length' 2>/dev/null || printf '0\n')"
  if [ "$requested_package_count" -gt 0 ]; then
    requested_package_data_available=1
  fi
  if [ "$current_package_manager" = "unknown" ]; then
    warn "Unable to determine the package manager in $name before upgrade"
    return 0
  fi

  if [ -z "$target_manifest" ] && ! target_manifest="$(image_system_manifest_json "$target_image" target)"; then
    warn "Unable to inspect OS packages in target image $target_image before upgrade"
    return 0
  fi
  target_package_manager="$(manifest_package_manager "$target_manifest")"
  target_packages_json="$(manifest_packages_json "$target_manifest")"
  target_requested_packages_json="$(manifest_requested_packages_json "$target_manifest")"
  target_apk_repositories_json="$(manifest_apk_repositories_json "$target_manifest")"

  if [ -z "$source_manifest" ]; then
    if stored_manifest="$(container_baseline_manifest_json "$name")"; then
      source_manifest="$stored_manifest"
    elif [ "$current_image" = "$target_image" ]; then
      source_manifest="$target_manifest"
    elif image_exists "$current_image"; then
      if ! source_manifest="$(image_system_manifest_json "$current_image" source)"; then
        warn "Unable to inspect OS packages in current image $current_image; package warning may include image-provided packages"
        added_packages_json="$current_packages_json"
        added_requested_packages_json="$current_requested_packages_json"
      fi
    else
      warn "Current image $current_image is not available locally; package warning may include image-provided packages"
      added_packages_json="$current_packages_json"
      added_requested_packages_json="$current_requested_packages_json"
    fi
  fi

  if [ -n "$source_manifest" ]; then
    source_package_manager="$(manifest_package_manager "$source_manifest")"
    source_packages_json="$(manifest_packages_json "$source_manifest")"
    source_requested_packages_json="$(manifest_requested_packages_json "$source_manifest")"
    if [ "$source_package_manager" = "$current_package_manager" ]; then
      added_packages_json="$(json_string_array_difference "$current_packages_json" "$source_packages_json")"
      added_requested_packages_json="$(json_string_array_difference "$current_requested_packages_json" "$source_requested_packages_json")"
      if [ "$source_package_manager" = "$target_package_manager" ]; then
        baseline_packages_in_current_json="$(json_string_array_intersection "$source_packages_json" "$current_packages_json")"
        baseline_requested_packages_in_current_json="$(json_string_array_intersection "$source_requested_packages_json" "$current_requested_packages_json")"
        removed_baseline_packages_json="$(json_string_array_difference "$baseline_packages_in_current_json" "$target_packages_json")"
        removed_baseline_requested_packages_json="$(json_string_array_difference "$baseline_requested_packages_in_current_json" "$target_requested_packages_json")"
        removed_baseline_package_count="$(printf '%s' "$removed_baseline_packages_json" | jq -r 'length' 2>/dev/null || printf '0\n')"
        if [ "$removed_baseline_package_count" -gt 0 ]; then
          warn "Upgrade will also remove $removed_baseline_package_count image-provided $current_package_manager package(s) from $current_image that are no longer present in $target_image:"
          printf '%s' "$removed_baseline_packages_json" | jq -r '.[] | "  - " + .' >&2
          removed_baseline_requested_package_count="$(printf '%s' "$removed_baseline_requested_packages_json" | jq -r 'length' 2>/dev/null || printf '0\n')"
          if [ "$removed_baseline_requested_package_count" -gt 0 ]; then
            printf 'If you still need them, reinstall top-level packages after upgrade:\n' >&2
            if [ "$target_package_manager" = "dpkg" ]; then
              printf '  %s su-exec --name %s apt-get update\n' "$CLI_NAME" "$target_name" >&2
              printf '  %s su-exec --name %s apt-get install -y %s\n' \
                "$CLI_NAME" \
                "$target_name" \
                "$(printf '%s' "$removed_baseline_requested_packages_json" | jq -r 'join(" ")')" >&2
            elif [ "$target_package_manager" = "apk" ]; then
              printf '  %s su-exec --name %s apk add --no-cache %s\n' \
                "$CLI_NAME" \
                "$target_name" \
                "$(printf '%s' "$removed_baseline_requested_packages_json" | jq -r 'join(" ")')" >&2
            fi
          fi
        fi
      fi
    else
      warn "Current container package manager differs from its image baseline; package warning may include image-provided packages"
      added_packages_json="$current_packages_json"
      added_requested_packages_json="$current_requested_packages_json"
    fi
  fi

  if [ "$current_package_manager" = "$target_package_manager" ]; then
    lost_packages_json="$(json_string_array_difference "$added_packages_json" "$target_packages_json")"
    reinstall_packages_json="$(json_string_array_difference "$added_requested_packages_json" "$target_requested_packages_json")"
  else
    lost_packages_json="$added_packages_json"
    reinstall_packages_json="$added_requested_packages_json"
  fi

  lost_count="$(printf '%s' "$lost_packages_json" | jq -r 'length' 2>/dev/null || printf '0\n')"
  [ "$lost_count" -gt 0 ] || return 0

  if [ "$current_package_manager" = "$target_package_manager" ]; then
    warn "Upgrade will remove $lost_count extra $current_package_manager package(s) not present in $target_image:"
  else
    warn "Upgrade changes package manager from $current_package_manager to $target_package_manager; reinstall these extra $current_package_manager packages manually if still needed:"
  fi
  printf '%s' "$lost_packages_json" | jq -r '.[] | "  - " + .' >&2
  reinstall_package_count="$(printf '%s' "$reinstall_packages_json" | jq -r 'length' 2>/dev/null || printf '0\n')"
  if [ "$reinstall_package_count" -eq 0 ] && [ "$requested_package_data_available" -eq 0 ]; then
    reinstall_packages_json="$lost_packages_json"
    reinstall_package_count="$lost_count"
  fi
  if [ "$current_package_manager" = "$target_package_manager" ] && [ "$reinstall_package_count" -gt 0 ]; then
    case "$target_package_manager" in
      apk)
        reinstall_package_manager="apk"
        reinstall_command="apk add --no-cache"
        ;;
      dpkg)
        reinstall_package_manager="apt-get"
        reinstall_command="apt-get install -y"
        ;;
      *)
        reinstall_package_manager=""
        reinstall_command=""
        ;;
    esac
    if [ -n "$reinstall_command" ]; then
      if [ "$requested_package_data_available" -eq 1 ]; then
        reinstall_label="To reinstall top-level packages after upgrade:"
      fi
      printf '%s\n' "$reinstall_label" >&2
      if [ "$reinstall_package_manager" = "apk" ]; then
        missing_apk_repository_tags_json="$(
          json_string_array_difference \
            "$(apk_package_tags_json "$reinstall_packages_json")" \
            "$(apk_repository_tags_json "$target_apk_repositories_json")"
        )"
        missing_apk_repository_tag_count="$(printf '%s' "$missing_apk_repository_tags_json" | jq -r 'length' 2>/dev/null || printf '0\n')"
        if [ "$missing_apk_repository_tag_count" -gt 0 ]; then
          missing_apk_repository_lines_json="$(apk_repository_lines_for_tags_json "$current_apk_repositories_json" "$missing_apk_repository_tags_json")"
          missing_apk_repository_line_count="$(printf '%s' "$missing_apk_repository_lines_json" | jq -r 'length' 2>/dev/null || printf '0\n')"
          if [ "$missing_apk_repository_line_count" -eq 0 ]; then
            missing_apk_repository_lines_json="$(apk_default_repository_lines_for_tags_json "$missing_apk_repository_tags_json")"
            missing_apk_repository_line_count="$(printf '%s' "$missing_apk_repository_lines_json" | jq -r 'length' 2>/dev/null || printf '0\n')"
          fi
          if [ "$missing_apk_repository_line_count" -gt 0 ]; then
            printf 'Restore APK repository tag(s) before reinstalling tagged packages:\n' >&2
            while IFS= read -r repository_line; do
              [ -n "$repository_line" ] || continue
              quoted_repository_line="$(printf '%s' "$repository_line" | jq -Rr '@sh')"
              shell_repository_line="$(printf 'grep -Fxq %s /etc/apk/repositories || printf "%%s\\\\n" %s >> /etc/apk/repositories' "$quoted_repository_line" "$quoted_repository_line" | jq -Rr '@sh')"
              printf '  %s su-exec --name %s sh -lc %s\n' \
                "$CLI_NAME" \
                "$target_name" \
                "$shell_repository_line" >&2
            done < <(printf '%s' "$missing_apk_repository_lines_json" | jq -r '.[]' 2>/dev/null || true)
            printf '  %s su-exec --name %s apk update\n' "$CLI_NAME" "$target_name" >&2
          else
            warn "Tagged APK package reinstall needs missing repository tag(s), but the original repository URL was not available:"
            printf '%s' "$missing_apk_repository_tags_json" | jq -r '.[] | "  - @" + .' >&2
          fi
        fi
      fi
      if [ "$reinstall_package_manager" = "apt-get" ]; then
        printf '  %s su-exec --name %s apt-get update\n' "$CLI_NAME" "$target_name" >&2
      fi
      printf '  %s su-exec --name %s %s %s\n' \
        "$CLI_NAME" \
        "$target_name" \
        "$reinstall_command" \
        "$(printf '%s' "$reinstall_packages_json" | jq -r 'join(" ")')" >&2
    fi
  fi
}

print_upgrade_dry_run_summary() {
  local name="$1"
  local target_name="$2"
  local current_image="$3"
  local target_image="$4"
  local current_workdir="$5"
  local target_workdir="$6"
  local mount_mode="$7"
  local current_cpu="$8"
  local target_cpu="$9"
  local current_mem="${10}"
  local target_mem="${11}"
  local was_running="${12}"
  local backup_mode="${13}"
  local no_backup="${14}"
  local backup_image="${15}"
  local overwrite_config="${16}"
  local copy_mode="${17:-0}"
  local state_label=""
  local mount_label=""
  local config_label=""
  local backup_label=""
  local overwrite_label="no"
  local source_image_display=""
  local target_image_display=""
  local current_mem_display=""
  local target_mem_display=""

  if [ "$was_running" -eq 1 ]; then
    state_label="running"
  else
    state_label="stopped"
  fi

  if [ "$mount_mode" = "ro" ]; then
    mount_label="read-only"
  else
    mount_label="read-write"
  fi

  case "$backup_mode" in
    export)
      config_label="export existing container filesystem and recover user state from it"
      ;;
    start)
      config_label="start the stopped source container, back up user state, then stop it again"
      ;;
    running)
      config_label="back up user state from the running source container"
      ;;
    *)
      config_label="back up user state"
      ;;
  esac

  if [ "$copy_mode" -eq 1 ]; then
    backup_label="not needed (source preserved)"
  elif [ "$no_backup" -eq 1 ]; then
    backup_label="skipped (--no-backup)"
  else
    backup_label="$backup_image"
  fi

  if [ "$overwrite_config" -eq 1 ]; then
    overwrite_label="yes"
  fi

  source_image_display="$(display_upgrade_image_ref "$current_image")"
  target_image_display="$(display_upgrade_image_ref "$target_image")"
  current_mem_display="$(display_upgrade_memory_limit "$current_mem")"
  target_mem_display="$(display_upgrade_memory_limit "$target_mem")"

  echo "Dry run: upgrade plan for $name -> $target_name" >&2
  echo "  Source image: $source_image_display" >&2
  echo "  Target image: $target_image_display" >&2
  echo "  Source workdir: $current_workdir" >&2
  echo "  Target workdir: $target_workdir" >&2
  echo "  Mount mode: $mount_label" >&2
  echo "  CPU: ${current_cpu:-unlimited} -> ${target_cpu:-unlimited}" >&2
  echo "  Memory: $current_mem_display -> $target_mem_display" >&2
  echo "  Current state: $state_label" >&2
  echo "  Config backup: $config_label" >&2
  echo "  Backup image: $backup_label" >&2
  echo "  Overwrite config: $overwrite_label" >&2
  if [ "$copy_mode" -eq 1 ]; then
    echo "  Actions: keep $name and create $target_name as a copy" >&2
  elif [ "$name" = "$target_name" ]; then
    echo "  Actions: remove $name and recreate it in place" >&2
  else
    echo "  Actions: remove $name and recreate it as $target_name" >&2
  fi
  echo "Dry run complete: no container changes applied" >&2
}

display_upgrade_image_ref() {
  local image_ref="$1"

  if [ -z "$image_ref" ]; then
    printf 'unknown\n'
    return 0
  fi
  if [[ "$image_ref" == *:latest ]]; then
    printf '%s\n' "${image_ref%:latest}"
    return 0
  fi
  printf '%s\n' "$image_ref"
}

display_upgrade_memory_limit() {
  display_memory_limit "$1"
}

run_container() {
  local name="$1"
  local image="$2"
  local temp="$3"
  local shell="$4"
  local cpu="$5"
  local mem="$6"
  local read_only="$7"
  local workdir="$8"
  local home_mount="$9"
  local pre_exec="${10}"
  local post_exec="${11}"
  local reset_config="${12}"
  local stdio="${13}"
  shift 13
  local cmd=("$@")
  local exit_code=0
  local started=0
  local already_running=0
  local created=0
  local actual_name="$name"

  # Execute command inside the container and preserve the exit code.
  run_exec() {
    if [ "$stdio" -eq 1 ]; then
      if ! "$CONTAINER_CMD" exec --interactive "$actual_name" "${SETPRIV_ARGS[@]}" "${cmd[@]}"; then
        exit_code=$?
      fi
    elif [ "$shell" -eq 1 ]; then
      if ! "$CONTAINER_CMD" exec -it "$actual_name" "${SETPRIV_ARGS[@]}" "$DEFAULT_LOGIN_SHELL" "-l"; then
        exit_code=$?
      fi
    else
      if ! "$CONTAINER_CMD" exec -it "$actual_name" "${SETPRIV_ARGS[@]}" "${cmd[@]}"; then
        exit_code=$?
      fi
    fi
  }

  # Lifecycle: create if missing, start if needed, pre_exec, exec, stop, remove if temp.
  if [ -n "$actual_name" ] && container_exists "$actual_name"; then
    validate_mount_mode "$actual_name" "$read_only"
  fi
  if [ -n "$actual_name" ] && container_running "$actual_name"; then
    already_running=1
  else
    if [ -n "$actual_name" ] && [ "$temp" -eq 1 ] && container_exists "$actual_name"; then
      die "Container already exists: $actual_name (omit --temp or remove it)"
    fi
    if [ "$temp" -eq 0 ] && [ -z "$actual_name" ]; then
      die "Missing container name"
    fi

    if [ -z "$actual_name" ] || ! container_exists "$actual_name"; then
      echo "Creating container..." >&2
      local create_cmd=("$CONTAINER_CMD" create -t)
      if [ -n "$cpu" ]; then
        create_cmd+=(-c "$cpu")
      fi
      if [ -n "$mem" ]; then
        create_cmd+=(-m "$mem")
      fi
      if [ -n "$actual_name" ]; then
        create_cmd+=(--name "$actual_name")
      fi
      local mount_opts="type=bind,src=$workdir,dst=/workdir"
      if [ "$read_only" -eq 1 ]; then
        mount_opts="${mount_opts},readonly"
      fi
      create_cmd+=(--mount "$mount_opts")
      if [ -n "$home_mount" ]; then
        create_cmd+=(--mount "type=bind,src=$home_mount,dst=/home/coder")
      fi
      create_cmd+=("$image" sh -c 'sleep infinity')
      if [ -z "$actual_name" ]; then
        actual_name="$("${create_cmd[@]}")"
        [ -n "$actual_name" ] || die "Failed to create temporary container"
      else
        if [ "$stdio" -eq 1 ]; then
          "${create_cmd[@]}" >/dev/null
        else
          "${create_cmd[@]}"
        fi
      fi
      created=1
    fi

    echo "Starting container: $actual_name" >&2
    if [ "$stdio" -eq 1 ]; then
      "$CONTAINER_CMD" start "$actual_name" >/dev/null
    else
      "$CONTAINER_CMD" start "$actual_name"
    fi
    started=1
  fi

  if [ "$created" -eq 1 ]; then
    persist_container_system_manifest_baseline_from_image "$actual_name" "$image"
  fi

  configure_container_host_alias "$actual_name"

  if [ "$reset_config" -eq 1 ]; then
    local reset_runtime="${RUN_SELECTED_RUNTIME:-}"
    if [ -z "$reset_runtime" ]; then
      reset_runtime="$(run_agent_sh_in_container "$actual_name" preferred get 2>/dev/null || true)"
    fi
    reset_runtime="${reset_runtime:-codex}"
    reset_runtime_config_in_container "$actual_name" "$reset_runtime"
    if ! run_agent_sh_in_container "$actual_name" preferred set "$reset_runtime"; then
      warn "Failed to preserve preferred runtime after reset-config: $reset_runtime"
    fi
  fi
  if [ -n "$pre_exec" ]; then
    if [ "$stdio" -eq 1 ]; then
      "$pre_exec" "$actual_name" </dev/null
    else
      "$pre_exec" "$actual_name"
    fi
  fi
  run_exec
  if [ -n "$post_exec" ]; then
    if [ "$stdio" -eq 1 ]; then
      if ! "$post_exec" "$actual_name" </dev/null; then
        warn "post-run step failed for $actual_name"
      fi
    elif ! "$post_exec" "$actual_name"; then
      warn "post-run step failed for $actual_name"
    fi
  fi
  if [ "$already_running" -eq 1 ]; then
    return "$exit_code"
  fi
  if [ "$started" -eq 1 ]; then
    echo "Stopping container: $actual_name" >&2
    "$CONTAINER_CMD" stop "$actual_name" >/dev/null 2>&1
  fi
  if [ "$temp" -eq 1 ]; then
    echo "Removing container: $actual_name" >&2
    "$CONTAINER_CMD" rm "$actual_name" >/dev/null 2>&1
  fi
  return "$exit_code"
}

run_mode() {
  local name="$1"
  local image="$2"
  local temp="$3"
  local shell="$4"
  local online="$5"
  local auth="$6"
  local update="$7"
  local cpu="$8"
  local mem="$9"
  local read_only="${10}"
  local workdir="${11}"
  local home_mount="${12}"
  local reset_config="${13}"
  local runtime_config_json="${14}"
  local model_override="${15}"
  local stdio="${16}"
  shift 16
  local -a cmd_override=("$@")
  local pre_exec=""
  local post_exec=""
  local runtime_mode="local"
  local ollama_host="${OLLAMA_HOST:-}"
  local launch_env="AGENTCTL_RUN_MODE=\$1 AGENTCTL_RUNTIME_CONFIG_JSON=\$2 AGENTCTL_MODEL_OVERRIDE=\$3"
  local -a cmd_env=("AGENTCTL_RUN_MODE=$runtime_mode" "AGENTCTL_RUNTIME_CONFIG_JSON=$runtime_config_json" "AGENTCTL_MODEL_OVERRIDE=$model_override")
  local cmd=("$DEFAULT_LOGIN_SHELL" "-lc" "$launch_env exec bash /usr/local/bin/agent.sh run" sh "$runtime_mode" "$runtime_config_json" "$model_override")
  if [ -n "$ollama_host" ]; then
    launch_env="$launch_env OLLAMA_HOST=\$4"
    cmd_env+=("OLLAMA_HOST=$ollama_host")
    cmd=("$DEFAULT_LOGIN_SHELL" "-lc" "$launch_env exec bash /usr/local/bin/agent.sh run" sh "$runtime_mode" "$runtime_config_json" "$model_override" "$ollama_host")
  fi

  if [ "$online" -eq 1 ]; then
    runtime_mode="online"
    post_exec="run_post_exec"
    cmd_env=("AGENTCTL_RUN_MODE=$runtime_mode" "AGENTCTL_RUNTIME_CONFIG_JSON=$runtime_config_json" "AGENTCTL_MODEL_OVERRIDE=$model_override")
    launch_env="AGENTCTL_RUN_MODE=\$1 AGENTCTL_RUNTIME_CONFIG_JSON=\$2 AGENTCTL_MODEL_OVERRIDE=\$3"
    cmd=("$DEFAULT_LOGIN_SHELL" "-lc" "$launch_env exec bash /usr/local/bin/agent.sh run" sh "$runtime_mode" "$runtime_config_json" "$model_override")
    if [ -n "$ollama_host" ]; then
      launch_env="$launch_env OLLAMA_HOST=\$4"
      cmd_env+=("OLLAMA_HOST=$ollama_host")
      cmd=("$DEFAULT_LOGIN_SHELL" "-lc" "$launch_env exec bash /usr/local/bin/agent.sh run" sh "$runtime_mode" "$runtime_config_json" "$model_override" "$ollama_host")
    fi
  fi
  if [ "$RUN_UPDATE_CODEX" -eq 1 ] || [ -n "$RUN_SELECTED_RUNTIME" ] || [ "$RUN_SYNC_RUNTIME_AUTH" -eq 1 ]; then
    pre_exec="run_pre_exec"
  fi

  if [ "${#cmd_override[@]}" -gt 0 ]; then
    cmd=(env "${cmd_env[@]}" "${cmd_override[@]}")
    shell=0
  fi

  run_container "$name" "$image" "$temp" "$shell" "$cpu" "$mem" "$read_only" "$workdir" "$home_mount" "$pre_exec" "$post_exec" "$reset_config" "$stdio" "${cmd[@]}"
}

RUN_SELECTED_RUNTIME=""
RUN_INSTALL_RUNTIME=0
RUN_SYNC_RUNTIME_AUTH=0
RUN_SYNC_POST_RUNTIME_AUTH=0
RUN_FORCE_RUNTIME_AUTH=0
RUN_LOCAL_MODEL_PREFLIGHT=0
RUN_UPDATE_CODEX=0
RUN_EFFECTIVE_MODE="local"
RUN_REQUESTED_IMAGE=""
RUN_RUNTIME_CONFIG_JSON='{}'

run_post_exec() {
  local name="$1"
  local effective_runtime=""

  if [ "$RUN_SYNC_POST_RUNTIME_AUTH" -eq 0 ]; then
    return 0
  fi

  effective_runtime="$RUN_SELECTED_RUNTIME"
  if [ -z "$effective_runtime" ]; then
    effective_runtime="$(run_agent_sh_in_container "$name" preferred get 2>/dev/null || true)"
  fi
  [ -n "$effective_runtime" ] || return 0
  sync_runtime_auth_from_container_if_available "$name" "$effective_runtime"
}

run_pre_exec() {
  local name="$1"
  local effective_runtime=""
  local auth_image=""
  local runtime_info=""
  local auth_format=""
  local keychain_info=""
  local keychain_token=""
  local keychain_refresh=""

  if [ "$RUN_UPDATE_CODEX" -eq 1 ]; then
    update_codex_pre_exec "$name"
  fi

  if [ -n "$RUN_SELECTED_RUNTIME" ]; then
    if [ "$RUN_INSTALL_RUNTIME" -eq 1 ]; then
      install_runtime_in_container "$name" "$RUN_SELECTED_RUNTIME"
    fi
    run_agent_sh_in_container "$name" preferred set "$RUN_SELECTED_RUNTIME"
  fi

  if [ "$RUN_SYNC_RUNTIME_AUTH" -eq 1 ] || [ "$RUN_SYNC_POST_RUNTIME_AUTH" -eq 1 ]; then
    effective_runtime="$RUN_SELECTED_RUNTIME"
    if [ -z "$effective_runtime" ]; then
      effective_runtime="$(run_agent_sh_in_container "$name" preferred get 2>/dev/null || true)"
    fi
  fi

  if [ "$RUN_SYNC_RUNTIME_AUTH" -eq 1 ] && [ -n "$effective_runtime" ]; then
    runtime_info="$(runtime_info_in_container "$name" "$effective_runtime" 2>/dev/null || true)"
    if [ -n "$runtime_info" ] && printf '%s' "$runtime_info" | jq -e '.installed == true and (.capabilities.auth_login // false) and (.capabilities.auth_read // false) and (.capabilities.auth_write // false)' >/dev/null 2>&1; then
      auth_format="$(printf '%s' "$runtime_info" | jq -er '.auth_formats[0] // empty' 2>/dev/null || true)"
      if [ -n "$auth_format" ]; then
        keychain_info="$(keychain_auth_info "$effective_runtime" "$auth_format" 2>/dev/null || true)"
        IFS=$'\t' read -r keychain_token keychain_refresh <<<"$keychain_info"
        if [ "$RUN_FORCE_RUNTIME_AUTH" -eq 1 ] || [ -z "$keychain_token" ]; then
          auth_image="$(resolve_auth_image_for_container "$name" "$RUN_REQUESTED_IMAGE")"
          run_auth_flow "$auth_image" "$(default_name "$AUTH_NAME_PREFIX")" "$effective_runtime"
        fi
        sync_runtime_auth_to_container "$name" "$effective_runtime" "$auth_format" "Missing runtime auth in Keychain. Run: ${CLI_NAME} auth --runtime $effective_runtime"
      fi
    fi
  fi

}

update_codex_pre_exec() {
  local name="$1"
  local runtime_info=""
  local install_method=""

  runtime_info="$(run_agent_sh_in_container "$name" runtime info codex 2>/dev/null || true)"
  if [ -n "$runtime_info" ]; then
    install_method="$(printf '%s' "$runtime_info" | jq -r '.install_method // ""' 2>/dev/null || true)"
  fi
  if [ "$install_method" = "npm-global" ]; then
    warn "Using root Codex update for legacy npm-global install in $name. Rebuild or upgrade the container image to use user-owned standalone Codex updates."
    run_agent_sh_in_container_root "$name" runtime update codex
    return
  fi
  run_agent_sh_in_container "$name" runtime update codex
}

run_cmd() {
  local name=""
  local image=""
  local runtime=""
  local install_runtime=0
  local online=0
  local auth=0
  local update=0
  local temp=0
  local shell=0
  local reset_config=0
  local runtime_config_json='{}'
  local model_override=""
  local read_only=0
  local cpu=""
  local mem=""
  local home_mount=""
  local workdir=""
  local stdio=0
  local -a runtime_config_entries=()
  local -a cmd_override=()
  local cmd_override_set=0
  local shell_set=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --image) image="$2"; shift 2 ;;
      --workdir) workdir="$2"; shift 2 ;;
      --home) home_mount="$2"; shift 2 ;;
      --runtime) runtime="$2"; shift 2 ;;
      --install-runtime) install_runtime=1; shift ;;
      --model) model_override="$2"; shift 2 ;;
      --online) online=1; shift ;;
      --auth) auth=1; shift ;;
      --reset-config) reset_config=1; shift ;;
      --update) update=1; shift ;;
      --temp) temp=1; shift ;;
      --read-only) read_only=1; shift ;;
      --shell) shell=1; shell_set=1; shift ;;
      --stdio) stdio=1; shift ;;
      -c|--config) runtime_config_entries+=("$2"); shift 2 ;;
      --cmd) shift; cmd_override_set=1; cmd_override=("$@"); break ;;
      --cpu) cpu="$2"; shift 2 ;;
      --mem) mem="$2"; shift 2 ;;
      --help) usage_run; return 0 ;;
      *) die "Unknown option for run: $1" ;;
    esac
  done

  require_container
  if [ "$shell_set" -eq 1 ] && [ "$cmd_override_set" -eq 1 ]; then
    die "Cannot combine --shell with --cmd"
  fi
  if [ "$stdio" -eq 1 ] && [ "$cmd_override_set" -eq 0 ]; then
    die "--stdio requires --cmd"
  fi
  if [ "$stdio" -eq 1 ] && [ "$shell_set" -eq 1 ]; then
    die "Cannot combine --stdio with --shell"
  fi
  if [ "$cmd_override_set" -eq 1 ] && [ "${#cmd_override[@]}" -eq 0 ]; then
    die "Missing command after --cmd"
  fi
  if [ "$stdio" -eq 0 ] && [ "$cmd_override_set" -eq 1 ] && [ "${#cmd_override[@]}" -eq 1 ]; then
    case "${cmd_override[0]}" in
      *[[:space:]]*) cmd_override=("$DEFAULT_LOGIN_SHELL" "-lc" "${cmd_override[0]}") ;;
    esac
  fi
  if [ "$auth" -eq 1 ] && [ "$online" -eq 0 ]; then
    die "--auth requires --online"
  fi
  if [ "$install_runtime" -eq 1 ] && [ -z "$runtime" ]; then
    die "--install-runtime requires --runtime"
  fi

  if [ -z "$workdir" ]; then
    workdir="$PWD"
  fi
  if [ ! -d "$workdir" ]; then
    die "Workdir not found: $workdir"
  fi
  workdir="$(CDPATH= cd -- "$workdir" && pwd)"
  if [ -n "$home_mount" ]; then
    [ -d "$home_mount" ] || die "Home mount not found: $home_mount"
    home_mount="$(CDPATH= cd -- "$home_mount" && pwd)"
  fi

  [ -n "$image" ] || image="$DEFAULT_IMAGE"
  image="$(image_ref_for_runtime "$image")"
  warn_legacy_compat_image_usage "$image"
  if [ -z "$name" ] && [ "$temp" -eq 0 ]; then
    name="$(default_name "$DEFAULT_NAME_PREFIX" "$workdir")"
  fi
  if [ "$install_runtime" -eq 1 ] && [ "$runtime" = "claude" ] && [ -z "$mem" ] && { [ "$temp" -eq 1 ] || [ -z "$name" ] || ! container_exists "$name"; }; then
    mem="$CLAUDE_MIN_INSTALL_MEM"
  fi
  if [ "$temp" -eq 0 ] && [ -n "$name" ] && container_exists "$name" && { [ -n "$cpu" ] || [ -n "$mem" ]; }; then
    die "--cpu and --mem only apply when creating a new container. Use ${CLI_NAME} upgrade --name $name${image:+ --image $image}${cpu:+ --cpu $cpu}${mem:+ --mem $mem} to recreate the container with updated resources"
  fi
  if [ "$temp" -eq 0 ] && [ -n "$name" ] && container_exists "$name" && [ -n "$home_mount" ]; then
    die "--home only applies when creating a new container"
  fi
  if [ "${#runtime_config_entries[@]}" -gt 0 ]; then
    runtime_config_json="$(runtime_config_json_from_entries "${runtime_config_entries[@]}")"
  else
    runtime_config_json='{}'
  fi

  RUN_SELECTED_RUNTIME="$runtime"
  RUN_INSTALL_RUNTIME="$install_runtime"
  RUN_SYNC_RUNTIME_AUTH=0
  RUN_SYNC_POST_RUNTIME_AUTH=0
  RUN_FORCE_RUNTIME_AUTH=0
  RUN_LOCAL_MODEL_PREFLIGHT=0
  RUN_UPDATE_CODEX=0
  RUN_EFFECTIVE_MODE="local"
  RUN_REQUESTED_IMAGE="$image"
  RUN_RUNTIME_CONFIG_JSON="$runtime_config_json"
  if [ "$online" -eq 1 ]; then
    RUN_EFFECTIVE_MODE="online"
    RUN_SYNC_RUNTIME_AUTH=1
    RUN_SYNC_POST_RUNTIME_AUTH=1
    RUN_FORCE_RUNTIME_AUTH="$auth"
  fi
  if [ "$update" -eq 1 ]; then
    RUN_UPDATE_CODEX=1
  fi

  run_mode "$name" "$image" "$temp" "$shell" "$online" "$auth" "$update" "$cpu" "$mem" "$read_only" "$workdir" "$home_mount" "$reset_config" "$runtime_config_json" "$model_override" "$stdio" ${cmd_override[@]+"${cmd_override[@]}"}
}

auth_cmd() {
  local name=""
  local image="$DEFAULT_IMAGE"
  local runtime="$DEFAULT_RUNTIME"

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --image) image="$2"; shift 2 ;;
      --runtime) runtime="$2"; shift 2 ;;
      --help) usage_auth; return 0 ;;
      *) die "Unknown option for auth: $1" ;;
    esac
  done

  require_container
  if [ -z "$name" ]; then
    name="$(default_name "$AUTH_NAME_PREFIX")"
  fi
  image="$(image_ref_for_runtime "$image")"
  warn_legacy_compat_image_usage "$image"
  run_auth_flow "$image" "$name" "$runtime"
  if [ "$runtime" = "$DEFAULT_RUNTIME" ]; then
    echo "Auth updated. Restart any running --online $runtime containers to pick up the new token." >&2
  else
    echo "Auth updated for runtime: $runtime" >&2
  fi
}

upgrade_cmd() {
  local name=""
  local new_name=""
  local copy_mode=0
  local target_name=""
  local image=""
  local workdir_override=""
  local cpu=""
  local mem=""
  local backup_image=""
  local no_backup=0
  local dry_run=0
  local overwrite_config=0
  local current_image=""
  local current_workdir=""
  local workdir=""
  local mount_mode=""
  local current_cpu=""
  local current_mem=""
  local read_only=0
  local was_running=0
  local started_for_backup=0
  local used_export_for_config_backup=0
  local backup_mode=""
  local source_supports_state_contract=""
  local added_runtimes_json='[]'
  local added_features_json='[]'
  local current_preferred_runtime=""
  local target_default_runtime=""
  local preflight_current_manifest=""
  local preflight_source_manifest=""
  local preflight_target_manifest=""
  local inspect_info=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --new-name) new_name="$2"; shift 2 ;;
      --copy) copy_mode=1; shift ;;
      --image) image="$2"; shift 2 ;;
      --workdir) workdir_override="$2"; shift 2 ;;
      --cpu) cpu="$2"; shift 2 ;;
      --mem) mem="$2"; shift 2 ;;
      --backup-image) backup_image="$2"; shift 2 ;;
      --no-backup) no_backup=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      --overwrite-config) overwrite_config=1; shift ;;
      --help) usage_upgrade; return 0 ;;
      *) die "Unknown option for upgrade: $1" ;;
    esac
  done

  require_container

  if [ -z "$name" ]; then
    name="$(default_name "$DEFAULT_NAME_PREFIX")"
  fi
  if [ -n "$new_name" ]; then
    target_name="$new_name"
  else
    target_name="$name"
  fi
  if [ "$copy_mode" -eq 1 ] && [ -z "$new_name" ]; then
    die "Copy mode requires --new-name."
  fi
  if [ "$copy_mode" -eq 1 ] && [ "$target_name" = "$name" ]; then
    die "Copy mode requires a target name different from the source container."
  fi
  if [ "$no_backup" -eq 1 ] && [ -n "$backup_image" ]; then
    die "Cannot combine --no-backup with --backup-image"
  fi
  if [ "$copy_mode" -eq 1 ] && [ -n "$backup_image" ]; then
    die "Cannot combine --copy with --backup-image."
  fi
  if [ "$copy_mode" -eq 0 ] && [ "$no_backup" -eq 0 ]; then
    require_container_backup_support
  fi
  if ! container_exists "$name"; then
    die "Container not found: $name"
  fi
  if [ "$target_name" != "$name" ] && container_exists "$target_name"; then
    die "Target container name already exists: $target_name"
  fi

  inspect_info="$("$CONTAINER_CMD" inspect "$name" 2>/dev/null | container_upgrade_info)"
  IFS=$'\t' read -r current_image current_workdir mount_mode current_cpu current_mem <<<"$inspect_info"
  [ -n "$current_image" ] || die "Unable to determine image for $name"
  [ -n "$current_workdir" ] || die "Unable to determine /workdir mount source for $name"

  if [ "$mount_mode" = "ro" ]; then
    read_only=1
  elif [ "$mount_mode" != "rw" ]; then
    die "Unable to determine mount mode for $name"
  fi

  [ -n "$image" ] || image="$current_image"
  image="$(image_ref_for_runtime "$image")"
  warn_legacy_compat_image_usage "$image"
  if [ -n "$workdir_override" ]; then
    [ -d "$workdir_override" ] || die "Workdir not found: $workdir_override"
    workdir="$(CDPATH= cd -- "$workdir_override" && pwd)"
  else
    workdir="$current_workdir"
  fi
  [ -n "$cpu" ] || cpu="$current_cpu"
  [ -n "$mem" ] || mem="$current_mem"
  image_exists "$image" || die "Image not found: $image"
  if [ -z "$workdir_override" ]; then
    [ -e "$workdir" ] || die "Preserved /workdir source does not exist: $workdir"
    [ -d "$workdir" ] || die "Preserved /workdir source is not a directory: $workdir"
  fi
  if container_running "$name"; then
    was_running=1
  fi
  echo "Preparing upgrade preflight: $name -> $target_name" >&2
  if [ "$was_running" -eq 0 ] && [ -n "$workdir_override" ] && [ ! -e "$current_workdir" ]; then
    warn "Skipping package-loss warning because original /workdir source does not exist and $name is stopped"
    backup_mode="export"
  else
    collect_upgrade_container_preflight "$name" || true
    preflight_current_manifest="$UPGRADE_PREFLIGHT_CONTAINER_MANIFEST"
    preflight_source_manifest="$UPGRADE_PREFLIGHT_BASELINE_MANIFEST"
    source_supports_state_contract="$UPGRADE_PREFLIGHT_SOURCE_SUPPORTS_STATE_CONTRACT"
    preflight_target_manifest="$(image_system_manifest_json "$image" target 2>/dev/null || true)"
    if [ -z "$preflight_source_manifest" ]; then
      if [ "$current_image" = "$image" ] && [ -n "$preflight_target_manifest" ]; then
        preflight_source_manifest="$preflight_target_manifest"
      elif image_exists "$current_image"; then
        preflight_source_manifest="$(image_system_manifest_json "$current_image" source 2>/dev/null || true)"
      fi
    fi
    warn_upgrade_package_loss "$name" "$current_image" "$image" \
      "$preflight_current_manifest" "$preflight_source_manifest" "$preflight_target_manifest" "$target_name"
    added_runtimes_json="$(upgrade_added_runtimes_json "$name" "$current_image" "$image" \
      "$preflight_current_manifest" "$preflight_source_manifest" "$preflight_target_manifest" 2>/dev/null || printf '[]\n')"
    added_features_json="$(upgrade_added_features_json "$name" "$current_image" "$image" \
      "$preflight_current_manifest" "$preflight_source_manifest" "$preflight_target_manifest" 2>/dev/null || printf '[]\n')"
    current_preferred_runtime="$(container_preferred_runtime "$name" "$preflight_current_manifest" 2>/dev/null || true)"
    target_default_runtime="$(target_default_runtime_for_upgrade "$image" "$preflight_target_manifest" 2>/dev/null || true)"
    if [ "$was_running" -eq 0 ]; then
      backup_mode="start"
    else
      backup_mode="running"
    fi
  fi
  if [ "$copy_mode" -eq 0 ] && [ "$no_backup" -eq 1 ] && [ "${source_supports_state_contract:-}" = "0" ]; then
    die "Legacy source containers require a backup image for upgrade safety. Re-run without --no-backup."
  fi
  if [ "$copy_mode" -eq 0 ] && [ "$no_backup" -eq 0 ] && [ -z "$backup_image" ]; then
    backup_image="$(sanitize_image_name "${target_name}-backup-$(date -u +%Y%m%d%H%M%S)")"
  fi
  if [ "$dry_run" -eq 1 ]; then
    print_upgrade_dry_run_summary \
      "$name" "$target_name" "$current_image" "$image" "$current_workdir" "$workdir" \
      "$mount_mode" "$current_cpu" "$cpu" "$current_mem" "$mem" "$was_running" \
      "$backup_mode" "$no_backup" "$backup_image" "$overwrite_config" "$copy_mode"
    return 0
  fi

  local backup_dir
  local state_backup_file
  local export_file
  local backup_root
  local backup_dockerfile
  local export_config_root
  backup_dir="$(mktemp -d)"
  state_backup_file="$backup_dir/container-state.tar"
  export_file="$backup_dir/codex-export.tar"
  backup_root="$backup_dir/rootfs"
  backup_dockerfile="$backup_dir/Dockerfile.backup"
  export_config_root="$backup_dir/export-config"
  trap 'cleanup_temp_dir "$backup_dir"' RETURN

  if [ "$was_running" -eq 0 ] && [ -n "$workdir_override" ] && [ ! -e "$current_workdir" ]; then
    echo "Exporting container filesystem for state backup: $name" >&2
    export_container_for_upgrade "$name" "$export_file" 0
    extract_export_root "$export_file" "$export_config_root"
    if export_root_supports_state_contract "$export_config_root"; then
      source_supports_state_contract=1
    else
      source_supports_state_contract=0
    fi
    if [ "$copy_mode" -eq 0 ] && [ "$no_backup" -eq 1 ] && [ "$source_supports_state_contract" -eq 0 ]; then
      die "Legacy source containers require a backup image for upgrade safety. Re-run without --no-backup."
    fi
    backup_codex_config_from_export "$export_file" "$state_backup_file" "$export_config_root"
    used_export_for_config_backup=1
  elif [ "$was_running" -eq 0 ]; then
    echo "Starting container for state backup: $name" >&2
    "$CONTAINER_CMD" start "$name" >/dev/null
    started_for_backup=1
    if ! ensure_started_container_is_running "$name" "state backup"; then
      warn "Falling back to stopped filesystem export for state backup because $name exits during startup"
      export_container_for_upgrade "$name" "$export_file" 0
      extract_export_root "$export_file" "$export_config_root"
      if export_root_supports_state_contract "$export_config_root"; then
        source_supports_state_contract=1
      else
        source_supports_state_contract=0
      fi
      if [ "$copy_mode" -eq 0 ] && [ "$no_backup" -eq 1 ] && [ "$source_supports_state_contract" -eq 0 ]; then
        die "Legacy source containers require a backup image for upgrade safety. Re-run without --no-backup."
      fi
      backup_codex_config_from_export "$export_file" "$state_backup_file" "$export_config_root"
      used_export_for_config_backup=1
      started_for_backup=0
    fi
  fi

  local agents_state=""
  if [ "$used_export_for_config_backup" -eq 1 ]; then
    agents_state="$(codex_agents_state_from_export_root "$export_config_root")"
  else
    agents_state="$(codex_agents_state "$name")"
  fi
  case "$agents_state" in
    symlink|missing) ;;
    file)
      if [ "$overwrite_config" -eq 0 ]; then
        if [ "$started_for_backup" -eq 1 ]; then
          echo "Stopping container: $name" >&2
          "$CONTAINER_CMD" stop "$name" >/dev/null || true
        fi
        die "Container has ~/.codex/AGENTS.md as a regular file. Re-run with --overwrite-config to replace ~/.codex/config.toml, default ~/.codex/*.config.toml profiles, and ~/.codex/local_models.json and recreate ~/.codex/AGENTS.md as a symlink to /etc/codexctl/image.md. If no valid AGENTS.md configuration already exists, use ${CLI_NAME} run --name $name --reset-config"
      fi
      echo "Warning: replacing regular ~/.codex/AGENTS.md, ~/.codex/config.toml, default ~/.codex/*.config.toml profiles, and ~/.codex/local_models.json in $name due to --overwrite-config" >&2
      ;;
    other)
      if [ "$overwrite_config" -eq 0 ]; then
        if [ "$started_for_backup" -eq 1 ]; then
          echo "Stopping container: $name" >&2
          "$CONTAINER_CMD" stop "$name" >/dev/null || true
        fi
        die "Container has ~/.codex/AGENTS.md in a non-symlink form. Re-run with --overwrite-config to recreate it as a symlink to /etc/codexctl/image.md. If no valid AGENTS.md configuration already exists, use ${CLI_NAME} run --name $name --reset-config"
      fi
      echo "Warning: replacing non-standard ~/.codex/AGENTS.md in $name due to --overwrite-config" >&2
      ;;
  esac

  if [ "$used_export_for_config_backup" -eq 1 ]; then
    echo "Backing up user state from exported filesystem: $name" >&2
  else
    repair_state_permissions_for_upgrade "$name"
    echo "Backing up user state from $name" >&2
    backup_codex_config "$name" "$state_backup_file"
  fi

  if { [ "$copy_mode" -eq 0 ] && [ "$was_running" -eq 1 ]; } || [ "$started_for_backup" -eq 1 ]; then
    echo "Stopping container: $name" >&2
    "$CONTAINER_CMD" stop "$name" >/dev/null
  fi

  if [ "$copy_mode" -eq 0 ] && [ "$no_backup" -eq 0 ]; then
    if [ "$used_export_for_config_backup" -eq 0 ]; then
      echo "Exporting container state to image: $backup_image" >&2
      export_container_for_upgrade "$name" "$export_file" "$was_running"
    else
      echo "Reusing exported container state for backup image: $backup_image" >&2
    fi
    build_backup_image_from_export "$backup_image" "$name" "$export_file" "$backup_root" "$backup_dockerfile"
  elif [ "$copy_mode" -eq 0 ]; then
    echo "Skipping backup image export for $name" >&2
  fi

  if [ "$copy_mode" -eq 0 ]; then
    echo "Removing container: $name" >&2
    "$CONTAINER_CMD" rm "$name" >/dev/null
    echo "Recreating container: $target_name" >&2
  else
    echo "Creating copy: $target_name" >&2
  fi
  local create_cmd=("$CONTAINER_CMD" create -t)
  if [ -n "$cpu" ]; then
    create_cmd+=(-c "$cpu")
  fi
  if [ -n "$mem" ]; then
    create_cmd+=(-m "$mem")
  fi
  local mount_opts="type=bind,src=$workdir,dst=/workdir"
  if [ "$read_only" -eq 1 ]; then
    mount_opts="${mount_opts},readonly"
  fi
  create_cmd+=(
    --name "$target_name"
    --mount "$mount_opts"
    "$image" sh -c 'sleep infinity'
  )
  "${create_cmd[@]}"

  echo "Starting container: $target_name" >&2
  "$CONTAINER_CMD" start "$target_name" >/dev/null
  if [ -n "$preflight_target_manifest" ]; then
    persist_container_system_manifest_baseline "$target_name" "$preflight_target_manifest" "image" "$image"
  else
    persist_container_system_manifest_baseline_from_image "$target_name" "$image"
  fi

  reinstall_added_runtimes_and_features "$target_name" "$added_runtimes_json" "$added_features_json"

  echo "Restoring user state into $target_name" >&2
  restore_codex_config "$target_name" "$state_backup_file"
  verify_restored_runtime_state "$target_name" "$state_backup_file" \
    || die "Restored runtime state verification failed for $target_name; inspect the backup image before continuing."
  ensure_relevant_runtimes_and_features_after_restore \
    "$target_name" \
    "$target_default_runtime" \
    "$current_preferred_runtime" \
    "$added_runtimes_json" \
    "$added_features_json"
  warn_if_preferred_runtime_lost "$target_name" "$current_preferred_runtime" "$target_default_runtime"
  if [ "$overwrite_config" -eq 1 ]; then
    echo "Overwriting config.toml, default profiles, local_models.json in ~/.codex/ and recreating ~/.codex/AGENTS.md in $target_name" >&2
    reset_runtime_config_in_container "$target_name" codex
  fi

  if [ "$was_running" -eq 0 ]; then
    echo "Stopping container: $target_name" >&2
    "$CONTAINER_CMD" stop "$target_name" >/dev/null
  fi

  if [ "$copy_mode" -eq 1 ]; then
    echo "Copy complete: $target_name (source preserved)" >&2
  elif [ "$no_backup" -eq 0 ]; then
    echo "Upgrade complete: $target_name (backup image: $backup_image)" >&2
  else
    echo "Upgrade complete: $target_name (backup skipped)" >&2
  fi
  echo >&2
  echo "If no valid AGENTS.md configuration already exists, reset it with: ${CLI_NAME} run --name $target_name --reset-config" >&2
  if [ "$copy_mode" -eq 0 ] && [ "$no_backup" -eq 0 ]; then
    echo "If everything works as expected, remove the backup image with: ${CLI_NAME} images prune --backup --image $backup_image --keep 0" >&2
  fi
}

rescue_cmd() {
  local image=""
  local name=""
  local keep=0
  local cpu=""
  local mem=""
  local created=0
  local started=0
  local exit_code=0
  local -a cmd=()
  local cmd_override_set=0
  local -a create_cmd=()

  cleanup_rescue_container() {
    if [ "$keep" -eq 1 ]; then
      return 0
    fi
    if [ "$started" -eq 1 ]; then
      "$CONTAINER_CMD" stop "$name" >/dev/null 2>&1 || true
      started=0
    fi
    if [ "$created" -eq 1 ]; then
      "$CONTAINER_CMD" rm "$name" >/dev/null 2>&1 || true
      created=0
    fi
  }

  cleanup_rescue_container_on_signal() {
    cleanup_rescue_container
    trap - EXIT INT TERM HUP
    exit 130
  }

  while [ $# -gt 0 ]; do
    case "$1" in
      --image) image="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --keep) keep=1; shift ;;
      --cpu) cpu="$2"; shift 2 ;;
      --mem) mem="$2"; shift 2 ;;
      --cmd) shift; cmd_override_set=1; cmd=("$@"); break ;;
      --help) usage_rescue; return 0 ;;
      --*) die "Unknown option for rescue: $1" ;;
      *)
        if [ -z "$image" ]; then
          image="$1"
          shift
        else
          die "Unknown option for rescue: $1"
        fi
        ;;
    esac
  done

  require_container
  [ -n "$image" ] || die "--image is required for rescue"
  if [ "$cmd_override_set" -eq 1 ] && [ "${#cmd[@]}" -eq 0 ]; then
    die "Missing command after --cmd"
  fi
  if [ "${#cmd[@]}" -eq 0 ]; then
    cmd=("/bin/sh")
  fi
  if [ "${#cmd[@]}" -eq 1 ]; then
    case "${cmd[0]}" in
      *[[:space:]]*) cmd=("/bin/sh" "-lc" "${cmd[0]}") ;;
    esac
  fi
  if ! image_exists "$image"; then
    die "Image not found: $image"
  fi
  if [ -z "$name" ]; then
    name="$(sanitize_container_name "agent-rescue-${image%%:*}-$(date -u +%Y%m%d%H%M%S)")"
  fi
  if container_exists "$name"; then
    die "Container already exists: $name"
  fi

  trap cleanup_rescue_container EXIT
  trap cleanup_rescue_container_on_signal INT TERM HUP

  create_cmd=("$CONTAINER_CMD" create -t)
  if [ -n "$cpu" ]; then
    create_cmd+=(-c "$cpu")
  fi
  if [ -n "$mem" ]; then
    create_cmd+=(-m "$mem")
  fi
  create_cmd+=(--name "$name" "$image" /bin/sh -c 'sleep infinity')

  echo "Creating rescue container: $name" >&2
  "${create_cmd[@]}" >/dev/null
  created=1

  echo "Starting rescue container: $name" >&2
  "$CONTAINER_CMD" start "$name" >/dev/null
  started=1

  if [ "$cmd_override_set" -eq 1 ]; then
    "$CONTAINER_CMD" exec "$name" "${cmd[@]}" || exit_code=$?
  else
    "$CONTAINER_CMD" exec -it "$name" "${cmd[@]}" || exit_code=$?
  fi

  if [ "$keep" -eq 1 ]; then
    trap - EXIT INT TERM HUP
    echo "Rescue container kept: $name" >&2
    return "$exit_code"
  fi

  echo "Removing rescue container: $name" >&2
  cleanup_rescue_container
  trap - EXIT INT TERM HUP
  return "$exit_code"
}

exec_cmd() {
  local name=""
  local cmd=()
  local tty=1
  local stdio=0
  local saw_command_delimiter=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --no-tty) tty=0; shift ;;
      --stdio) stdio=1; tty=0; shift ;;
      --help) usage_exec; return 0 ;;
      --) saw_command_delimiter=1; shift; cmd=("$@"); break ;;
      --*) die "Unknown option for exec: $1" ;;
      *) cmd=("$@"); break ;;
    esac
  done

  require_container

  if [ -z "$name" ]; then
    name="$(default_name "$DEFAULT_NAME_PREFIX")"
  fi

  if [ "$stdio" -eq 1 ]; then
    [ "$saw_command_delimiter" -eq 1 ] || die "exec --stdio requires an explicit command after --"
    [ "${#cmd[@]}" -gt 0 ] || die "Missing command after --"
  elif [ "${#cmd[@]}" -eq 0 ]; then
    cmd=("$DEFAULT_LOGIN_SHELL" "-l")
  fi
  if [ "$stdio" -eq 0 ] && [ "${#cmd[@]}" -eq 1 ]; then
    case "${cmd[0]}" in
      *[[:space:]]*) cmd=("$DEFAULT_LOGIN_SHELL" "-lc" "${cmd[0]}") ;;
    esac
  fi

  if ! container_running "$name"; then
    die "Container not running: $name"
  fi

  configure_container_host_alias "$name"

  if [ "$stdio" -eq 1 ]; then
    "$CONTAINER_CMD" exec --interactive "$name" "${SETPRIV_ARGS[@]}" "${cmd[@]}"
  elif [ "$tty" -eq 1 ]; then
    "$CONTAINER_CMD" exec -it "$name" "${SETPRIV_ARGS[@]}" "${cmd[@]}"
  else
    "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" "${cmd[@]}"
  fi
}

su_exec_cmd() {
  local name=""
  local cmd=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --help) usage_su_exec; return 0 ;;
      --) shift; cmd=("$@"); break ;;
      --*) die "Unknown option for su-exec: $1" ;;
      *) cmd=("$@"); break ;;
    esac
  done

  require_container

  if [ -z "$name" ]; then
    name="$(default_name "$DEFAULT_NAME_PREFIX")"
  fi

  if [ "${#cmd[@]}" -eq 0 ]; then
    cmd=("$DEFAULT_LOGIN_SHELL" "-l")
  fi
  if [ "${#cmd[@]}" -eq 1 ]; then
    case "${cmd[0]}" in
      *[[:space:]]*) cmd=("$DEFAULT_LOGIN_SHELL" "-lc" "${cmd[0]}") ;;
    esac
  fi

  if ! container_running "$name"; then
    die "Container not running: $name"
  fi

  configure_container_host_alias "$name"

  "$CONTAINER_CMD" exec -u 0 -it "$name" "${cmd[@]}"
}

simple_name_cmd() {
  local action="$1"
  shift
  local name=""
  local force=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --force) force=1; shift ;;
      --help) usage_simple_name; return 0 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  require_container

  if [ -z "$name" ]; then
    name="$(default_name "$DEFAULT_NAME_PREFIX")"
  fi

  case "$action" in
    start)
      "$CONTAINER_CMD" start "$name"
      configure_container_host_alias "$name"
      ;;
    stop) "$CONTAINER_CMD" stop "$name" ;;
    restart)
      "$CONTAINER_CMD" restart "$name"
      configure_container_host_alias "$name"
      ;;
    rm)
      if [ "$force" -eq 1 ] && container_running "$name"; then
        "$CONTAINER_CMD" stop "$name" >/dev/null
      fi
      "$CONTAINER_CMD" rm "$name"
      ;;
    *) die "Unknown action: $action" ;;
  esac
}

ls_cmd() {
  local raw=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --details) shift ;;
      --raw) raw=1; shift ;;
      --help)
        cat <<EOF
Usage: $CLI_NAME ls [--details|--raw]

Options:
  --details  Show managed containers with image digest and matching timestamp snapshot (default)
  --raw      Show the legacy filtered container list
EOF
        return 0
        ;;
      *) die "Unknown option for ls: $1" ;;
    esac
  done

  require_container
  if [ "$raw" -eq 1 ]; then
    ls_raw_cmd
    return 0
  fi
  ls_details_cmd
}

ls_raw_cmd() {
  container_list_all | awk '
    NR == 1 { print; next }
    {
      image = $2
      sub(/^.*\//, "", image)
      sub(/[:@].*$/, "", image)
      if (image ~ /^(agent|codex)([[:alnum:]_.-]*|$)/) {
        print
      }
    }
  '
}

managed_container_names() {
  local name=""
  local image=""
  local family=""

  while IFS= read -r name; do
    [ -n "$name" ] || continue
    image="$(container_image_name "$name")"
    family="${image##*/}"
    family="${family%%:*}"
    family="${family%%@*}"
    case "$family" in
      agent*|codex*) printf '%s\n' "$name" ;;
      "")
        case "$name" in
          agent*|codex*) printf '%s\n' "$name" ;;
        esac
        ;;
    esac
  done < <(container_list_all_ids)
}

ls_details_row() {
  local name="$1"
  local images_json_file="$2"
  local inspect_json="${3:-}"
  local script

  script="$(cat <<'PY'
import json
import re
import sys

name = sys.argv[1]
images_json_file = sys.argv[2]
inspect_raw = sys.stdin.read()

def normalize_ref(ref):
    if not isinstance(ref, str):
        return ""
    return re.sub(r"^docker\.io/library/", "", ref)

def family_for_ref(ref):
    ref = normalize_ref(ref)
    if ":" in ref:
        return ref.rsplit(":", 1)[0]
    return ref

def value_or_unknown(value):
    if value is None or value == "":
        return "unknown"
    return str(value)

def resource_value(value):
    if value in (None, "", 0, "0"):
        return "unlimited"
    if isinstance(value, (int, float)):
        if int(value) <= 0:
            return "unlimited"
        return str(int(value))
    return str(value)

def memory_value(value):
    if value in (None, "", 0, "0"):
        return "unlimited"
    try:
        size = int(value)
    except Exception:
        return str(value)
    if size <= 0:
        return "unlimited"
    units = [("T", 1024 ** 4), ("G", 1024 ** 3), ("M", 1024 ** 2), ("K", 1024)]
    for suffix, factor in units:
        if size % factor == 0 and size >= factor:
            return f"{size // factor}{suffix}"
    return str(size)

def first_json_object(raw):
    data = json.loads(raw)
    if isinstance(data, list):
        if data:
            return data[0]
        return {}
    if isinstance(data, dict):
        return data
    return {}

try:
    with open(images_json_file, "r", encoding="utf-8") as handle:
        images = json.load(handle)
        if not isinstance(images, list):
            images = []
except Exception:
    images = []

try:
    data = first_json_object(inspect_raw)
except Exception:
    data = {}

if isinstance(data, dict):
    config = data.get("configuration") or data
else:
    config = {}
image = config.get("image") or {}
descriptor = image.get("descriptor") or {}
annotations = descriptor.get("annotations") or {}
resources = config.get("resources") or {}
mounts = config.get("mounts") or []

ref = normalize_ref(image.get("reference") or "")
digest = descriptor.get("digest") or ""
created = annotations.get("org.opencontainers.image.created") or ""
status = data.get("status") or "unknown"
if isinstance(status, dict):
    status = status.get("state") or "unknown"
workdir = "unknown"
mount_mode = "unknown"
for mount in mounts:
    if mount.get("destination") != "/workdir":
        continue
    workdir = mount.get("source") or "unknown"
    options = mount.get("options") or []
    if isinstance(options, str):
        options = [options]
    mount_mode = "ro" if "ro" in options else "rw"
    break

matching_refs = []
timestamp_refs = []
current_family = family_for_ref(ref)
for entry in images:
    if not isinstance(entry, dict):
        continue
    entry_config = entry.get("configuration") or {}
    entry_descriptor = entry.get("descriptor") or entry_config.get("descriptor") or {}
    entry_digest = entry_descriptor.get("digest") or ""
    if entry_digest != digest:
        continue
    entry_ref = normalize_ref(
        entry.get("reference")
        or entry_config.get("name")
        or entry_config.get("reference")
        or ""
    )
    if not entry_ref:
        continue
    matching_refs.append(entry_ref)
    if re.search(r":[0-9]{8}-[0-9]{6}$", entry_ref):
        timestamp_refs.append(entry_ref)

same_family_timestamps = [candidate for candidate in timestamp_refs if family_for_ref(candidate) == current_family]
snapshot = "unknown"
if same_family_timestamps:
    snapshot = sorted(same_family_timestamps)[-1]
elif timestamp_refs:
    snapshot = sorted(timestamp_refs)[-1]

digest_display = digest
if digest_display.startswith("sha256:") and len(digest_display) > len("sha256:") + 12:
    digest_display = digest_display[:len("sha256:") + 12]

row = [
    name,
    value_or_unknown(status),
    value_or_unknown(ref),
    value_or_unknown(snapshot),
    value_or_unknown(digest_display),
    value_or_unknown(workdir),
    value_or_unknown(mount_mode),
    resource_value(resources.get("cpus")),
    memory_value(resources.get("memoryInBytes")),
    value_or_unknown(created),
]
print("\t".join(row))
PY
)"

  python_exec "$script" "$name" "$images_json_file" <<<"$inspect_json"
}

format_tsv_table() {
  local script

  script="$(cat <<'PY'
import sys

rows = [line.rstrip("\n").split("\t") for line in sys.stdin if line.rstrip("\n")]
if not rows:
    sys.exit(0)

widths = [0] * max(len(row) for row in rows)
for row in rows:
    for index, cell in enumerate(row):
        widths[index] = max(widths[index], len(cell))

for row in rows:
    padded = []
    for index, cell in enumerate(row):
        if index == len(row) - 1:
            padded.append(cell)
        else:
            padded.append(cell.ljust(widths[index]))
    print("  ".join(padded).rstrip())
PY
)"
  python_exec "$script"
}

ls_details_cmd() {
  local images_json
  local images_json_file
  local name
  local inspect_json
  local rows

  if ! python_available; then
    warn "Python is required for detailed ls output; falling back to --raw"
    ls_raw_cmd
    return 0
  fi

  images_json="$(image_list_json)"
  images_json_file="$(mktemp "${TMPDIR:-/tmp}/agentctl-images.XXXXXX")"
  printf '%s\n' "$images_json" >"$images_json_file"
  rows="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "NAME" "STATE" "IMAGE" "SNAPSHOT" "DIGEST" "WORKDIR" "MOUNT" "CPU" "MEMORY" "CREATED")"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    inspect_json="$("$CONTAINER_CMD" inspect "$name" 2>/dev/null || true)"
    rows="${rows}"$'\n'"$(ls_details_row "$name" "$images_json_file" "$inspect_json")"
  done < <(managed_container_names)
  printf '%s\n' "$rows" | format_tsv_table
  rm -f "$images_json_file"
}

