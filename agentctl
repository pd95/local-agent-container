doctor_runtime_health() {
  local name="$1"
  local fix="${2:-0}"
  local runtime_list=""
  local preferred_runtime=""
  local runtime=""
  local runtime_info=""
  local command=""
  local installed=""
  local installable=""
  local issue_count=0
  local codex_seen=0
  local agents_state=""

  runtime_list="$(run_agent_sh_in_container "$name" runtime list 2>/dev/null)" || {
    printf '%s\n' 'agent.sh runtime list failed'
    return 2
  }
  preferred_runtime="$(run_agent_sh_in_container "$name" preferred get 2>/dev/null || true)"

  if [ -n "$preferred_runtime" ]; then
    runtime_info="$(run_agent_sh_in_container "$name" runtime info "$preferred_runtime" 2>/dev/null || true)"
    installed="$(printf '%s' "$runtime_info" | jq -r '.installed // false' 2>/dev/null || printf 'false')"
    installable="$(printf '%s' "$runtime_info" | jq -r '.capabilities.install // false' 2>/dev/null || printf 'false')"
    if [ "$installed" != "true" ]; then
      printf 'preferred runtime not installed: %s\n' "$preferred_runtime"
      issue_count=$((issue_count + 1))
      if [ "$fix" -eq 1 ] && [ "$installable" = "true" ]; then
        install_runtime_in_container "$name" "$preferred_runtime" 1 || return 2
      fi
    fi
  fi

  while IFS= read -r runtime; do
    [ -n "$runtime" ] || continue
    [ "$runtime" = "codex" ] && codex_seen=1
    runtime_info="$(run_agent_sh_in_container "$name" runtime info "$runtime" 2>/dev/null || true)"
    command="$(printf '%s' "$runtime_info" | jq -r '.command // empty' 2>/dev/null || true)"
    [ -n "$command" ] || command="$runtime"
    if ! doctor_runtime_command_available "$name" "$command"; then
      printf 'runtime command unavailable: %s (%s)\n' "$runtime" "$command"
      issue_count=$((issue_count + 1))
      installable="$(printf '%s' "$runtime_info" | jq -r '.capabilities.install // false' 2>/dev/null || printf 'false')"
      if [ "$fix" -eq 1 ] && [ "$installable" = "true" ]; then
        install_runtime_in_container "$name" "$runtime" 1 || return 2
      fi
    fi
  done <<EOF
$runtime_list
EOF

  if [ "$preferred_runtime" = "codex" ]; then
    codex_seen=1
  fi
  if [ "$codex_seen" -eq 1 ] && ! doctor_codex_config_has_myollama "$name"; then
    printf '%s\n' 'codex config missing model provider: myollama'
    issue_count=$((issue_count + 1))
    if [ "$fix" -eq 1 ]; then
      reset_runtime_config_in_container "$name" codex || return 2
    fi
  fi
  if [ "$codex_seen" -eq 1 ]; then
    agents_state="$(codex_agents_state "$name")"
    case "$agents_state" in
      symlink)
        ;;
      missing)
        printf '%s\n' 'codex AGENTS.md missing'
        issue_count=$((issue_count + 1))
        if [ "$fix" -eq 1 ]; then
          doctor_fix_missing_codex_agents "$name" || return 2
        fi
        ;;
      file)
        printf '%s\n' 'codex AGENTS.md is a regular file; leaving custom project instructions untouched'
        issue_count=$((issue_count + 1))
        ;;
      *)
        printf 'codex AGENTS.md is not a symlink: %s\n' "$agents_state"
        issue_count=$((issue_count + 1))
        ;;
    esac
  fi

  [ "$issue_count" -eq 0 ] && return 0
  return 1
}

