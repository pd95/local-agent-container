#!/usr/bin/env bash
set -euo pipefail

CONTAINER_CMD="${CONTAINER_CMD:-container}"
DEFAULT_IMAGE="agent-plain"
DEFAULT_RUNTIME="${AGENTCTL_DEFAULT_RUNTIME:-codex}"
DEFAULT_NAME_PREFIX="agent-"
AUTH_NAME_PREFIX="agent-auth-"
DEFAULT_LOGIN_SHELL="${AGENTCTL_SHELL:-bash}"
CONTAINER_HOST_NAME="host.container.internal"
AGENTCTL_NETWORK_LABEL="agentctl.managed"
CLAUDE_MIN_INSTALL_MEM="4G"
SYSTEM_BASELINE_MANIFEST_FILE="/etc/agentctl/system-manifest.json"
SETPRIV_ARGS=(setpriv --inh-caps=-all --ambient-caps=-all --no-new-privs --)
CONTAINER_COPY_SUPPORT=""
SOCKET_MOUNTS_TEXT=""
PUBLISHED_SOCKETS_TEXT=""
SOCKET_PATH_MAX_BYTES=103
MCP_DEFAULT_PORT=47123
MCP_GUEST_SOCKET="/run/agentctl/mcp-host.sock"
MCP_CONFIG_JSON='[]'
MCP_REQUESTED=0
MCP_PORT="$MCP_DEFAULT_PORT"
MCP_RELAY_PID=""
MCP_RELAY_SOCKET=""
MCP_RELAY_NONCE=""
MCP_RELAY_METADATA=""
MCP_GUEST_EXEC_PID=""
MCP_LEASE_FILE=""
MCP_LOCK_DIR=""
MCP_LOCK_TOKEN=""

resolve_script_path() {
  local path="$1"
  while [ -L "$path" ]; do
    local target
    target="$(readlink "$path")"
    if [[ "$target" != /* ]]; then
      path="$(CDPATH= cd -- "$(dirname -- "$path")" && pwd)/$target"
    else
      path="$target"
    fi
  done
  echo "$path"
}

SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
CLI_NAME="${AGENTCTL_NAME:-$(basename -- "$SCRIPT_PATH")}"
KEYCHAIN_SCRIPT="$SCRIPT_DIR/agentctl-keychain.sh"
DEFAULTS_DIR="$SCRIPT_DIR/defaults"
LOCAL_DEFAULTS_DIR="$SCRIPT_DIR/defaults.local"

die() {
  echo "Error: $*" >&2
  exit 1
}

warn() {
  echo "Warning: $*" >&2
}

require_container() {
  require_jq
  command -v "$CONTAINER_CMD" >/dev/null 2>&1 || die "Missing '$CONTAINER_CMD' command"
}

JQ_MIN_VERSION="1.6"

jq_version() {
  jq --version 2>/dev/null | sed 's/^jq-//'
}

jq_version_supported() {
  local version="${1%%-*}"
  local major="${version%%.*}"
  local minor="${version#*.}"

  minor="${minor%%.*}"
  case "$major.$minor" in
    *[!0-9.]*|.*|*.) return 1 ;;
  esac
  [ "$major" -gt 1 ] || { [ "$major" -eq 1 ] && [ "$minor" -ge 6 ]; }
}

require_jq() {
  local version=""

  command -v jq >/dev/null 2>&1 || die "Missing 'jq' command (jq $JQ_MIN_VERSION or newer is required)"
  version="$(jq_version)"
  jq_version_supported "$version" \
    || die "Unsupported jq version: ${version:-unknown} (jq $JQ_MIN_VERSION or newer is required)"
}

require_container_backup_support() {
  if ! "$CONTAINER_CMD" export --help 2>/dev/null | grep -Fq -- '--output'; then
    die "Upgrade backups require a container runtime with 'container export --output <path>' support"
  fi
}

require_container_shm_size_support() {
  if ! container_help_contains --shm-size create; then
    die "Shared-memory sizing requires an Apple container runtime with 'container create --shm-size <size>' support"
  fi
}

require_container_ssh_support() {
  container_help_contains --ssh create || die "Apple container does not support SSH agent forwarding (--ssh); upgrade the container CLI"
}

host_ssh_socket_available() {
  [ -n "${SSH_AUTH_SOCK:-}" ] && [ "${SSH_AUTH_SOCK#/}" != "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ]
}

require_host_ssh_socket() {
  [ -n "${SSH_AUTH_SOCK:-}" ] || die "--ssh requires SSH_AUTH_SOCK to be set on the host"
  [ "${SSH_AUTH_SOCK#/}" != "$SSH_AUTH_SOCK" ] || die "--ssh requires an absolute SSH_AUTH_SOCK path: $SSH_AUTH_SOCK"
  [ -S "$SSH_AUTH_SOCK" ] || die "--ssh requires SSH_AUTH_SOCK to reference an existing Unix socket: $SSH_AUTH_SOCK"
}

container_list_all() {
  "$CONTAINER_CMD" ls -a 2>/dev/null || true
}

container_list_running() {
  "$CONTAINER_CMD" ls 2>/dev/null || true
}

container_list_all_ids() {
  if "$CONTAINER_CMD" ls -a --quiet 2>/dev/null; then
    return 0
  fi
  container_list_all | awk 'NR > 1 && NF > 0 { print $1 }'
}

container_list_running_ids() {
  if "$CONTAINER_CMD" ls --quiet 2>/dev/null; then
    return 0
  fi
  container_list_running | awk 'NR > 1 && NF > 0 { print $1 }'
}

container_exists() {
  container_list_all_ids | grep -Fqx -- "$1"
}

container_running() {
  container_list_running_ids | grep -Fqx -- "$1"
}

stop_buildkit_container() {
  if container_exists buildkit; then
    "$CONTAINER_CMD" stop buildkit >/dev/null 2>&1 || true
  fi
}

cleanup_temp_dir() {
  local path="$1"

  [ -n "$path" ] || return 0
  [ -e "$path" ] || return 0

  # Exported container files can preserve restrictive modes that prevent
  # best-effort host cleanup on exit.
  chmod -R u+rwX "$path" >/dev/null 2>&1 || true
  rm -rf "$path" >/dev/null 2>&1 || true
}

oci_blob_path() {
  local staging_dir="$1"
  local digest="$2"
  local algorithm="${digest%%:*}"
  local value="${digest#*:}"

  [ -n "$algorithm" ] && [ -n "$value" ] && [ "$algorithm" != "$digest" ] || return 1
  printf '%s\n' "$staging_dir/blobs/$algorithm/$value"
}

extract_container_export_rootfs() {
  local export_file="$1"
  local rootfs_dir="$2"
  local staging_dir="${rootfs_dir}.export"
  local manifest_digest=""
  local manifest_file=""
  local layer_file=""
  local layer_digest=""
  local layer_digests=""
  local extracted_layer=0

  rm -rf "$rootfs_dir" "$staging_dir" || return 1
  mkdir -p "$rootfs_dir" "$staging_dir" || return 1
  tar -xf "$export_file" -C "$staging_dir" || return 1

  if [ -f "$staging_dir/oci-layout" ] && [ -d "$staging_dir/blobs" ]; then
    [ -f "$staging_dir/index.json" ] || die "Container export did not contain an OCI index"
    manifest_digest="$(jq -er '.manifests[0].digest // empty' "$staging_dir/index.json")" || die "Container export did not contain an OCI manifest"
    manifest_file="$(oci_blob_path "$staging_dir" "$manifest_digest")" || die "Container export contained an invalid OCI manifest digest"
    [ -f "$manifest_file" ] || die "Container export referenced a missing OCI manifest blob"
    layer_digests="$(jq -er '.layers | if type == "array" and length > 0 then .[].digest else error("missing layers") end' "$manifest_file")" \
      || die "Container export did not contain valid OCI layer digests"
    while IFS= read -r layer_digest; do
      [ -n "$layer_digest" ] || continue
      layer_file="$(oci_blob_path "$staging_dir" "$layer_digest")" || die "Container export contained an invalid OCI layer digest"
      [ -f "$layer_file" ] || die "Container export referenced a missing OCI layer blob"
      tar -xf "$layer_file" -C "$rootfs_dir" || return 1
      extracted_layer=1
    done <<<"$layer_digests"
    rm -rf "$staging_dir" || return 1
    [ "$extracted_layer" -eq 1 ] || die "Container export did not contain any extractable filesystem layers"
    return 0
  fi

  tar -C "$staging_dir" -cf - . | tar -C "$rootfs_dir" -xf - || return 1
  rm -rf "$staging_dir" || return 1
}

container_export_is_oci_layout() {
  local export_file="$1"

  tar -tf "$export_file" 2>/dev/null | grep -Fqx 'oci-layout'
}

container_export_rootfs_tar() {
  local export_file="$1"
  local rootfs_tar="$2"
  local extract_root="$3"

  if container_export_is_oci_layout "$export_file"; then
    mkdir -p "$extract_root"
    extract_container_export_rootfs "$export_file" "$extract_root"
    tar -C "$extract_root" -cf "$rootfs_tar" .
  else
    cp "$export_file" "$rootfs_tar"
  fi
}

validate_backup_rootfs() {
  local backup_root="$1"
  local backup_image="$2"

  [ -d "$backup_root/home/coder" ] || die "Backup image $backup_image was not created because container export did not include /home/coder"
  [ -e "$backup_root/bin/sh" ] || [ -L "$backup_root/bin/sh" ] || [ -e "$backup_root/usr/bin/sh" ] || [ -L "$backup_root/usr/bin/sh" ] || die "Backup image $backup_image was not created because container export did not include a shell"
}

validate_backup_image() {
  local backup_image="$1"
  local temp_name
  temp_name="$(sanitize_image_name "agentctl-backup-validate-$(date -u +%Y%m%d%H%M%S)-$$")"

  "$CONTAINER_CMD" rm "$temp_name" >/dev/null 2>&1 || true
  if ! "$CONTAINER_CMD" create -t --name "$temp_name" "$backup_image" /bin/sh -c 'test -d /home/coder' >/dev/null; then
    "$CONTAINER_CMD" rm "$temp_name" >/dev/null 2>&1 || true
    die "Backup image $backup_image was built but cannot create a validation container"
  fi
  if ! "$CONTAINER_CMD" start "$temp_name" >/dev/null; then
    "$CONTAINER_CMD" rm "$temp_name" >/dev/null 2>&1 || true
    die "Backup image $backup_image was built but cannot start /bin/sh"
  fi
  "$CONTAINER_CMD" stop "$temp_name" >/dev/null 2>&1 || true
  "$CONTAINER_CMD" rm "$temp_name" >/dev/null 2>&1 || true
}

build_backup_image_from_export() {
  local backup_image="$1"
  local container_name="$2"
  local export_file="$3"
  local backup_root="$4"
  local backup_dockerfile="$5"
  local restart_source_on_failure="${6:-0}"
  local backup_context="${backup_root}.context"
  local context_rootfs="$backup_context/rootfs"
  local context_dockerfile="$backup_context/Dockerfile"
  local context_rootfs_tar="$backup_context/rootfs.tar"

  rm -rf "$backup_root" "$backup_context"
  mkdir -p "$context_rootfs"
  container_export_rootfs_tar "$export_file" "$context_rootfs_tar" "$context_rootfs"
  tar -xf "$context_rootfs_tar" -C "$context_rootfs"
  validate_backup_rootfs "$context_rootfs" "$backup_image"
  cat >"$context_dockerfile" <<EOF
FROM scratch
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ADD rootfs.tar /
EOF
  cp "$context_dockerfile" "$backup_dockerfile"
  if ! "$CONTAINER_CMD" build -t "$backup_image" -f "$context_dockerfile" "$backup_context"; then
    stop_buildkit_container
    if [ "$restart_source_on_failure" -eq 1 ]; then
      echo "Restarting original container after failed backup image build: $container_name" >&2
      if ! start_existing_container_safely "$container_name" >/dev/null 2>&1; then
        warn "Failed to restart $container_name after backup image build failure; start it manually with: ${CLI_NAME} start --name $container_name"
      fi
    fi
    report_backup_storage_diagnostics || true
    die "Failed to build backup image $backup_image. The original container $container_name was not removed."
  fi
  stop_buildkit_container
  validate_backup_image "$backup_image"
}

container_mount_mode() {
  jq -Rrs '
    (try fromjson catch {})
    | (if type == "array" then (.[0] // {}) elif type == "object" then . else {} end)
    | (.configuration // .) as $config
    | [($config.mounts // [])[]
        | select((.destination // .dst // "") == "/workdir")][0] as $mount
    | if $mount == null then "unknown"
      elif (($mount.options // []) | if type == "string" then [.] else . end | index("ro")) != null then "ro"
      else "rw" end
  ' 2>/dev/null || printf 'unknown\n'
}

container_extra_mounts() {
  jq -Rrs '
    (try fromjson catch null) as $parsed
    | if $parsed == null then error("invalid container inspect JSON")
      elif ($parsed | type) == "array" then ($parsed[0] // {})
      elif ($parsed | type) == "object" then $parsed
      else error("invalid container inspect JSON") end
    | (.configuration // .) as $config
    | ($config.mounts // [])[]
    | [(.source // .src // .hostPath // ""),
       (.destination // .dst // .target // .containerPath // "")]
    | @tsv
  '
}

validate_socket_path() {
  local path="$1"
  local label="$2"
  local byte_count=""

  [ -n "$path" ] || die "$label must not be empty"
  [ "${path#/}" != "$path" ] || die "$label must be absolute: $path"
  case "$path" in
    *:*|*,*|*$'\n'*) die "$label contains a character unsupported by Apple container mount syntax: $path" ;;
  esac
  if printf '%s' "$path" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    die "$label contains a control character"
  fi
  byte_count="$(printf '%s' "$path" | LC_ALL=C wc -c | tr -d ' ')"
  [ "$byte_count" -le "$SOCKET_PATH_MAX_BYTES" ] \
    || die "$label exceeds the Unix-socket path limit ($SOCKET_PATH_MAX_BYTES bytes): $path"
}

validate_socket_destination() {
  local destination="$1"
  validate_socket_path "$destination" "Socket container path"
  case "$destination" in
    /workdir|/workdir/*|/home/coder|/home/coder/*|/var/host-services/ssh-auth.sock|/run/agentctl|/run/agentctl/*)
      die "Socket container path is reserved by agentctl: $destination"
      ;;
  esac
}

mcp_validate_port() {
  case "$1" in ''|*[!0-9]*) die "Invalid MCP port: $1 (use an unprivileged loopback port from 1024 to 65535)" ;; esac
  [ "$1" -ge 1024 ] && [ "$1" -le 65535 ] || die "Invalid MCP port: $1 (use an unprivileged loopback port from 1024 to 65535)"
}

mcp_runtime_dir() { printf '%s/agentctl-%s\n' "${TMPDIR:-/tmp}" "$(id -u)"; }
mcp_log_dir() { printf '%s\n' "${AGENTCTL_MCP_LOG_DIR:-$(mcp_runtime_dir)}"; }
mcp_registry_dir() { printf '%s/Library/Application Support/agentctl/mcp\n' "${HOME}"; }
mcp_identity_hash() { printf '%s' "$1" | cksum | awk '{printf "%08x%08x\n", $1, $2}'; }
mcp_socket_path() { printf '%s/mcp-%s.sock\n' "$(mcp_runtime_dir)" "$(mcp_identity_hash "$1")"; }
mcp_registry_path() { printf '%s/%s.json\n' "$(mcp_registry_dir)" "$1"; }

mcp_definition_json() {
  local value="$1" raw="" base=""
  if [ "$value" = xcode ]; then
    raw='{"name":"xcode","command":"xcrun","args":["mcpbridge"],"shared":true}'
  elif [ "${value#@}" != "$value" ]; then
    local file="${value#@}"
    [ -f "$file" ] && [ ! -L "$file" ] || die "MCP definition file must be a regular, non-symlink file: $file"
    [ "$(host_path_uid "$file")" = "$(id -u)" ] || die "MCP definition file must be owned by the current user: $file"
    [ "$((8#$(host_path_mode "$file") & 077))" -eq 0 ] || die "MCP definition file must be inaccessible to group and other users: $file"
    raw="$(<"$file")"
    base="$(CDPATH= cd -- "$(dirname -- "$file")" && pwd -P)"
  else
    raw="$value"
  fi
  printf '%s' "$raw" | jq -ce --arg base "$base" '
    (if type == "array" then . else [.] end)[] |
    if type != "object" then error("server must be an object") else . end |
    if ((keys - ["name","command","args","cwd","env","env_vars","shared"])|length)>0 then error("unknown field") else . end |
    if (.name|type)!="string" or (.name|test("^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$")|not) then error("invalid name") else . end |
    if (.command|type)!="string" or (.command|length)==0 then error("invalid command") else . end |
    if ((.args // [])|type)!="array" or any((.args // [])[]; type!="string") then error("args must contain strings") else . end |
    if ((.env // {})|type)!="object" or any((.env // {})[]; type!="string") then error("env values must be strings") else . end |
    if any((.env // {})|keys[]; test("^[A-Za-z_][A-Za-z0-9_]*$")|not) then error("invalid env name") else . end |
    if ((.env_vars // [])|type)!="array" or any((.env_vars // [])[]; type!="string" or test("^[A-Za-z_][A-Za-z0-9_]*$")|not) then error("invalid env_vars") else . end |
    if ((.shared // false)|type)!="boolean" then error("shared must be boolean") else . end |
    .args=(.args // []) | .env=(.env // {}) | .env_vars=(.env_vars // []) |
    if .cwd then .cwd=(if (.cwd|startswith("/")) then .cwd elif $base!="" then ($base+"/"+.cwd) else .cwd end) else . end
  ' 2>/dev/null || die "Invalid MCP server definition"
}

mcp_add_definition() {
  local entries="" entry="" name="" command="" resolved="" cwd="" inherited='{}'
  entries="$(mcp_definition_json "$1")"
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    name="$(printf '%s' "$entry" | jq -r .name)"
    printf '%s' "$MCP_CONFIG_JSON" | jq -e --arg n "$name" 'any(.[]; .name==$n)' >/dev/null && die "Duplicate MCP server name: $name"
    command="$(printf '%s' "$entry" | jq -r .command)"
    if [ "${command#/}" = "$command" ]; then resolved="$(command -v "$command" 2>/dev/null || true)"; else resolved="$command"; fi
    [ -n "$resolved" ] && [ -x "$resolved" ] || die "MCP command not found or not executable on the host: $command"
    resolved="$(CDPATH= cd -- "$(dirname -- "$resolved")" && pwd -P)/$(basename -- "$resolved")"
    cwd="$(printf '%s' "$entry" | jq -r '.cwd // empty')"
    if [ -n "$cwd" ]; then [ -d "$cwd" ] || die "MCP working directory not found: $cwd"; cwd="$(CDPATH= cd -- "$cwd" && pwd -P)"; fi
    inherited='{}'
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      if [ "${!name+x}" = x ]; then inherited="$(printf '%s' "$inherited" | jq -c --arg k "$name" --arg v "${!name}" '.+{($k):$v}')"; fi
    done < <(printf '%s' "$entry" | jq -r '.env_vars[]')
    entry="$(printf '%s' "$entry" | jq -c --arg cmd "$resolved" --arg cwd "$cwd" --argjson inherited "$inherited" '.command=$cmd | .cwd=(if $cwd=="" then null else $cwd end) | .inherited_env=$inherited | .shared_process=(.shared // false)')"
    MCP_CONFIG_JSON="$(printf '%s' "$MCP_CONFIG_JSON" | jq -c --argjson item "$entry" '.+[$item]')"
  done <<<"$entries"
  MCP_REQUESTED=1
}

mcp_prepare_private_dir() {
  local dir="$1"
  if [ -e "$dir" ]; then
    [ -d "$dir" ] && [ ! -L "$dir" ] && [ "$(host_path_uid "$dir")" = "$(id -u)" ] || die "Unsafe managed MCP directory collision: $dir"
    [ "$((8#$(host_path_mode "$dir") & 077))" -eq 0 ] || die "Unsafe managed MCP directory permissions: $dir"
  else mkdir -m 700 -p "$dir"; fi
}

mcp_validate_private_file() {
  local path="$1" label="$2"
  [ -f "$path" ] && [ ! -L "$path" ] || die "$label must be a regular, non-symlink file: $path"
  [ "$(host_path_uid "$path")" = "$(id -u)" ] || die "$label must be owned by the current user: $path"
  [ "$((8#$(host_path_mode "$path") & 077))" -eq 0 ] || die "$label must be inaccessible to group and other users: $path"
}

mcp_prepare_log_file() {
  local path="$1"
  if [ -e "$path" ] || [ -L "$path" ]; then mcp_validate_private_file "$path" "Managed MCP log"; fi
  : >"$path"; chmod 600 "$path"
}

mcp_persist_registry() {
  local name="$1" path temp safe
  mcp_prepare_private_dir "$(mcp_registry_dir)"
  path="$(mcp_registry_path "$name")"; temp="${path}.tmp.$$"
  safe="$(printf '%s' "$MCP_CONFIG_JSON" | jq -c '[.[]|del(.env,.inherited_env)]')"
  jq -n --arg name "$name" --argjson port "$MCP_PORT" --argjson servers "$safe" '{schema_version:1,container:$name,port:$port,servers:$servers}' >"$temp"
  chmod 600 "$temp"; mv "$temp" "$path"
}

mcp_config_fingerprint() {
  printf '%s' "$MCP_CONFIG_JSON" | jq -Sc 'sort_by(.name) | map(.env_vars = ((.env_vars // []) | sort))' | cksum | awk '{printf "%08x-%s\n", $1, $2}'
}

mcp_process_token() {
  local pid="$1"
  { ps -p "$pid" -o lstart= 2>/dev/null || true; } | cksum | awk 'NF {printf "%08x-%s\n", $1, $2}'
}

mcp_process_started() {
  { ps -p "$1" -o lstart= 2>/dev/null || true; } | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

mcp_lock_acquire() {
  local name="$1" base lock file owner owner_pid owner_token current_token candidate stage winner self_pid tries=0 stale=0
  base="$(mcp_runtime_dir)/mcp-$(mcp_identity_hash "$name").lock."
  lock="${base%.}"
  self_pid="$$"
  MCP_LOCK_TOKEN="${self_pid}:$(mcp_process_token "$self_pid"):${RANDOM:-0}"
  candidate="${base}${self_pid}-${RANDOM:-0}"
  stage="$(mcp_runtime_dir)/.mcp-lock-stage.${self_pid}-${RANDOM:-0}"
  [ ! -e "$candidate" ] && [ ! -L "$candidate" ] || die "Managed MCP lock path collision: $candidate"
  [ ! -e "$stage" ] && [ ! -L "$stage" ] || die "Managed MCP lock staging collision: $stage"
  printf '%s\n' "$MCP_LOCK_TOKEN" >"$stage"; chmod 600 "$stage"
  if ! ln "$stage" "$candidate" 2>/dev/null; then rm -f "$stage"; die "Could not publish managed MCP lock contender: $candidate"; fi
  rm -f "$stage"
  while :; do
    stale=0
    if [ -e "$lock" ] || [ -L "$lock" ]; then
      [ -f "$lock" ] && [ ! -L "$lock" ] || { rm -f "$candidate"; die "Unsafe managed MCP lock collision: $lock"; }
      owner="$(sed -n '1p' "$lock" 2>/dev/null || true)"
      owner_pid="${owner%%:*}"; owner_token="${owner#*:}"; owner_token="${owner_token%:*}"
      case "$owner_pid" in ''|*[!0-9]*) rm -f "$candidate"; die "Invalid managed MCP lock owner: $lock" ;; esac
      current_token="$(mcp_process_token "$owner_pid")"
      if [ "$owner_pid" = "$self_pid" ] && [ "$owner" != "$MCP_LOCK_TOKEN" ]; then
        stale=1
      elif ! kill -0 "$owner_pid" 2>/dev/null || { [ -n "$current_token" ] && [ "$current_token" != "$owner_token" ]; }; then
        stale=1
      elif [ "$owner" = "$MCP_LOCK_TOKEN" ]; then
        MCP_LOCK_DIR="$lock"; rm -f "$candidate"; return 0
      fi
    else
      if ln "$candidate" "$lock" 2>/dev/null; then MCP_LOCK_DIR="$lock"; rm -f "$candidate"; return 0; fi
    fi
    if [ "$stale" -eq 1 ]; then
      winner=""
      for file in "${base}"*; do
        [ -e "$file" ] || continue
        [ -f "$file" ] && [ ! -L "$file" ] || { rm -f "$candidate"; die "Unsafe managed MCP lock contender collision: $file"; }
        owner="$(sed -n '1p' "$file" 2>/dev/null || true)"
        owner_pid="${owner%%:*}"; owner_token="${owner#*:}"; owner_token="${owner_token%:*}"
        case "$owner_pid" in ''|*[!0-9]*) rm -f "$candidate"; die "Invalid managed MCP lock contender: $file" ;; esac
        current_token="$(mcp_process_token "$owner_pid")"
        if ! kill -0 "$owner_pid" 2>/dev/null || { [ -n "$current_token" ] && [ "$current_token" != "$owner_token" ]; }; then
          rm -f "$file"
          continue
        fi
        if [ -z "$winner" ] || [[ "$file" < "$winner" ]]; then winner="$file"; fi
      done
      if [ "$winner" = "$candidate" ]; then
        owner="$(sed -n '1p' "$lock" 2>/dev/null || true)"
        if [ "$owner" != "$MCP_LOCK_TOKEN" ]; then rm -f "$lock"; fi
      fi
    fi
    [ -e "$candidate" ] || die "Managed MCP lock contender disappeared: $candidate"
    tries=$((tries+1)); if [ "$tries" -ge 100 ]; then rm -f "$candidate"; die "Timed out waiting for managed MCP lock for $name"; fi
    sleep 0.05
  done
}

mcp_lock_release() {
  if [ -n "$MCP_LOCK_DIR" ] && [ "$(sed -n '1p' "$MCP_LOCK_DIR" 2>/dev/null || true)" = "$MCP_LOCK_TOKEN" ]; then rm -f "$MCP_LOCK_DIR"; fi
  MCP_LOCK_DIR=""; MCP_LOCK_TOKEN=""
}

mcp_lease_count() {
  local name="$1" file="" lease_pid="" lease_token="" current_token="" count=0 pattern
  pattern="$(mcp_runtime_dir)/mcp-$(mcp_identity_hash "$name").lease."
  for file in "${pattern}"*.json; do
    [ -e "$file" ] || continue
    if [ -L "$file" ] || [ ! -f "$file" ]; then die "Unsafe managed MCP lease collision: $file"; fi
    lease_pid="$(jq -r '.owner_pid // empty' "$file" 2>/dev/null)"
    case "$lease_pid" in ''|*[!0-9]*) rm -f "$file"; continue ;; esac
    if ! kill -0 "$lease_pid" 2>/dev/null; then rm -f "$file"; continue; fi
    lease_token="$(jq -r '.owner_token // empty' "$file" 2>/dev/null)"; current_token="$(mcp_process_token "$lease_pid")"
    if [ -n "$lease_token" ] && [ -n "$current_token" ] && [ "$lease_token" != "$current_token" ]; then rm -f "$file"; continue; fi
    count=$((count+1))
  done
  printf '%s\n' "$count"
}

mcp_require_no_active_leases() {
  local name="$1" action="$2" count
  count="$(mcp_lease_count "$name")"
  [ "$count" -eq 0 ] || die "Cannot $action container $name while $count managed MCP lease(s) are active"
}

mcp_create_lease() {
  local name="$1" fingerprint temp self_pid
  fingerprint="$(mcp_config_fingerprint)"
  self_pid="$$"
  temp="$(mcp_runtime_dir)/mcp-$(mcp_identity_hash "$name").lease.${self_pid}-${RANDOM:-0}.json"
  [ ! -e "$temp" ] && [ ! -L "$temp" ] || die "Managed MCP lease path collision: $temp"
  jq -n --argjson owner_pid "$self_pid" --arg owner_token "$(mcp_process_token "$self_pid")" --arg owner_started "$(mcp_process_started "$self_pid")" --arg fingerprint "$fingerprint" '{schema_version:1,owner_pid:$owner_pid,owner_token:$owner_token,owner_started:$owner_started,fingerprint:$fingerprint}' >"$temp"
  chmod 600 "$temp"; MCP_LEASE_FILE="$temp"
}

mcp_release_lease() {
  [ -z "$MCP_LEASE_FILE" ] || rm -f "$MCP_LEASE_FILE"
  MCP_LEASE_FILE=""
}

mcp_start_relay() {
  local name="$1" dir log_dir config log lease_prefix metadata_temp
  command -v node >/dev/null 2>&1 || die "Managed MCP requires Node.js on the host"
  dir="$(mcp_runtime_dir)"; mcp_prepare_private_dir "$dir"
  log_dir="$(mcp_log_dir)"; mcp_prepare_private_dir "$log_dir"
  MCP_RELAY_SOCKET="$(mcp_socket_path "$name")"
  [ ! -e "$MCP_RELAY_SOCKET" ] && [ ! -L "$MCP_RELAY_SOCKET" ] || die "Managed MCP socket path collision: $MCP_RELAY_SOCKET"
  MCP_RELAY_NONCE="${name}-$$-$(date +%s)-${RANDOM:-0}"
  config="$dir/mcp-$(mcp_identity_hash "$name").lease.json"; log="$log_dir/mcp-$(mcp_identity_hash "$name").log"
  [ ! -e "$config" ] && [ ! -L "$config" ] || die "Managed MCP lease path collision: $config"
  lease_prefix="mcp-$(mcp_identity_hash "$name").lease."
  mcp_prepare_log_file "$log"
  jq -n --argjson servers "$MCP_CONFIG_JSON" --arg lease_dir "$dir" --arg lease_prefix "$lease_prefix" \
    '{schema_version:1,timeout_ms:30000,servers:$servers,lease_dir:$lease_dir,lease_prefix:$lease_prefix,ephemeral_env:any($servers[]; ((.env // {})|length)>0)}' >"$config"; chmod 600 "$config"
  node "$SCRIPT_DIR/mcp/host-relay.mjs" "$MCP_RELAY_SOCKET" "$config" "$MCP_RELAY_NONCE" </dev/null >>"$log" 2>&1 & MCP_RELAY_PID=$!
  local tries=0; while [ "$tries" -lt 50 ] && [ ! -S "$MCP_RELAY_SOCKET" ]; do sleep 0.02; tries=$((tries+1)); done
  if ! { [ -S "$MCP_RELAY_SOCKET" ] && kill -0 "$MCP_RELAY_PID" 2>/dev/null; }; then
    kill "$MCP_RELAY_PID" 2>/dev/null || true; wait "$MCP_RELAY_PID" 2>/dev/null || true
    rm -f "$MCP_RELAY_SOCKET" "$config"
    die "Managed MCP host relay failed to start (see $log)"
  fi
  MCP_RELAY_METADATA="$dir/mcp-$(mcp_identity_hash "$name").process.json"
  metadata_temp="${MCP_RELAY_METADATA}.tmp.$$"
  if ! jq -n --argjson pid "$MCP_RELAY_PID" --arg nonce "$MCP_RELAY_NONCE" --arg socket "$MCP_RELAY_SOCKET" --arg fingerprint "$(mcp_config_fingerprint)" '{schema_version:1,pid:$pid,nonce:$nonce,socket:$socket,fingerprint:$fingerprint}' >"$metadata_temp" \
    || ! chmod 600 "$metadata_temp" || ! mv "$metadata_temp" "$MCP_RELAY_METADATA"; then
    kill "$MCP_RELAY_PID" 2>/dev/null || true; wait "$MCP_RELAY_PID" 2>/dev/null || true
    rm -f "$metadata_temp" "$MCP_RELAY_SOCKET" "$config"
    die "Managed MCP host relay metadata could not be installed"
  fi
  rm -f "$config"
}

mcp_acquire_relay() {
  local name="$1" metadata fingerprint existing_fingerprint pid nonce socket response
  mcp_prepare_private_dir "$(mcp_runtime_dir)"
  mcp_lock_acquire "$name"
  mcp_lease_count "$name" >/dev/null
  metadata="$(mcp_runtime_dir)/mcp-$(mcp_identity_hash "$name").process.json"
  fingerprint="$(mcp_config_fingerprint)"
  if [ -e "$metadata" ] || [ -L "$metadata" ]; then
    mcp_validate_private_file "$metadata" "Managed MCP process metadata"
    existing_fingerprint="$(jq -r '.fingerprint // empty' "$metadata")"
    pid="$(jq -r '.pid' "$metadata")"; nonce="$(jq -r '.nonce' "$metadata")"; socket="$(jq -r '.socket' "$metadata")"
    [ "$socket" = "$(mcp_socket_path "$name")" ] || die "Managed MCP metadata socket does not match expected path for $name"
    response="$(curl --silent --max-time 2 --unix-socket "$socket" http://localhost/.well-known/agentctl-mcp-health 2>/dev/null || true)"
    if printf '%s' "$response" | jq -e --arg nonce "$nonce" --argjson pid "$pid" '.ok and .nonce==$nonce and .pid==$pid' >/dev/null 2>&1; then
      if [ "$existing_fingerprint" != "$fingerprint" ]; then mcp_lock_release; die "Conflicting managed MCP definitions are already active for container $name"; fi
      MCP_RELAY_PID="$pid"; MCP_RELAY_NONCE="$nonce"; MCP_RELAY_SOCKET="$socket"; MCP_RELAY_METADATA="$metadata"
      mcp_create_lease "$name"; mcp_lock_release; return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null && { [ ! -e "$socket" ] && [ ! -L "$socket" ] || { [ -S "$socket" ] && [ ! -L "$socket" ] && [ "$(host_path_uid "$socket")" = "$(id -u)" ]; }; }; then
      rm -f "$socket" "$metadata"
    else
      die "Refusing to replace an unverified managed MCP relay for $name"
    fi
  fi
  mcp_start_relay "$name"
  mcp_create_lease "$name"
  mcp_lock_release
}

mcp_stop_relay() {
  if [ -n "$MCP_RELAY_PID" ] && kill -0 "$MCP_RELAY_PID" 2>/dev/null; then kill "$MCP_RELAY_PID" 2>/dev/null || true; wait "$MCP_RELAY_PID" 2>/dev/null || true; fi
  if [ -n "$MCP_RELAY_SOCKET" ] && [ -S "$MCP_RELAY_SOCKET" ] && [ ! -L "$MCP_RELAY_SOCKET" ]; then rm -f "$MCP_RELAY_SOCKET"; fi
  [ -z "$MCP_RELAY_METADATA" ] || rm -f "$MCP_RELAY_METADATA"
  MCP_RELAY_PID=""
}

mcp_stop_managed() {
  local name="$1" metadata pid nonce socket response expected_socket runtime_dir
  runtime_dir="$(mcp_runtime_dir)"; mcp_prepare_private_dir "$runtime_dir"
  metadata="$(mcp_runtime_dir)/mcp-$(mcp_identity_hash "$name").process.json"
  [ -e "$metadata" ] || [ -L "$metadata" ] || return 0
  mcp_validate_private_file "$metadata" "Managed MCP process metadata"
  pid="$(jq -r '.pid // empty' "$metadata" 2>/dev/null)"; nonce="$(jq -r '.nonce // empty' "$metadata" 2>/dev/null)"; socket="$(jq -r '.socket // empty' "$metadata" 2>/dev/null)"
  expected_socket="$(mcp_socket_path "$name")"
  [ "$socket" = "$expected_socket" ] || die "Managed MCP metadata socket does not match expected path for $name"
  case "$pid" in ''|*[!0-9]*) die "Managed MCP metadata contains an invalid PID for $name" ;; esac
  [ -n "$nonce" ] || die "Managed MCP metadata contains an invalid nonce for $name"
  if [ ! -e "$socket" ] && [ ! -L "$socket" ]; then rm -f "$metadata"; return 0; fi
  [ -S "$socket" ] && [ ! -L "$socket" ] || die "Managed MCP socket is unsafe for $name"
  response="$(curl --silent --max-time 2 --unix-socket "$socket" http://localhost/.well-known/agentctl-mcp-health 2>/dev/null || true)"
  printf '%s' "$response" | jq -e --arg nonce "$nonce" --argjson pid "$pid" '.ok==true and .nonce==$nonce and .pid==$pid' >/dev/null 2>&1 \
    || die "Refusing to signal unverified managed MCP process for $name"
  kill "$pid" 2>/dev/null || true
  local tries=0; while kill -0 "$pid" 2>/dev/null && [ "$tries" -lt 20 ]; do sleep 0.05; tries=$((tries+1)); done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null || true
    tries=0; while kill -0 "$pid" 2>/dev/null && [ "$tries" -lt 20 ]; do sleep 0.05; tries=$((tries+1)); done
  fi
  kill -0 "$pid" 2>/dev/null && die "Managed MCP process did not stop for $name; preserving ownership metadata"
  [ ! -S "$socket" ] || rm -f "$socket"
  rm -f "$metadata"
}

mcp_start_from_registry() {
  local name="$1" registry variable inherited='{}'
  registry="$(mcp_registry_path "$name")"; [ -f "$registry" ] && [ ! -L "$registry" ] || return 1
  mcp_validate_private_file "$registry" "Managed MCP registry"
  MCP_PORT="$(jq -r '.port // 47123' "$registry")"; mcp_validate_port "$MCP_PORT"
  MCP_CONFIG_JSON="$(jq -c '[.servers[] | .env={} | .inherited_env={}]' "$registry")"
  while IFS= read -r variable; do
    [ -n "$variable" ] || continue
    if [ "${!variable+x}" = x ]; then
      MCP_CONFIG_JSON="$(printf '%s' "$MCP_CONFIG_JSON" | jq -c --arg k "$variable" --arg v "${!variable}" 'map(if (.env_vars|index($k)) then .inherited_env[$k]=$v else . end)')"
    fi
  done < <(printf '%s' "$MCP_CONFIG_JSON" | jq -r '.[].env_vars[]' | LC_ALL=C sort -u)
  MCP_REQUESTED=1; mcp_start_relay "$name"
}

mcp_configure_guest() {
  local name="$1" json guest_log tries=0
  ensure_requested_feature_installed "$name" mcp-bridge
  refresh_container_file "$name" "$SCRIPT_DIR/mcp/guest-proxy.mjs" "/usr/local/lib/agentctl/mcp-guest-proxy.mjs" "root:root" "755"
  json="$(mktemp "${TMPDIR:-/tmp}/agentctl-mcp-guest.XXXXXX")"
  printf '{"schema_version":1,"port":%s,"socket_path":"%s"}\n' "$MCP_PORT" "$MCP_GUEST_SOCKET" >"$json"
  refresh_container_file "$name" "$json" "/etc/agentctl/mcp-bridge.json" "root:root" "644"; rm -f "$json"
  "$CONTAINER_CMD" exec "$name" sh -c 'pkill -f "[m]cp-guest-proxy.mjs" >/dev/null 2>&1 || true'
  guest_log="$(mcp_log_dir)/guest-$(mcp_identity_hash "$name").log"
  mcp_prepare_log_file "$guest_log"
  "$CONTAINER_CMD" exec "$name" node /usr/local/lib/agentctl/mcp-guest-proxy.mjs /etc/agentctl/mcp-bridge.json \
    </dev/null >>"$guest_log" 2>&1 &
  MCP_GUEST_EXEC_PID=$!
  while [ "$tries" -lt 50 ]; do
    if "$CONTAINER_CMD" exec "$name" sh -c \
      'curl -fsS --max-time 1 "http://127.0.0.1:$1/.well-known/agentctl-mcp-health" >/dev/null' sh "$MCP_PORT" 2>/dev/null; then
      return 0
    fi
    kill -0 "$MCP_GUEST_EXEC_PID" 2>/dev/null || break
    sleep 0.1
    tries=$((tries+1))
  done
  echo "Managed MCP guest proxy failed to become ready; diagnostics: $guest_log" >&2
  sed -n '1,200p' "$guest_log" >&2 || true
  return 1
}

validate_host_socket() {
  local source="$1"
  validate_socket_path "$source" "Host socket path"
  [ ! -L "$source" ] || die "Host socket path must not be a symlink: $source"
  [ -e "$source" ] || die "Host socket does not exist: $source"
  [ -S "$source" ] || die "Host socket path is not a Unix socket: $source"
}

socket_mapping_destination() {
  printf '%s\n' "${1#*$'\t'}"
}

socket_mapping_source() {
  printf '%s\n' "${1%%$'\t'*}"
}

socket_text_has_destination() {
  local mappings="$1"
  local destination="$2"
  local record=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    [ "$(socket_mapping_destination "$record")" != "$destination" ] || return 0
  done <<<"$mappings"
  return 1
}

parse_socket_mapping() {
  local value="$1"
  local source=""
  local destination=""
  case "$value" in
    *:*) source="${value%%:*}"; destination="${value#*:}" ;;
    *) die "Invalid --mount-socket value (expected HOST_PATH:CONTAINER_PATH): $value" ;;
  esac
  [ -n "$source" ] && [ -n "$destination" ] \
    || die "Invalid --mount-socket value (expected HOST_PATH:CONTAINER_PATH): $value"
  validate_host_socket "$source"
  validate_socket_destination "$destination"
  printf '%s\t%s\n' "$source" "$destination"
}

socket_unmount_record() {
  local destination="$1"
  validate_socket_destination "$destination"
  printf '\t%s\n' "$destination"
}

validate_requested_socket_mappings() {
  local mappings="$1"
  local seen=""
  local record=""
  local destination=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    destination="$(socket_mapping_destination "$record")"
    socket_text_has_destination "$seen" "$destination" \
      && die "Duplicate socket container path: $destination"
    seen="${seen}${seen:+$'\n'}${record}"
  done <<<"$mappings"
}

container_socket_mounts() {
  local name="$1"
  local removals="${2:-}"
  local mounts=""
  local source=""
  local destination=""
  mounts="$("$CONTAINER_CMD" inspect "$name" 2>/dev/null | container_extra_mounts)" \
    || die "Unable to inspect mounts for container: $name"
  while IFS=$'\t' read -r source destination; do
    [ -n "$source" ] && [ -n "$destination" ] || continue
    case "$destination" in /workdir|/home/coder|/var/host-services/ssh-auth.sock|"$MCP_GUEST_SOCKET") continue ;; esac
    if socket_text_has_destination "$removals" "$destination"; then
      continue
    fi
    if [ -L "$source" ] || [ ! -S "$source" ]; then
      die "Cannot preserve extra mount $source -> $destination because its source cannot be proven to be a Unix socket; remove it with --unmount-socket $destination"
    fi
    validate_host_socket "$source"
    validate_socket_destination "$destination"
    printf '%s\t%s\n' "$source" "$destination"
  done <<<"$mounts"
}

container_extra_mount_text() {
  local name="$1"
  local mounts=""
  local source=""
  local destination=""
  mounts="$("$CONTAINER_CMD" inspect "$name" 2>/dev/null | container_extra_mounts)" \
    || die "Unable to inspect mounts for container: $name"
  while IFS=$'\t' read -r source destination; do
    [ -n "$source" ] && [ -n "$destination" ] || continue
    case "$destination" in /workdir|/home/coder|/var/host-services/ssh-auth.sock|"$MCP_GUEST_SOCKET") continue ;; esac
    printf '%s\t%s\n' "$source" "$destination"
  done <<<"$mounts"
}

container_has_mcp_wiring() {
  local name="$1"
  "$CONTAINER_CMD" inspect "$name" 2>/dev/null | container_extra_mounts | \
    awk -F '\t' -v destination="$MCP_GUEST_SOCKET" '$2 == destination { found=1 } END { exit !found }'
}

socket_mappings_without_mcp() {
  local mappings="$1"
  local record="" destination=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    destination="$(socket_mapping_destination "$record")"
    [ "$destination" = "$MCP_GUEST_SOCKET" ] || printf '%s\n' "$record"
  done <<<"$mappings"
}

merge_socket_mappings() {
  local preserved="$1"
  local requested="$2"
  local record=""
  local destination=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    destination="$(socket_mapping_destination "$record")"
    if ! socket_text_has_destination "$requested" "$destination"; then
      printf '%s\n' "$record"
    fi
  done <<<"$preserved"
  [ -z "$requested" ] || printf '%s\n' "$requested"
}

socket_volume_arguments() {
  local mappings="$1"
  local record=""
  local source=""
  local destination=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    source="$(socket_mapping_source "$record")"
    destination="$(socket_mapping_destination "$record")"
    printf '%s:%s\n' "$source" "$destination"
  done <<<"$mappings"
}

normalize_socket_mappings() {
  printf '%s\n' "$1" | sed '/^$/d' | LC_ALL=C sort
}

validate_existing_socket_mappings() {
  local name="$1"
  local requested="$2"
  local current=""
  current="$(container_socket_mounts "$name")"
  [ "$(normalize_socket_mappings "$current")" = "$(normalize_socket_mappings "$requested")" ] \
    || die "Container $name has different socket mappings. Recreate it with: ${CLI_NAME} upgrade --name $name"
}

validate_container_socket_sources() {
  local name="$1"
  container_socket_mounts "$name" >/dev/null
}

published_socket_parent() {
  dirname -- "$1"
}

host_path_exists() {
  [ -e "$1" ] || [ -L "$1" ]
}

host_path_uid() {
  if stat -f '%u' "$1" >/dev/null 2>&1; then
    stat -f '%u' "$1"
  else
    stat -c '%u' "$1"
  fi
}

host_path_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

validate_published_socket_parent() {
  local host_path="$1"
  local parent=""
  local canonical_parent=""
  local mode=""
  local mode_value=0

  parent="$(published_socket_parent "$host_path")"
  [ -d "$parent" ] || die "Published socket parent directory does not exist: $parent"
  [ ! -L "$parent" ] || die "Published socket parent directory must not be a symlink: $parent"
  canonical_parent="$(CDPATH= cd -- "$parent" && pwd -P)"
  [ "$parent" = "$canonical_parent" ] \
    || die "Published socket parent directory must be canonical (use $canonical_parent): $parent"
  [ "$(host_path_uid "$parent")" = "$(id -u)" ] \
    || die "Published socket parent directory must be owned by the current user: $parent"
  [ -w "$parent" ] && [ -x "$parent" ] \
    || die "Published socket parent directory must be writable and searchable by the current user: $parent"
  mode="$(host_path_mode "$parent")"
  case "$mode" in *[!0-7]*|'') die "Unable to determine published socket parent permissions: $parent" ;; esac
  mode_value=$((8#$mode))
  [ $((mode_value & 077)) -eq 0 ] \
    || die "Published socket parent directory must be inaccessible to group and other users: $parent (mode $mode)"
}

parse_published_socket_mapping() {
  local value="$1"
  local host_path=""
  local container_path=""
  case "$value" in
    *:*) host_path="${value%%:*}"; container_path="${value#*:}" ;;
    *) die "Invalid --publish-socket value (expected HOST_PATH:CONTAINER_PATH): $value" ;;
  esac
  [ -n "$host_path" ] && [ -n "$container_path" ] \
    || die "Invalid --publish-socket value (expected HOST_PATH:CONTAINER_PATH): $value"
  validate_socket_path "$host_path" "Published socket host path"
  validate_published_socket_parent "$host_path"
  validate_socket_destination "$container_path"
  printf '%s\t%s\n' "$host_path" "$container_path"
}

published_socket_unpublish_record() {
  local host_path="$1"
  validate_socket_path "$host_path" "Published socket host path"
  printf '%s\t\n' "$host_path"
}

socket_text_has_source() {
  local mappings="$1"
  local source="$2"
  local record=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    [ "$(socket_mapping_source "$record")" != "$source" ] || return 0
  done <<<"$mappings"
  return 1
}

validate_requested_published_sockets() {
  local mappings="$1"
  local seen=""
  local record=""
  local host_path=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    host_path="$(socket_mapping_source "$record")"
    socket_text_has_source "$seen" "$host_path" && die "Duplicate published socket host path: $host_path"
    seen="${seen}${seen:+$'\n'}${record}"
  done <<<"$mappings"
}

validate_published_socket_records() {
  local mappings="$1"
  local record=""
  local host_path=""
  local container_path=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    host_path="$(socket_mapping_source "$record")"
    container_path="$(socket_mapping_destination "$record")"
    validate_socket_path "$host_path" "Published socket host path"
    validate_socket_destination "$container_path"
  done <<<"$mappings"
}

container_published_sockets_from_inspect() {
  jq -Rrs '
    (try fromjson catch null) as $parsed
    | if $parsed == null then error("invalid container inspect JSON")
      elif ($parsed | type) == "array" then ($parsed[0] // {})
      elif ($parsed | type) == "object" then $parsed
      else error("invalid container inspect JSON") end
    | (.configuration // .) as $config
    | ($config.publishedSockets // [])[]
    | [(.hostPath // .host_path // .source // ""),
       (.containerPath // .container_path // .destination // "")]
    | @tsv
  '
}

container_published_sockets() {
  "$CONTAINER_CMD" inspect "$1" 2>/dev/null | container_published_sockets_from_inspect \
    || die "Unable to inspect published sockets for container: $1"
}

merge_published_sockets() {
  local current="$1"
  local removals="$2"
  local requested="$3"
  local record=""
  local host_path=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    host_path="$(socket_mapping_source "$record")"
    socket_text_has_source "$removals" "$host_path" && continue
    socket_text_has_source "$requested" "$host_path" && continue
    printf '%s\n' "$record"
  done <<<"$current"
  [ -z "$requested" ] || printf '%s\n' "$requested"
}

validate_published_container_collisions() {
  local published="$1"
  local mounted="${2:-}"
  local record=""
  local path=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    path="$(socket_mapping_destination "$record")"
    socket_text_has_destination "$mounted" "$path" \
      && die "Published socket container path collides with a mounted host socket destination: $path"
  done <<<"$published"
  return 0
}

validate_existing_published_sockets() {
  local current=""
  current="$(container_published_sockets "$1")"
  [ "$(normalize_socket_mappings "$current")" = "$(normalize_socket_mappings "$2")" ] \
    || die "Container $1 has different published socket mappings. Recreate it with: ${CLI_NAME} upgrade --name $1"
}

validate_published_host_paths_for_start() {
  local mappings="$1"
  local record=""
  local host_path=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    host_path="$(socket_mapping_source "$record")"
    validate_published_socket_parent "$host_path"
    ! host_path_exists "$host_path" \
      || die "Published socket host destination already exists; agentctl will not remove it: $host_path"
  done <<<"$mappings"
}

start_existing_container_safely() {
  local name="$1"
  local published_sockets=""

  published_sockets="$(container_published_sockets "$name")"
  validate_published_host_paths_for_start "$published_sockets"
  "$CONTAINER_CMD" start "$name"
}

stop_existing_container_safely() {
  local name="$1"
  local published_sockets=""

  published_sockets="$(container_published_sockets "$name")"
  "$CONTAINER_CMD" stop "$name"
  report_leftover_published_sockets "$published_sockets" || true
}

validate_running_published_listeners() {
  local mappings="$1"
  local record=""
  local host_path=""
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    host_path="$(socket_mapping_source "$record")"
    validate_published_socket_parent "$host_path"
    [ ! -L "$host_path" ] && [ -S "$host_path" ] \
      || die "Published socket listener is missing or is not a Unix socket: $host_path"
  done <<<"$mappings"
}

report_leftover_published_sockets() {
  local mappings="$1"
  local record=""
  local host_path=""
  local found=0
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    host_path="$(socket_mapping_source "$record")"
    if host_path_exists "$host_path"; then
      warn "Published socket host path remains after container lifecycle action; not removing it: $host_path"
      found=1
    fi
  done <<<"$mappings"
  return "$found"
}

published_socket_arguments() {
  socket_volume_arguments "$1"
}

validate_published_upgrade_preflight() {
  local current="$1"
  local target="$2"
  local source_running="$3"
  local record=""
  local host_path=""
  if [ "$source_running" -eq 1 ]; then
    validate_running_published_listeners "$current"
  else
    while IFS= read -r record; do
      [ -n "$record" ] || continue
      host_path="$(socket_mapping_source "$record")"
      ! host_path_exists "$host_path" \
        || die "Stopped container has an occupied published socket host path; agentctl will not remove it: $host_path"
    done <<<"$current"
  fi
  while IFS= read -r record; do
    [ -n "$record" ] || continue
    host_path="$(socket_mapping_source "$record")"
    validate_published_socket_parent "$host_path"
    if [ "$source_running" -eq 1 ] && socket_text_has_source "$current" "$host_path"; then
      continue
    fi
    ! host_path_exists "$host_path" \
      || die "Published socket host destination already exists; agentctl will not remove it: $host_path"
  done <<<"$target"
}

container_upgrade_info() {
  jq -Rrs '
    def first: if type == "array" then (.[0] // {}) elif type == "object" then . else {} end;
    def text:
      if type == "string" then .
      elif type == "object" then (.name // .reference // .image // .imageName // .id // "")
      else "" end;
    def resource:
      if . == null or . == "" or . == 0 or . == "0" then ""
      elif type == "number" then if . > 0 then floor | tostring else "" end
      elif type == "string" then . else "" end;
    (try fromjson catch null) as $parsed
    | if $parsed == null then ["", "", "", "", ""]
      else $parsed | first as $data
    | ($data.configuration // $data) as $config
    | [($config.mounts // [])[] | select((.destination // .dst // .target // "") == "/workdir")][0] as $mount
    | (($data.image.name // $config.image.name // $data.image // $config.image // $data.imageReference // $config.imageReference // "") | text) as $image
    | ($config.cpus // $config.resources.cpus // $data.cpus // $data.resources.cpus // null) as $cpus
    | ($config.memory // $config.memoryInBytes // $config.resources.memory // $config.resources.memoryInBytes // $data.memory // $data.memoryInBytes // $data.resources.memory // $data.resources.memoryInBytes // null) as $memory
    | [$image,
       ($mount.source // $mount.src // ""),
       (if $mount == null then "unknown" elif (($mount.options // []) | if type == "string" then [.] else . end | any(. == "ro" or . == "readonly")) then "ro" else "rw" end),
       ($cpus | resource), ($memory | resource)] end
    | join("\t")
  ' 2>/dev/null || printf '\t\t\t\t\n'
}

container_shm_size() {
  local name="$1"

  "$CONTAINER_CMD" inspect "$name" 2>/dev/null | jq -Rrs '
    (try fromjson catch null) as $parsed
    | if $parsed == null then empty
      else $parsed
      | (if type == "array" then (.[0] // {}) elif type == "object" then . else {} end) as $data
      | ($data.configuration // $data) as $config
      | ($config.shmSize // $config.shmSizeInBytes // $config.resources.shmSize // $config.resources.shmSizeInBytes // $data.shmSize // $data.shmSizeInBytes // empty)
      | if type == "number" and . > 0 then floor | tostring
        elif type == "string" and length > 0 and . != "0" then .
        else empty end
      end
  ' 2>/dev/null
}

container_ssh_enabled() {
  local name="$1"

  "$CONTAINER_CMD" inspect "$name" 2>/dev/null | jq -Rrs '
    (try fromjson catch null) as $parsed
    | if $parsed == null then error("invalid container inspect JSON")
      elif ($parsed | type) == "array" then ($parsed[0] // {})
      elif ($parsed | type) == "object" then $parsed
      else error("invalid container inspect JSON") end
    | (.configuration // .) as $config
    | ($config.ssh // false)
    | if type == "boolean" then . else error("invalid SSH forwarding value") end
  '
}

guest_ssh_socket_available() {
  local name="$1"
  "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" sh -c 'socket="${SSH_AUTH_SOCK:-/var/host-services/ssh-auth.sock}"; [ -S "$socket" ]' >/dev/null 2>&1
}

validate_existing_container_ssh() {
  local name="$1"
  local requested="$2"
  local enabled=""

  [ "$requested" -eq 1 ] || return 0
  enabled="$(container_ssh_enabled "$name")" || die "Unable to determine SSH forwarding configuration for existing container: $name"
  [ "$enabled" = "true" ] || die "Container $name was created without SSH forwarding. Recreate it with: ${CLI_NAME} upgrade --name $name --ssh"
  if container_running "$name"; then
    guest_ssh_socket_available "$name" || die "Container $name has SSH forwarding configured, but its guest agent socket is unavailable. Restart it from a shell with SSH_AUTH_SOCK set."
  else
    require_host_ssh_socket
  fi
}

warn_if_ssh_forwarding_unavailable_on_start() {
  local name="$1"
  local enabled=""

  enabled="$(container_ssh_enabled "$name" 2>/dev/null || true)"
  if [ "$enabled" = "true" ] && ! host_ssh_socket_available; then
    warn "Container $name has SSH forwarding enabled, but SSH_AUTH_SOCK is unavailable; the guest SSH agent socket will not be available after start"
  fi
}

validate_mount_mode() {
  local name="$1"
  local read_only="$2"
  local mode
  mode="$("$CONTAINER_CMD" inspect "$name" 2>/dev/null | container_mount_mode)"
  if [ "$read_only" -eq 1 ]; then
    if [ "$mode" = "rw" ]; then
      die "Container already exists: $name (created with writable mount; remove it to recreate read-only, or run without --read-only)"
    fi
    if [ "$mode" = "unknown" ]; then
      warn "Unable to verify mount mode for $name; proceeding"
    fi
  else
    if [ "$mode" = "ro" ]; then
      die "Container already exists: $name (created with read-only mount; remove it to recreate writable, or use --read-only)"
    fi
    if [ "$mode" = "unknown" ]; then
      warn "Unable to verify mount mode for $name; proceeding"
    fi
  fi
}

image_list() {
  "$CONTAINER_CMD" image ls 2>/dev/null || "$CONTAINER_CMD" images 2>/dev/null || true
}

image_list_json() {
  "$CONTAINER_CMD" image ls --format json 2>/dev/null || printf '[]\n'
}

image_matching_timestamp_ref() {
  local image="$1"
  local images_json
  images_json="$(image_list_json)"
  printf '%s' "$images_json" | jq -er --arg target "$image" '
    def norm: if type == "string" then sub("^docker\\.io/library/"; "") else "" end;
    def ref: (.reference // .configuration.name // .configuration.reference // "") | norm;
    def digests: [(.descriptor.digest // .configuration.descriptor.digest // empty), ((.variants // [])[] | .descriptor.digest // .digest // empty)] | unique;
    if type != "array" then error("invalid image list") else . end
    | (if ($target | contains(":")) then $target else $target + ":latest" end) as $latest
    | ($latest | rtrimstr(":" + (split(":")[-1]))) as $family
    | ([.[] | select(type == "object") | select((ref == $target) or (ref == $latest)) | digests][0] // []) as $target_digests
    | if ($target_digests | length) == 0 then error("missing target digest") else . end
    | [.[] | select(type == "object")
        | select(((digests - $target_digests) | length) < (digests | length))
        | ref
        | select(test(":[0-9]{8}-[0-9]{6}$"))
        | select((rtrimstr(":" + (split(":")[-1]))) == $family)]
    | sort | last // empty
  '
}

image_exists() {
  local image="$1"
  "$CONTAINER_CMD" image inspect "$image" >/dev/null 2>&1 && return 0
  parse_image_list | grep -Fqx -- "$image"
}

image_family_preferred() {
  local image="$1"
  local family="${image%%:*}"
  local tag=""

  if [ "$family" != "$image" ]; then
    tag=":${image#*:}"
  fi

  case "$family" in
    codex|agent) echo "agent-plain${tag}" ;;
    codex-python) echo "agent-python${tag}" ;;
    codex-swift) echo "agent-swift${tag}" ;;
    codex-office) echo "agent-office${tag}" ;;
    agent-plain|agent-python|agent-swift|agent-office) echo "${family}${tag}" ;;
    *) echo "$image" ;;
  esac
}

is_legacy_compat_image_family() {
  case "$1" in
    agent-office|codex-office) return 0 ;;
    *) return 1 ;;
  esac
}

warn_legacy_compat_image_usage() {
  local image="$1"
  local family

  family="${image%%:*}"
  if ! is_legacy_compat_image_family "$family"; then
    return 0
  fi

  warn "Image $family is a legacy compatibility image. Phase 4 keeps only agent-plain, agent-python, and agent-swift as first-class base images."
  warn "Prefer agent-python plus runtime installation unless you are intentionally reusing an older office-focused setup."
}

image_ref_for_runtime() {
  local image="$1"
  local preferred
  preferred="$(image_family_preferred "$image")"
  if image_exists "$preferred"; then
    echo "$preferred"
    return 0
  fi
  if image_exists "$image"; then
    echo "$image"
    return 0
  fi
  echo "$preferred"
}

is_codex_image_family() {
  case "$1" in
    codex|agent|agent-plain|agent-python|agent-swift|agent-office) return 0 ;;
    codex-*|agent-*)
      if is_codex_backup_image_ref "$1"; then
        return 1
      fi
      return 0
      ;;
    *) return 1 ;;
  esac
}

is_codex_image_filter_name() {
  local image_filter_name="$1"
  if is_codex_image_family "$image_filter_name"; then
    return 0
  fi
  if [[ "$image_filter_name" == codex-* || "$image_filter_name" == agent-* ]]; then
    return 0
  fi
  return 1
}

is_codex_backup_image_ref() {
  [[ "$1" =~ ^(codex|agent)-.*-backup-[0-9]{14}$ ]]
}

codex_backup_base() {
  local image_ref="$1"
  if [[ "$image_ref" =~ ^(.*)-backup-[0-9]{14}$ ]]; then
    echo "${BASH_REMATCH[1]}"
  fi
}

image_ref_matches_filter() {
  local image_ref="$1"
  local image_filter="$2"
  local family
  local backup_base

  if [ -z "$image_filter" ]; then
    return 0
  fi

  family="${image_ref%%:*}"
  if is_codex_image_family "$family"; then
    [ "$family" = "$image_filter" ]
    return
  fi
  if ! is_codex_backup_image_ref "$family"; then
    return 1
  fi
  if [ "$family" = "$image_filter" ]; then
    return 0
  fi
  backup_base="$(codex_backup_base "$family")"
  if [ "$backup_base" = "$image_filter" ]; then
    return 0
  fi
  return 1
}

image_prune_group() {
  local image_ref="$1"
  local family
  family="${image_ref%%:*}"
  if is_codex_backup_image_ref "$family"; then
    if [[ "$family" =~ ^(.*-backup)-[0-9]{14}$ ]]; then
      echo "${BASH_REMATCH[1]}"
    else
      echo "$family"
    fi
    return
  fi
  echo "$family"
}

is_codex_image_ref() {
  local image_ref="$1"
  local family
  local tag=""

  family="$image_ref"
  if [[ "$image_ref" == *:* ]]; then
    family="${image_ref%%:*}"
    tag="${image_ref#*:}"
  fi
  if [ -z "$tag" ] || [ "$tag" = "latest" ]; then
    if is_codex_image_family "$family"; then
      return 0
    fi
    if is_codex_backup_image_ref "$family"; then
      return 0
    fi
    return 1
  fi
  is_codex_image_family "$family" || return 1
  [ -n "$(timestamp_for_image_ref "$image_ref")" ]
}

parse_image_list() {
  image_list | awk '
    NR == 1 { next }
    NF >= 2 {
      repo = $1
      tag = $2
      if (repo == "" || repo == "<none>" || tag == "" || tag == "<none>") {
        next
      }
      if (tag == "latest") {
        print repo
      } else {
        print repo ":" tag
      }
    }
  '
}

list_codex_image_families_from_refs() {
  local refs="$1"
  printf '%s\n' "$refs" | while IFS= read -r ref; do
    [ -z "$ref" ] && continue
    if is_codex_image_family "${ref%%:*}"; then
      echo "${ref%%:*}"
    fi
  done | sort -u
}

timestamp_for_image_ref() {
  local image_ref="$1"
  if [[ "$image_ref" =~ ^[^:]+:([0-9]{8}-[0-9]{6})$ ]]; then
    echo "${BASH_REMATCH[1]}"
    return
  fi
  if [[ "$image_ref" =~ ^(.*)-backup-([0-9]{8})([0-9]{6})$ ]]; then
    echo "${BASH_REMATCH[2]}-${BASH_REMATCH[3]}"
  fi
}

default_name() {
  local prefix="$1"
  local path="${2:-$PWD}"
  echo "${prefix}$(sanitize_container_name "$(basename "$path")")"
}

sanitize_container_name() {
  local raw="$1"
  local sanitized
  sanitized="$(printf '%s' "$raw" | tr -cs 'A-Za-z0-9_.-' '-')"
  sanitized="${sanitized#-}"
  sanitized="${sanitized%-}"
  if [ -z "$sanitized" ]; then
    sanitized="workdir"
  fi
  echo "$sanitized"
}

sanitize_image_name() {
  local raw="$1"
  local sanitized
  sanitized="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._/-' '-')"
  sanitized="${sanitized#-}"
  sanitized="${sanitized%-}"
  if [ -z "$sanitized" ]; then
    sanitized="agent-backup"
  fi
  echo "$sanitized"
}

usage() {
  cat <<EOF
Usage: $CLI_NAME <command> [options]

Commands:
  version    Print the agentctl release version
  build      Build agent images
  run        Create/start a container for the current directory
  bootstrap  Bootstrap agentctl into an existing compatible container
  runtime    Manage coding runtimes inside an existing container
  feature    Manage installable feature packs inside an existing container
  use        Select the preferred runtime for an existing container
  refresh    Refresh agentctl-managed files in an existing container
  doctor     Check an existing container for common agentctl state problems
  host-address  Print the current host gateway for an Apple container network
  network    Manage Apple container networks used by agentctl
  system-manifest  Print a container package manifest
  upgrade    Recreate a container from the latest image while preserving config
  rescue     Temporarily run a shell or command in a backup image
  auth       Run OpenAI device auth flow and store in Keychain
  exec       Exec into a running container (default: bash)
  su-exec    Exec into a running container as root (default: bash)
  start      Start a container
  stop       Stop a running container
  restart    Restart a container
  rm         Remove a container
  ls         List containers
  images     List local agent images or prune old timestamp tags

Run "$CLI_NAME <command> --help" for command-specific options.
EOF
}

agentctl_release_version() {
  local version_file="$SCRIPT_DIR/VERSION"
  local version=""

  [ -f "$version_file" ] || die "Missing agentctl VERSION file: $version_file"
  IFS= read -r version <"$version_file" || true
  printf '%s\n' "$version" \
    | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$' \
    || die "Invalid agentctl VERSION: ${version:-empty}"
  printf '%s\n' "$version"
}

version_cmd() {
  local version=""

  version="$(agentctl_release_version)"
  printf '%s %s\n' "$CLI_NAME" "$version"
}

usage_build() {
  cat <<EOF
Usage: $CLI_NAME build [--image NAME] [--runtimes NAME[,NAME...]] [--default-runtime NAME] [--features NAME[,NAME...]|all] [--rebuild] [--snapshot] [--pull-base] [--refresh-base]

Options:
  --image NAME       Local image name to build (for example: agent-plain, agent-python, agent-swift, agent-my-team)
  --runtimes LIST    Comma-separated runtimes, or all, to preinstall in the image (default: $DEFAULT_RUNTIME)
  --default-runtime  Runtime to install as the image default (default: $DEFAULT_RUNTIME)
  --features LIST    Comma-separated features, or all, to preinstall (default: none)
  --rebuild          Rebuild images even if they already exist (disables build cache only; does not refresh FROM tags)
  --snapshot         Add a fresh UTC timestamp tag for existing images without rebuilding
  --pull-base     Pull the base image before building (preferred way to refresh remote FROM tags)
  --refresh-base  Remove the base image first so it is re-fetched

Each successful build keeps the stable image name (for example agent-plain) and
also adds an immutable UTC timestamp tag (for example agent-plain:20260313-154500).
The primary built-in/base images are agent-plain, agent-python, and agent-swift.
agent-office remains available only as a legacy compatibility image when explicitly requested.
Local image names follow this convention:
  agent-plain   -> DockerFile
  agent-<name>  -> DockerFile.<name>

Legacy aliases codex, codex-python, and codex-swift are accepted as inputs.

When a local Dockerfile uses FROM another local agent image, $CLI_NAME builds the
dependency chain first.
EOF
}

