usage_bootstrap() {
  cat <<EOF
Usage: $CLI_NAME bootstrap [options]

Options:
  --name NAME     Container name to bootstrap (default: agent-<dir>)
  --image IMAGE   Create the container from IMAGE first if it does not exist
