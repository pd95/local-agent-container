  local name="$1"
  local backup_file="$2"
  local path_list=""

  path_list="$("$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" sh -lc '
cd /home/coder || exit 0
for path in \
  .codex \
  .config/agentctl \
  .claude \
  .claude.json \
  .profile \
  .bashrc \
  .bash_profile \
  .bash_login \
  .bash_logout \
  .bash_history \
  .zshrc \
  .zprofile \
  .zlogin \
  .zlogout \
  .zshenv \
  .zsh_history \
  .ash_history \
  .sh_history; do
  if [ -e "$path" ]; then
    case "$path" in
      .codex)
        find .codex \( -path .codex/packages -o -path ".codex/packages/*" \) -prune -o ! -type d -print
        ;;
      *)
        printf "%s\n" "$path"
        ;;
    esac
  fi
done
