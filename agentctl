manifest_package_manager() {
  local manifest="${1:-}"

  [ -n "$manifest" ] || manifest='{}'

  printf '%s' "$manifest" | jq -r '.package_manager // "unknown"' 2>/dev/null || printf 'unknown\n'
}

manifest_packages_json() {
  local manifest="${1:-}"

  [ -n "$manifest" ] || manifest='{}'

  printf '%s' "$manifest" | jq -c '.packages // []' 2>/dev/null || printf '[]\n'
}

manifest_requested_packages_json() {
  local manifest="${1:-}"

  [ -n "$manifest" ] || manifest='{}'

