collect_upgrade_container_preflight() {
  local name="$1"
  local was_running=0
  local started_for_preflight=0
  local manifest=""
  local baseline_manifest=""

  UPGRADE_PREFLIGHT_CONTAINER_MANIFEST=""
  UPGRADE_PREFLIGHT_BASELINE_MANIFEST=""
  UPGRADE_PREFLIGHT_SOURCE_SUPPORTS_STATE_CONTRACT=0

  if container_running "$name"; then
    was_running=1
  else
    start_existing_container_safely "$name" >/dev/null || return 1
    started_for_preflight=1
    if ! ensure_started_container_is_running "$name" "upgrade preflight"; then
      return 1
    fi
  fi

  manifest="$("$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" bash /usr/local/bin/agent.sh system manifest 2>/dev/null || true)"
  if [ -n "$manifest" ]; then
    UPGRADE_PREFLIGHT_CONTAINER_MANIFEST="$manifest"
  fi

  if "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" test -f "$SYSTEM_BASELINE_MANIFEST_FILE" >/dev/null 2>&1; then
    baseline_manifest="$("$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" cat "$SYSTEM_BASELINE_MANIFEST_FILE" 2>/dev/null || true)"
    if [ -n "$baseline_manifest" ]; then
      UPGRADE_PREFLIGHT_BASELINE_MANIFEST="$baseline_manifest"
    fi
  fi

  if "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" bash /usr/local/bin/agent.sh help 2>/dev/null | grep -Fq 'agent.sh state export'; then
    UPGRADE_PREFLIGHT_SOURCE_SUPPORTS_STATE_CONTRACT=1
  fi

  if [ "$started_for_preflight" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    stop_existing_container_safely "$name" >/dev/null 2>&1 || true
  fi
}

