container_supports_state_contract() {
  local name="$1"
  local was_running=0
  local started_for_check=0

  if container_running "$name"; then
    was_running=1
  else
    start_existing_container_safely "$name" >/dev/null || return 1
    started_for_check=1
    ensure_started_container_is_running "$name" "state contract check" || return 1
  fi

  if "$CONTAINER_CMD" exec "$name" "${SETPRIV_ARGS[@]}" bash /usr/local/bin/agent.sh help 2>/dev/null | grep -Fq 'agent.sh state export'; then
    if [ "$started_for_check" -eq 1 ] && [ "$was_running" -eq 0 ]; then
      stop_existing_container_safely "$name" >/dev/null 2>&1 || true
    fi
    return 0
  fi
  if [ "$started_for_check" -eq 1 ] && [ "$was_running" -eq 0 ]; then
    stop_existing_container_safely "$name" >/dev/null 2>&1 || true
  fi
  return 1
}

