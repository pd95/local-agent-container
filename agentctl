verify_restored_claude_state() {
  local name="$1"
  local backup_file="$2"
  local expected=""
  local actual=""
  local expected_credentials=0
  local expected_settings=0
  local expected_home_state=0
  local expected_projects=0
  local actual_credentials=0
  local actual_settings=0
  local actual_home_state=0
  local actual_projects=0
  local failed=0

  [ -s "$backup_file" ] || return 0
  expected="$(claude_state_summary_from_tar "$backup_file")"
  IFS=$'\t' read -r expected_credentials expected_settings expected_home_state expected_projects <<<"$expected"
  if [ "$expected_credentials" -eq 0 ] && [ "$expected_settings" -eq 0 ] && [ "$expected_home_state" -eq 0 ] && [ "$expected_projects" -eq 0 ]; then
    return 0
  fi

  actual="$(claude_state_summary_from_container "$name")" || return 2
  IFS=$'\t' read -r actual_credentials actual_settings actual_home_state actual_projects <<<"$actual"

  if [ "$actual_credentials" -lt "$expected_credentials" ]; then
    warn "Claude credentials restore verification failed in $name: expected credentials file, found none"
    failed=1
  fi
  if [ "$actual_settings" -lt "$expected_settings" ]; then
    warn "Claude settings restore verification failed in $name: expected settings file, found none"
    failed=1
  fi
  if [ "$actual_home_state" -lt "$expected_home_state" ]; then
    warn "Claude home state restore verification failed in $name: expected ~/.claude.json, found none"
    failed=1
  fi
  if [ "$actual_projects" -lt "$expected_projects" ]; then
    warn "Claude project restore verification failed in $name: expected at least $expected_projects project file(s), found $actual_projects"
    failed=1
  fi
  if [ "$failed" -ne 0 ]; then
    warn "Restored Claude state verification failed for $name"
    return 1
  fi
  echo "Restored Claude state in $name: credentials files $actual_credentials/$expected_credentials, settings files $actual_settings/$expected_settings, home state files $actual_home_state/$expected_home_state, project files $actual_projects/$expected_projects" >&2
}

